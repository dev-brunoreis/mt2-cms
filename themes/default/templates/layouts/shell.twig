<!DOCTYPE html>
<html lang="{{ html_lang|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/item-tooltip.css">
    <link rel="stylesheet" href="/css/locale-switcher.css">
    <link rel="stylesheet" href="{{ theme_asset('css/tokens.css') }}">
    <link rel="stylesheet" href="{{ theme_asset('css/theme.css') }}">
    <script src="/js/site/locale-switcher.js" defer></script>
    <script src="/js/site/nav-menu.js" defer></script>
    <script src="/js/site/shop-category-tree.js" defer></script>
    <script src="/js/site/shop-search.js" defer></script>
    <script src="/js/site/banner-carousel.js" defer></script>
    <script src="/js/site/confirm-forms.js" defer></script>
    {% set brand = site_title is defined and site_title != '' ? site_title : t('app.name') %}
    <title>{{ title|default(brand) }} — {{ brand }}</title>
</head>
<body class="theme-kingdoms min-h-screen antialiased flex flex-col">
    <div class="k-chrome">
        <div class="k-realm-stripe" aria-hidden="true"></div>
        {{ slots.header|raw }}
    </div>
    {{ slots.banner|raw }}

    <div class="k-layout flex-1">
        <aside class="k-col">
            {{ slots.sidebar|raw }}
            {{ slots.left|raw }}
        </aside>

        <main class="k-main-surface min-w-0">
            {% if flash %}
                <div class="{% if flash.type == 'success' %}k-flash-ok{% else %}k-flash-err{% endif %}">
                    {{ flash.message }}
                </div>
            {% endif %}

            {{ slots.main|raw }}
        </main>

        <aside class="k-col">
            {{ slots.right|raw }}
        </aside>
    </div>

    {{ slots.footer|raw }}
</body>
</html>
