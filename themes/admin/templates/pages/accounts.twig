<div class="admin-panel overflow-hidden">
    <div class="flex flex-col gap-3 border-b border-slate-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between md:px-6">
        <p class="text-sm text-slate-500">
            {{ t('admin.accounts.count', {count: total}) }}
            {% if query %} {{ t('admin.accounts.matching', {query: query}) }}{% endif %}
        </p>

        <form method="get" action="/admin/accounts" class="flex gap-2">
            <input type="search" name="q" value="{{ query }}"
                   placeholder="{{ t('admin.accounts.search_placeholder') }}"
                   class="admin-input admin-input-compact">
            <button type="submit" class="admin-btn-secondary cursor-pointer rounded-md px-3 py-2 text-sm font-medium">
                {{ t('admin.accounts.search') }}
            </button>
        </form>
    </div>

    {% if accounts is empty %}
        <p class="px-4 py-10 text-center text-sm text-slate-500 md:px-6">
            {{ t('admin.accounts.empty') }}
        </p>
    {% else %}
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>{{ t('admin.accounts.id') }}</th>
                        <th>{{ t('admin.accounts.login') }}</th>
                        <th>{{ t('admin.accounts.email') }}</th>
                        <th>{{ t('admin.accounts.status') }}</th>
                        <th>{{ t('admin.accounts.empire') }}</th>
                        <th>{{ t('admin.accounts.cash') }}</th>
                        <th>{{ t('admin.accounts.mileage') }}</th>
                        <th>{{ t('admin.accounts.last_play') }}</th>
                        <th>{{ t('admin.accounts.last_ip') }}</th>
                        <th>{{ t('admin.accounts.actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for account in accounts %}
                        <tr>
                            <td class="text-slate-400">{{ account.id }}</td>
                            <td>
                                <a href="/admin/accounts/{{ account.id }}" class="font-medium text-indigo-600 hover:underline">
                                    {{ account.login }}
                                </a>
                            </td>
                            <td class="text-slate-600">{{ account.email|default('—') }}</td>
                            <td>
                                <span class="admin-badge {% if account.status == 'BLOCK' %}admin-badge-danger{% else %}admin-badge-ok{% endif %}">
                                    {{ account.status == 'BLOCK' ? t('admin.accounts.status_block') : t('admin.accounts.status_ok') }}
                                </span>
                            </td>
                            <td class="text-slate-600">{{ account.empire|empire_name }}</td>
                            <td class="text-slate-600">{{ account.cash }}</td>
                            <td class="text-slate-600">{{ account.mileage }}</td>
                            <td class="text-slate-600">{{ account.last_play|game_date }}</td>
                            <td class="text-slate-600">{{ account.ip|default('—') }}</td>
                            <td>
                                <div class="admin-row-actions">
                                    <a href="/admin/accounts/{{ account.id }}" class="admin-link-action">
                                        {{ t('admin.accounts.edit') }}
                                    </a>
                                    {% if account.status == 'BLOCK' %}
                                        <form method="post" action="/admin/accounts/{{ account.id }}/unblock">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <button type="submit" class="admin-link-action cursor-pointer">
                                                {{ t('admin.accounts.unblock') }}
                                            </button>
                                        </form>
                                    {% else %}
                                        <form method="post" action="/admin/accounts/{{ account.id }}/block">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <button type="submit" class="admin-link-action cursor-pointer">
                                                {{ t('admin.accounts.block') }}
                                            </button>
                                        </form>
                                    {% endif %}
                                    <form method="post" action="/admin/accounts/{{ account.id }}/delete"
                                          data-confirm="{{ t('admin.accounts.confirm_delete') }}">
                                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                                        <button type="submit" class="admin-link-action admin-link-danger cursor-pointer">
                                            {{ t('admin.accounts.delete') }}
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 border-t border-slate-100 px-4 py-3 text-sm">
            {% if page > 1 %}
                <a href="/admin/accounts?page={{ page - 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}"
                   class="admin-btn-secondary rounded-md px-3 py-1.5">
                    {{ t('admin.accounts.previous') }}
                </a>
            {% endif %}

            <span class="px-2 text-slate-500">
                {{ t('admin.accounts.page_of', {page: page, total: totalPages}) }}
            </span>

            {% if page < totalPages %}
                <a href="/admin/accounts?page={{ page + 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}"
                   class="admin-btn-secondary rounded-md px-3 py-1.5">
                    {{ t('admin.accounts.next') }}
                </a>
            {% endif %}
        </nav>
    {% endif %}
</div>
