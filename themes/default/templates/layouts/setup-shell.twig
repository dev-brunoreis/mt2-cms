<!DOCTYPE html>
<html lang="{{ html_lang|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/setup.css">
    <title>{{ title|default(t('setup.title')) }} — {{ t('app.name') }}</title>
</head>
<body class="setup-body">
    <main class="setup-main">
        {% if flash %}
            <div class="setup-flash {% if flash.type == 'success' %}is-success{% else %}is-error{% endif %}">
                {{ flash.message }}
            </div>
        {% endif %}

        {{ slots.main|raw }}
    </main>
    <script src="/js/setup.js" defer></script>
</body>
</html>
