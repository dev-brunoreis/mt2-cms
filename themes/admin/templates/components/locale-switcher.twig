{% if locales|length == 1 %}
    {% for item in locales %}
        <span class="locale-switcher locale-switcher-static admin-locale-switcher admin-locale-switcher--{{ variant|default('dark') }}" title="{{ item.name }}">
            {% if item.flag %}
                <img src="{{ item.flag }}" alt="" width="33" height="20" class="locale-switcher-flag">
            {% else %}
                <span class="locale-switcher-code">{{ item.code }}</span>
            {% endif %}
            <span class="locale-switcher-name">{{ item.name }}</span>
        </span>
    {% endfor %}
{% elseif locales|length > 1 %}
    <form method="post" action="/admin/locale"
          class="locale-switcher admin-locale-switcher admin-locale-switcher--{{ variant|default('dark') }}{% if drop|default('down') == 'up' %} locale-switcher--up{% endif %}"
          data-locale-switcher>
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="redirect" value="{{ current_path }}">

        <button type="button"
                class="locale-switcher-toggle"
                data-locale-toggle
                aria-expanded="false"
                aria-haspopup="true"
                title="{{ t('locale.label') }}">
            {% for item in locales %}
                {% if item.code == locale %}
                    {% if item.flag %}
                        <img src="{{ item.flag }}" alt="" width="33" height="20" class="locale-switcher-flag">
                    {% else %}
                        <span class="locale-switcher-code">{{ item.code }}</span>
                    {% endif %}
                    <span class="locale-switcher-name">{{ item.name }}</span>
                {% endif %}
            {% endfor %}
            <svg class="locale-switcher-caret" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
            <span class="sr-only">{{ t('locale.label') }}</span>
        </button>

        <div class="locale-switcher-menu" data-locale-menu>
            {% for item in locales %}
                <button type="submit"
                        name="locale"
                        value="{{ item.code }}"
                        class="locale-switcher-option{% if item.code == locale %} is-current{% endif %}"
                        title="{{ item.name }}"
                        {% if item.code == locale %}aria-current="true"{% endif %}>
                    {% if item.flag %}
                        <img src="{{ item.flag }}" alt="" width="33" height="20" class="locale-switcher-flag">
                    {% else %}
                        <span class="locale-switcher-code">{{ item.code }}</span>
                    {% endif %}
                    <span class="locale-switcher-name">{{ item.name }}</span>
                </button>
            {% endfor %}
        </div>
    </form>
{% endif %}
