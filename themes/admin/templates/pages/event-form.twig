{% if error %}
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ error }}</div>
{% endif %}

<form id="admin-event-form"
      method="post"
      action="{% if isEdit %}/admin/content/events/{{ event.id }}{% else %}/admin/content/events{% endif %}"
      enctype="multipart/form-data"
      class="admin-panel p-6 space-y-6">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.events.details') }}
            <span class="admin-fieldset-help">{{ t('admin.events.details_help') }}</span>
        </legend>

        <div class="grid gap-4 sm:grid-cols-2">
            <div class="admin-field sm:col-span-2">
                <label for="event-title">{{ t('admin.events.title_col') }}</label>
                <input id="event-title" type="text" name="title" required maxlength="200"
                       value="{{ event.title|default('') }}" class="admin-input">
            </div>

            <div class="admin-field">
                <label for="event-starts-at">{{ t('admin.events.starts_at') }}</label>
                <input id="event-starts-at" type="datetime-local" name="starts_at" required
                       value="{{ event.starts_at|default('') }}" class="admin-input">
            </div>

            <div class="admin-field">
                <label for="event-ends-at">{{ t('admin.events.ends_at') }}</label>
                <input id="event-ends-at" type="datetime-local" name="ends_at"
                       value="{{ event.ends_at|default('') }}" class="admin-input">
                <span class="admin-field-help">{{ t('admin.events.ends_at_help') }}</span>
            </div>

            <div class="admin-field sm:col-span-2">
                <label class="flex items-start gap-3">
                    <input type="checkbox" name="published" value="1"
                           {% if event.published|default(false) %}checked{% endif %}
                           class="mt-1">
                    <span>
                        <span class="block text-sm font-semibold text-slate-900">{{ t('admin.events.published_col') }}</span>
                        <span class="mt-1 block text-sm text-slate-500">{{ t('admin.events.published_help') }}</span>
                    </span>
                </label>
            </div>
        </div>
    </fieldset>

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.events.seo') }}
            <span class="admin-fieldset-help">{{ t('admin.events.seo_help') }}</span>
        </legend>

        <div class="grid gap-4 sm:grid-cols-2">
            <div class="admin-field sm:col-span-2">
                <label for="event-seo-title">{{ t('admin.events.seo_title') }}</label>
                <input id="event-seo-title" type="text" name="seo_title" maxlength="70"
                       value="{{ event.seo_title|default('') }}" class="admin-input">
                <span class="admin-field-help">{{ t('admin.events.seo_title_help') }}</span>
            </div>
            <div class="admin-field sm:col-span-2">
                <label for="event-seo-description">{{ t('admin.events.seo_description') }}</label>
                <textarea id="event-seo-description" name="seo_description" rows="3" maxlength="320"
                          class="admin-input">{{ event.seo_description|default('') }}</textarea>
                <span class="admin-field-help">{{ t('admin.events.seo_description_help') }}</span>
            </div>
            <div class="admin-field sm:col-span-2">
                <label for="event-seo-og-image">{{ t('admin.events.seo_og_image') }}</label>
                <input id="event-seo-og-image" type="file" name="seo_og_image" accept="image/jpeg,image/png,image/webp"
                       class="admin-input">
                <span class="admin-field-help">{{ t('admin.events.seo_og_image_help') }}</span>
                {% if event.seo_og_image|default('') %}
                    <div class="mt-3 flex flex-wrap items-center gap-4">
                        <img src="{{ event.seo_og_image }}" alt=""
                             class="h-20 w-auto max-w-[16rem] rounded border border-slate-200 object-cover bg-slate-50">
                        <label class="admin-toggle-row cursor-pointer">
                            <input type="checkbox" name="remove_seo_og_image" value="1">
                            <span class="text-sm font-medium text-slate-700">{{ t('admin.events.seo_og_remove') }}</span>
                        </label>
                    </div>
                {% endif %}
            </div>
        </div>
    </fieldset>

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.events.body') }}
            <span class="admin-fieldset-help">{{ t('admin.events.body_help') }}</span>
        </legend>
        <textarea id="event-body" name="body" rows="16" class="admin-input">{{ event.body|default('') }}</textarea>
    </fieldset>

    <div class="flex justify-end">
        <button type="submit" class="admin-btn-primary cursor-pointer rounded-md px-5 py-2 text-sm font-semibold text-white">
            {{ t('admin.save') }}
        </button>
    </div>
</form>

<script src="/vendor/tinymce/tinymce.min.js"></script>
<script src="/js/admin/admin-events-editor.js" defer></script>
