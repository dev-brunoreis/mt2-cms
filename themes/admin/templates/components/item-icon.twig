{% set src = item_icon(vnum) %}
{% set kind = size|default('') %}
{% set size_class = kind == 'lg' ? ' admin-game-icon-lg' : (kind == 'sm' ? ' admin-game-icon-sm' : (kind == 'slot' ? ' admin-game-icon-slot' : '')) %}
{% if src %}
    <img src="{{ src }}" alt="" width="{{ kind == 'sm' ? 24 : (kind == 'slot' ? 32 : (kind == 'lg' ? 72 : 48)) }}" height="{{ kind == 'sm' ? 24 : (kind == 'slot' ? 32 : (kind == 'lg' ? 72 : 48)) }}"
         class="admin-game-icon{{ size_class }}"
         loading="lazy">
{% elseif placeholder|default(false) %}
    <span class="admin-game-icon{{ size_class }} admin-game-icon-empty" aria-hidden="true"></span>
{% endif %}
