{# Day series: labels + values (JSON on the canvas; Chart.js in admin-charts.js). #}
{% set labels = labels|default([]) %}
{% set values = values|default([]) %}
{% set color = color|default('indigo') %}
{% set format = format|default('number') %}
{% if values|length >= 2 %}
<figure class="admin-chart {{ class|default('') }}">
    <div class="admin-chart-wrap{% if compact|default(false) %} is-compact{% endif %}">
        <canvas
            data-admin-chart
            data-labels="{{ labels|json_encode|e('html_attr') }}"
            data-values="{{ values|json_encode|e('html_attr') }}"
            data-format="{{ format }}"
            data-color="{{ color }}"
            data-currency="{{ currency|default('') }}"
            {% if begin_zero|default(false) %}data-begin-zero="1"{% endif %}
            role="img"
            aria-label="{{ title|default('') }}"
        ></canvas>
    </div>
    <figcaption class="mt-1 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
        <span>{{ labels|first }}</span>
        <span>{{ labels|last }}</span>
    </figcaption>
</figure>
{% else %}
<p class="text-sm text-slate-400">{{ t('admin.chart.empty') }}</p>
{% endif %}
