<section>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-8 shadow-sm md:p-12">
        <div class="relative">
            <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-indigo-100/80 blur-2xl"></div>
            <div class="relative">
                <h1 class="mb-3 text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
                    {{ t('home.title') }}
                </h1>
                <p class="mb-6 max-w-xl text-slate-600">
                    {{ t('home.lead') }}
                </p>

                <div class="mb-8 flex flex-wrap items-center gap-4 rounded-xl border border-indigo-100 bg-indigo-50/80 px-5 py-4 text-sm">
                    <div>
                        <span class="text-indigo-700">{{ t('status.players_online') }}:</span>
                        <span class="ml-1 font-semibold text-indigo-900">{{ playersOnline }}</span>
                    </div>
                    <div>
                        <span class="text-indigo-700">{{ t('status.accounts_online') }}:</span>
                        <span class="ml-1 font-semibold text-indigo-900">{{ accountsOnline }}</span>
                    </div>
                    <span class="text-indigo-600/70">{{ t('status.window_hint', {minutes: windowMinutes}) }}</span>
                    <a href="/status" class="font-medium text-indigo-600 hover:underline">{{ t('home.view_status') }}</a>
                </div>

                <div class="flex flex-wrap gap-3">
                    <a href="/ranking"
                       class="rounded-lg bg-indigo-600 px-5 py-2.5 font-semibold text-white shadow-sm hover:bg-indigo-500 transition">
                        {{ t('home.view_ranking') }}
                    </a>
                    {% if posts is not empty %}
                        <a href="/news"
                           class="rounded-lg border border-slate-300 bg-white px-5 py-2.5 font-semibold text-slate-700 hover:border-slate-400 hover:bg-slate-50 transition">
                            {{ t('home.view_news') }}
                        </a>
                    {% endif %}
                    {% if not auth.check %}
                        <a href="/register"
                           class="rounded-lg border border-slate-300 bg-white px-5 py-2.5 font-semibold text-slate-700 hover:border-slate-400 hover:bg-slate-50 transition">
                            {{ t('home.create_account') }}
                        </a>
                    {% else %}
                        <a href="/account"
                           class="rounded-lg border border-slate-300 bg-white px-5 py-2.5 font-semibold text-slate-700 hover:border-slate-400 hover:bg-slate-50 transition">
                            {{ t('nav.account') }}
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% if posts is not empty %}
        <div class="mt-10">
            <div class="mb-4 flex items-end justify-between gap-4">
                <div>
                    <h2 class="text-xl font-semibold text-slate-900">{{ t('home.news_title') }}</h2>
                    <p class="mt-1 text-sm text-slate-500">{{ t('home.news_lead') }}</p>
                </div>
                <a href="/news" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">{{ t('home.news_all') }}</a>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
                {% for post in posts %}
                    <a href="/news/{{ post.id }}"
                       class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:border-indigo-200 hover:shadow-md">
                        {% if post.cover_image %}
                            <div class="aspect-[16/7] overflow-hidden bg-slate-100">
                                <img src="{{ post.cover_image }}" alt=""
                                     class="h-full w-full object-cover transition group-hover:scale-[1.02]">
                            </div>
                        {% endif %}
                        <div class="p-5">
                            <h3 class="text-lg font-semibold text-slate-900 group-hover:text-indigo-600">
                                {{ post.title }}
                            </h3>
                            <p class="mt-2 line-clamp-3 text-sm text-slate-600">
                                {{ post.body|news_excerpt(140) }}
                            </p>
                            <p class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500">
                                <span>{{ post.author_login }}</span>
                                <span>{{ (post.published_at|default(post.created_at))|game_date }}</span>
                                <span>{{ t('news.views', {count: post.views}) }}</span>
                            </p>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</section>
