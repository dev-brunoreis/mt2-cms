<section class="space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">{{ t('account.notifications_title') }}</h1>
            <p class="mt-1 text-slate-500">{{ t('account.notifications_lead') }}</p>
        </div>
        {% if unreadCount|default(0) > 0 %}
            <form method="post" action="/account/notifications/read-all">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <button type="submit"
                        class="cursor-pointer rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50">
                    {{ t('account.notifications_mark_all') }}
                </button>
            </form>
        {% endif %}
    </div>

    {% if notifications is empty %}
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
            {{ t('account.notifications_empty') }}
        </p>
    {% else %}
        <ul class="space-y-3">
            {% for item in notifications %}
                <li class="rounded-xl border bg-white p-4 shadow-sm
                    {% if item.unread %}border-indigo-200{% else %}border-slate-200{% endif %}">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <p class="text-sm font-semibold
                                {% if item.type in ['payment_failed', 'payment_expired', 'payment_cancelled', 'account_banned'] %}text-red-800
                                {% elseif item.type == 'payment_credited' or item.type == 'item_sent' %}text-emerald-800
                                {% else %}text-slate-900{% endif %}">
                                {{ item.title }}
                            </p>
                            <p class="mt-1 text-sm text-slate-600">{{ item.body }}</p>
                            <p class="mt-2 text-xs text-slate-400">{{ item.created_at|game_date }}</p>
                        </div>
                        {% if item.unread %}
                            <form method="post" action="/account/notifications/{{ item.id }}/read">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <button type="submit"
                                        class="cursor-pointer rounded-lg px-3 py-1.5 text-xs font-semibold text-indigo-700 hover:bg-indigo-50">
                                    {{ t('account.notifications_mark_read') }}
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
