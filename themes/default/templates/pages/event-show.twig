<section class="space-y-8">
    {% if notFound|default(false) or event is null %}
        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
            <h1 class="text-xl font-semibold text-slate-900">{{ t('events.not_found') }}</h1>
            <a href="/events" class="mt-4 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500">
                {{ t('events.back') }}
            </a>
        </div>
    {% else %}
        <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="p-6 md:p-8">
                <a href="/events" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">{{ t('events.back') }}</a>
                <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">{{ event.title }}</h1>
                <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm text-slate-500">
                    <span>{{ t('events.starts', {date: event.starts_at|game_date}) }}</span>
                    {% if event.ends_at %}
                        <span>{{ t('events.ends', {date: event.ends_at|game_date}) }}</span>
                    {% endif %}
                </p>
                <div class="news-body mt-8 max-w-none space-y-4 text-slate-700 [&_a]:text-indigo-600 [&_a]:underline [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-slate-900 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-slate-900 [&_h4]:text-lg [&_h4]:font-semibold [&_li]:ml-5 [&_ol]:list-decimal [&_ul]:list-disc">
                    {{ event.body|news_html }}
                </div>
            </div>
        </article>
    {% endif %}
</section>
