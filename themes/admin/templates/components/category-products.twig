<div class="space-y-6 p-6"
     data-category-products
     data-search-url="{{ itemSearchUrl }}"
     data-csrf="{{ csrf }}"
     data-label-prev="{{ t('admin.item_shop.categories.prev_page') }}"
     data-label-next="{{ t('admin.item_shop.categories.next_page') }}"
     data-label-already="{{ t('admin.item_shop.categories.already_in_category') }}">
    <div>
        <h2 class="admin-fieldset-title">{{ t('admin.item_shop.categories.products_in_category') }}</h2>
        {% if categoryProducts is empty %}
            <p class="mt-2 text-sm text-slate-500">{{ t('admin.item_shop.categories.products_empty') }}</p>
        {% else %}
            <div class="mt-3 overflow-x-auto">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>{{ t('admin.item_shop.products.vnum') }}</th>
                            <th>{{ t('admin.item_shop.products.item') }}</th>
                            <th>{{ t('admin.item_shop.products.count_label') }}</th>
                            <th>{{ t('admin.item_shop.products.price') }}</th>
                            <th>{{ t('admin.item_shop.products.actions') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in categoryProducts %}
                            <tr>
                                <td class="text-slate-500">{{ product.vnum }}</td>
                                <td>
                                    <div class="admin-game-icon-row">
                                        {% include 'components/item-icon.twig' with { vnum: product.vnum, size: 'lg' } %}
                                        <span class="font-medium text-slate-800">{{ product.item_name|default(product.vnum) }}</span>
                                    </div>
                                </td>
                                <td colspan="2">
                                    <form method="post"
                                          action="/admin/item-shop/categories/{{ category.id }}/products/{{ product.id }}"
                                          class="flex flex-wrap items-end gap-2">
                                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                                        <div class="admin-field mb-0">
                                            <label class="sr-only" for="qty-{{ product.id }}">{{ t('admin.item_shop.products.count_label') }}</label>
                                            <input id="qty-{{ product.id }}" type="number" name="count" min="1" max="200"
                                                   value="{{ product.count }}" class="admin-input admin-input-compact w-20">
                                        </div>
                                        <div class="admin-field mb-0">
                                            <label class="sr-only" for="price-{{ product.id }}">{{ t('admin.item_shop.products.price') }}</label>
                                            <input id="price-{{ product.id }}" type="number" name="price" min="1"
                                                   value="{{ product.price }}" class="admin-input admin-input-compact w-28">
                                        </div>
                                        <button type="submit" class="admin-btn-secondary cursor-pointer rounded-md px-3 py-2 text-xs font-medium">
                                            {{ t('admin.save') }}
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <form method="post"
                                          action="/admin/item-shop/categories/{{ category.id }}/products/{{ product.id }}/delete"
                                          data-confirm="{{ t('admin.item_shop.products.confirm_delete') }}">
                                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                                        <button type="submit" class="admin-link-action admin-link-danger cursor-pointer">
                                            {{ t('admin.item_shop.products.delete') }}
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <div class="border-t border-slate-100 pt-6">
        <h2 class="admin-fieldset-title">{{ t('admin.item_shop.categories.add_products_title') }}</h2>
        <p class="mt-1 text-sm text-slate-500">{{ t('admin.item_shop.categories.add_products_help') }}</p>

        <div data-picker-step="search" class="mt-4 space-y-3">
            <div class="flex flex-wrap gap-2">
                <input type="search" data-item-search
                       placeholder="{{ t('admin.item_shop.categories.item_search_placeholder') }}"
                       class="admin-input admin-input-compact min-w-[16rem] flex-1">
                <button type="button" data-item-search-btn
                        class="admin-btn-secondary cursor-pointer rounded-md px-3 py-2 text-sm font-medium">
                    {{ t('admin.item_shop.categories.item_search') }}
                </button>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2">
                <label class="inline-flex items-center gap-2 text-sm text-slate-600">
                    <input type="checkbox" data-select-all>
                    <span>{{ t('admin.item_shop.categories.select_all_visible') }}</span>
                </label>
                <button type="button" data-continue-pricing
                        class="admin-btn-primary cursor-pointer rounded-md px-4 py-2 text-sm font-semibold text-white"
                        disabled>
                    {{ t('admin.item_shop.categories.continue_pricing') }}
                </button>
            </div>

            <div data-item-results class="max-h-80 overflow-auto rounded-md border border-slate-200">
                <p class="px-4 py-6 text-center text-sm text-slate-500" data-item-empty>
                    {{ t('admin.item_shop.categories.item_search_hint') }}
                </p>
                <table class="admin-table" data-item-table hidden>
                    <thead>
                        <tr>
                            <th class="w-10"></th>
                            <th>{{ t('admin.item_shop.products.vnum') }}</th>
                            <th>{{ t('admin.item_shop.products.item') }}</th>
                        </tr>
                    </thead>
                    <tbody data-item-tbody></tbody>
                </table>
            </div>
            <div class="flex items-center justify-center gap-2 text-sm" data-item-pager hidden></div>
        </div>

        <form method="post" action="{{ addProductsUrl }}" data-picker-step="pricing" class="mt-4 space-y-4" hidden>
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <div class="flex flex-wrap items-end justify-between gap-3">
                <div>
                    <p class="text-sm font-medium text-slate-800">{{ t('admin.item_shop.categories.pricing_title') }}</p>
                    <p class="text-xs text-slate-500">{{ t('admin.item_shop.categories.pricing_help') }}</p>
                </div>
                <div class="flex flex-wrap items-end gap-2">
                    <div class="admin-field mb-0">
                        <label for="bulk-price">{{ t('admin.item_shop.categories.bulk_price') }}</label>
                        <input id="bulk-price" type="number" min="1" value="1" data-bulk-price
                               class="admin-input admin-input-compact w-28">
                    </div>
                    <button type="button" data-apply-bulk-price
                            class="admin-btn-secondary cursor-pointer rounded-md px-3 py-2 text-sm font-medium">
                        {{ t('admin.item_shop.categories.apply_bulk_price') }}
                    </button>
                    <button type="button" data-back-to-search
                            class="admin-btn-secondary cursor-pointer rounded-md px-3 py-2 text-sm font-medium">
                        {{ t('admin.item_shop.categories.back_to_search') }}
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto rounded-md border border-slate-200">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>{{ t('admin.item_shop.products.vnum') }}</th>
                            <th>{{ t('admin.item_shop.products.item') }}</th>
                            <th>{{ t('admin.item_shop.products.count_label') }}</th>
                            <th>{{ t('admin.item_shop.products.price') }}</th>
                        </tr>
                    </thead>
                    <tbody data-pricing-tbody></tbody>
                </table>
            </div>

            <div class="flex justify-end">
                <button type="submit" class="admin-btn-primary cursor-pointer rounded-md px-5 py-2 text-sm font-semibold text-white">
                    {{ t('admin.item_shop.categories.confirm_add_products') }}
                </button>
            </div>
        </form>
    </div>
</div>
