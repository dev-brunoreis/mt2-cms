; Production PHP settings for Mt2 CMS (Linux).
; Drop into /etc/php/8.3/fpm/conf.d/99-mt2-cms.ini (or equivalent).

display_errors = Off
expose_php = Off
log_errors = On

upload_max_filesize = 512M
post_max_size = 512M

; Production OPcache — disable timestamp checks after deploy; reload php-fpm on upgrade
opcache.enable = 1
opcache.enable_cli = 0
opcache.validate_timestamps = 0
opcache.revalidate_freq = 0
opcache.memory_consumption = 128
opcache.max_accelerated_files = 10000
