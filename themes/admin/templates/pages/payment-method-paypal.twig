<form id="{{ formId }}" method="post" action="/admin/settings/payment-methods" class="p-6 space-y-6">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="gateway" value="paypal">

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.payment_methods.paypal') }}
            <span class="admin-fieldset-help">{{ t('admin.payment_methods.paypal_help') }}</span>
        </legend>

        <label class="admin-toggle-row cursor-pointer">
            <input type="checkbox" name="paypal_enabled" value="1"
                   {% if paypalEnabled|default(true) %}checked{% endif %}>
            <span>
                <span class="block text-sm font-semibold text-slate-900">{{ t('admin.payment_methods.enable') }}</span>
                <span class="mt-1 block text-sm leading-relaxed text-slate-500">{{ t('admin.payment_methods.enable_help') }}</span>
            </span>
        </label>

        <div class="grid gap-4 sm:grid-cols-2 mt-4">
            <div class="admin-field">
                <label for="paypal-mode">{{ t('admin.payment_methods.paypal_mode') }}</label>
                <select id="paypal-mode" name="paypal_mode" class="admin-input">
                    <option value="sandbox" {% if paypalMode == 'sandbox' %}selected{% endif %}>{{ t('admin.payment_methods.paypal_sandbox') }}</option>
                    <option value="live" {% if paypalMode == 'live' %}selected{% endif %}>{{ t('admin.payment_methods.paypal_live') }}</option>
                </select>
            </div>
            <div class="admin-field">
                <label for="paypal-currency">{{ t('admin.payment_methods.currency') }}</label>
                <input id="paypal-currency" type="text" name="paypal_currency" maxlength="3"
                       value="{{ paypalCurrency|default('USD') }}" class="admin-input" required>
            </div>
            <div class="admin-field sm:col-span-2">
                <label for="paypal-client-id">{{ t('admin.payment_methods.paypal_client_id') }}</label>
                <input id="paypal-client-id" type="text" name="paypal_client_id"
                       value="{{ paypalClientId|default('') }}" class="admin-input">
            </div>
            <div class="admin-field sm:col-span-2">
                <label for="paypal-client-secret">{{ t('admin.payment_methods.paypal_client_secret') }}</label>
                <input id="paypal-client-secret" type="password" name="paypal_client_secret" autocomplete="off"
                       value="{{ paypalSecretSet|default(false) ? secretPlaceholder|default('') : '' }}" class="admin-input">
                {% if paypalSecretSet|default(false) %}
                    <span class="admin-field-help">{{ t('admin.payment_methods.secret_keep') }}</span>
                {% endif %}
            </div>
            <div class="admin-field sm:col-span-2">
                <label for="paypal-webhook-id">{{ t('admin.payment_methods.paypal_webhook_id') }}</label>
                <input id="paypal-webhook-id" type="text" name="paypal_webhook_id"
                       value="{{ paypalWebhookId|default('') }}" class="admin-input">
                <span class="admin-field-help">{{ t('admin.payment_methods.paypal_webhook_help', {url: '/payments/webhook/paypal'}) }}</span>
            </div>
            <div class="admin-field">
                <label for="paypal-pending">{{ t('admin.payment_methods.pending_minutes') }}</label>
                <input id="paypal-pending" type="number" name="paypal_pending_minutes" min="5" max="180"
                       value="{{ paypalPendingMinutes|default(30) }}" class="admin-input">
            </div>
        </div>
    </fieldset>
</form>
