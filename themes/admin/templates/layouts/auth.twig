<!DOCTYPE html>
<html lang="{{ html_lang|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/admin.css">
    <script src="/js/locale-switcher.js" defer></script>
    <title>{{ title|default(t('admin.login_title')) }} — {{ t('admin.title') }}</title>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-100 via-white to-indigo-50 text-slate-800 antialiased">
    <div class="absolute right-4 top-4">
        {% include 'components/locale-switcher.twig' with { variant: 'light' } %}
    </div>
    <main class="flex min-h-screen items-center justify-center px-4 py-12">
        <div class="w-full max-w-md">
            {% if flash %}
                <div class="mb-6 rounded-lg border px-4 py-3 text-sm
                    {% if flash.type == 'success' %}border-emerald-200 bg-emerald-50 text-emerald-800
                    {% else %}border-red-200 bg-red-50 text-red-800{% endif %}">
                    {{ flash.message }}
                </div>
            {% endif %}

            {{ slots.main|raw }}
        </div>
    </main>
</body>
</html>
