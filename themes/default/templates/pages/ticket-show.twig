<section class="space-y-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <a href="/account/tickets" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">{{ t('tickets.back') }}</a>
            <h1 class="mt-2 text-2xl font-bold text-slate-900">{{ ticket.subject }}</h1>
            <p class="mt-2 flex flex-wrap gap-3 text-sm text-slate-500">
                <span>#{{ ticket.id }}</span>
                <span class="rounded-full px-2 py-0.5 text-xs font-medium
                    {% if ticket.status == 'open' %}bg-emerald-100 text-emerald-800
                    {% elseif ticket.status == 'answered' %}bg-sky-100 text-sky-800
                    {% else %}bg-slate-100 text-slate-600{% endif %}">
                    {{ t('tickets.status_' ~ ticket.status) }}
                </span>
                <span>{{ ticket.updated_at|game_date }}</span>
            </p>
        </div>
        {% if ticket.status != 'closed' %}
            <form method="post" action="/account/tickets/{{ ticket.id }}/close"
                  onsubmit="return confirm('{{ t('tickets.confirm_close')|e('js') }}')">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <button type="submit"
                        class="cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                    {{ t('tickets.close') }}
                </button>
            </form>
        {% endif %}
    </div>

    <div class="space-y-4">
        {% for message in messages %}
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm
                {% if message.author_type == 'admin' %}border-indigo-100 bg-indigo-50/40{% endif %}">
                <div class="flex flex-wrap items-center gap-2 text-sm">
                    <span class="font-medium text-slate-800">{{ message.author_login }}</span>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
                        {{ t('tickets.author_' ~ message.author_type) }}
                    </span>
                    <span class="text-slate-400">{{ message.created_at|game_date }}</span>
                </div>
                <div class="ticket-body mt-2 space-y-2 text-sm text-slate-700 [&_a]:text-indigo-600 [&_a]:underline [&_h2]:text-lg [&_h2]:font-semibold [&_h3]:text-base [&_h3]:font-semibold [&_li]:ml-5 [&_ol]:list-decimal [&_ul]:list-disc">
                    {{ message.body|ticket_html }}
                </div>
                {% set files = attachmentsByMessage[message.id]|default([]) %}
                {% if files is not empty %}
                    <ul class="mt-3 space-y-1 border-t border-slate-100 pt-3">
                        <li class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ t('tickets.attachments') }}</li>
                        {% for file in files %}
                            <li>
                                <a href="{{ attachmentBase }}{{ file.id }}"
                                   class="inline-flex items-center gap-1 text-sm font-medium text-indigo-600 hover:text-indigo-500">
                                    {{ file.original_name }}
                                    <span class="font-normal text-slate-400">({{ (file.size_bytes / 1024)|number_format(0) }} KB)</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    {% if ticket.status != 'closed' %}
        <form id="ticket-reply-form" method="post" action="/account/tickets/{{ ticket.id }}/reply"
              class="space-y-3 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <label for="reply-body" class="block text-sm font-medium text-slate-700">{{ t('tickets.reply') }}</label>
            <textarea id="reply-body" name="body" rows="5" data-html-editor data-editor-height="240"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm"></textarea>
            <button type="submit"
                    class="cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
                {{ t('tickets.reply_submit') }}
            </button>
        </form>
        <script src="https://cdn.jsdelivr.net/npm/tinymce@7.6.0/tinymce.min.js" referrerpolicy="origin"></script>
        <script src="/js/html-editor.js" defer></script>
    {% else %}
        <p class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
            {{ t('tickets.closed') }}
        </p>
    {% endif %}
</section>
