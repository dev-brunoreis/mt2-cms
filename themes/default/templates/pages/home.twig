<section>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-8 shadow-sm md:p-12">
        <div class="relative">
            <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-indigo-100/80 blur-2xl"></div>
            <div class="relative">
                <h1 class="mb-3 text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
                    {{ t('home.title') }}
                </h1>
                <p class="mb-8 max-w-xl text-slate-600">
                    {{ t('home.lead') }}
                </p>
                <div class="flex flex-wrap gap-3">
                    <a href="/ranking"
                       class="rounded-lg bg-indigo-600 px-5 py-2.5 font-semibold text-white shadow-sm hover:bg-indigo-500 transition">
                        {{ t('home.view_ranking') }}
                    </a>
                    {% if not auth.check %}
                        <a href="/register"
                           class="rounded-lg border border-slate-300 bg-white px-5 py-2.5 font-semibold text-slate-700 hover:border-slate-400 hover:bg-slate-50 transition">
                            {{ t('home.create_account') }}
                        </a>
                    {% else %}
                        <a href="/account"
                           class="rounded-lg border border-slate-300 bg-white px-5 py-2.5 font-semibold text-slate-700 hover:border-slate-400 hover:bg-slate-50 transition">
                            {{ t('nav.account') }}
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
