<section class="space-y-8">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-8 md:p-12">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">
            {{ t('home.title') }}
        </h1>
        <p class="text-slate-400 max-w-xl mb-8">
            {{ t('home.lead') }}
        </p>
        <div class="flex flex-wrap gap-3">
            <a href="/ranking"
               class="rounded-lg bg-blue-600 px-5 py-2.5 font-semibold text-white hover:bg-blue-500 transition">
                {{ t('home.view_ranking') }}
            </a>
            {% if not auth.check %}
                <a href="/register"
                   class="rounded-lg border border-slate-600 px-5 py-2.5 font-semibold text-slate-200 hover:border-slate-400 transition">
                    {{ t('home.create_account') }}
                </a>
            {% else %}
                <a href="/account"
                   class="rounded-lg border border-slate-600 px-5 py-2.5 font-semibold text-slate-200 hover:border-slate-400 transition">
                    {{ t('nav.account') }}
                </a>
            {% endif %}
        </div>
    </div>
</section>
