<!DOCTYPE html>
<html lang="{{ html_lang|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="/js/locale-switcher.js" defer></script>
    <script src="/js/shop-category-tree.js" defer></script>
    <title>{{ title|default(t('app.name')) }} — {{ t('app.name') }}</title>
</head>
<body class="min-h-screen bg-slate-50 text-slate-800 antialiased flex flex-col">
    {{ slots.header|raw }}

    <div class="flex-1 w-full max-w-6xl mx-auto px-4 py-8 {% if slots.sidebar %}flex gap-8{% endif %}">
        {% if slots.sidebar %}
            <aside class="w-56 shrink-0">
                {{ slots.sidebar|raw }}
            </aside>
        {% endif %}

        <main class="flex-1 min-w-0">
            {% if flash %}
                <div class="mb-6 rounded-lg border px-4 py-3 text-sm
                    {% if flash.type == 'success' %}border-emerald-200 bg-emerald-50 text-emerald-800
                    {% else %}border-red-200 bg-red-50 text-red-800{% endif %}">
                    {{ flash.message }}
                </div>
            {% endif %}

            {{ slots.main|raw }}
        </main>
    </div>

    {{ slots.footer|raw }}
</body>
</html>
