<section class="admin-fieldset">
    <h3 class="mb-3 text-sm font-semibold text-slate-900">{{ t('admin.characters.window_' ~ window) }}</h3>
    <div class="admin-tabs-table">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>{{ t('admin.characters.items_id') }}</th>
                    <th>{{ t('admin.characters.items_vnum') }}</th>
                    <th>{{ t('admin.characters.items_name') }}</th>
                    <th>{{ t('admin.characters.items_count') }}</th>
                    <th>{{ t('admin.characters.items_pos') }}</th>
                    <th>{{ t('admin.characters.items_sockets') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for item in rows %}
                    <tr>
                        <td class="text-slate-400">
                            {% if item.id %}
                                <a href="/admin/game/owned-items/{{ item.id }}" class="text-indigo-600 hover:underline">{{ item.id }}</a>
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td class="text-slate-600">
                            {% if item.vnum %}
                                <a href="/admin/game-data/items/{{ item.vnum }}" class="text-indigo-600 hover:underline">{{ item.vnum }}</a>
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td>
                            <div class="admin-game-icon-row">
                                {% include 'components/item-icon.twig' with { vnum: item.vnum } %}
                                <span class="font-medium text-slate-800">{{ item.name|default('—') }}</span>
                            </div>
                        </td>
                        <td class="text-slate-600">{{ item.count }}</td>
                        <td class="text-slate-600">{{ item.pos }}</td>
                        <td class="text-slate-600">
                            {% include 'components/item-sockets.twig' %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
