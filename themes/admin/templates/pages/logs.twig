{% set filterQuery %}{% if query %}&q={{ query|url_encode }}{% endif %}{% if from %}&from={{ from|url_encode }}{% endif %}{% if to %}&to={{ to|url_encode }}{% endif %}{% endset %}

<div class="admin-panel overflow-hidden">
    <div class="flex flex-col gap-3 border-b border-slate-100 px-4 py-4 md:px-6">
        <p class="text-sm text-slate-500">
            {{ t('admin.logs.count', {count: total}) }}
            {% if query or from or to %} {{ t('admin.logs.matching') }}{% endif %}
        </p>

        <form method="get" action="{{ logPath }}" class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-end">
            <div class="admin-field">
                <label for="log-q">{{ t('admin.logs.search') }}</label>
                <input id="log-q" type="search" name="q" value="{{ query }}"
                       placeholder="{{ t('admin.logs.search_placeholder') }}"
                       class="admin-input admin-input-compact">
            </div>

            {% if hasDateFilter %}
                <div class="admin-field">
                    <label for="log-from">{{ t('admin.logs.from') }}</label>
                    <input id="log-from" type="date" name="from" value="{{ from }}" class="admin-input admin-input-compact">
                </div>
                <div class="admin-field">
                    <label for="log-to">{{ t('admin.logs.to') }}</label>
                    <input id="log-to" type="date" name="to" value="{{ to }}" class="admin-input admin-input-compact">
                </div>
            {% endif %}

            <button type="submit" class="admin-btn-secondary cursor-pointer rounded-md px-3 py-2 text-sm font-medium">
                {{ t('admin.logs.filter') }}
            </button>
        </form>
    </div>

    {% if missingTable %}
        <p class="px-4 py-10 text-center text-sm text-slate-500 md:px-6">
            {{ t('admin.logs.missing_table') }}
        </p>
    {% elseif rows is empty %}
        <p class="px-4 py-10 text-center text-sm text-slate-500 md:px-6">
            {{ t('admin.logs.empty') }}
        </p>
    {% else %}
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        {% for column in columns %}
                            <th>{{ column.label }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            {% for column in columns %}
                                <td class="text-slate-600">
                                    {% include 'components/log-cell.twig' %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 border-t border-slate-100 px-4 py-3 text-sm">
            {% if page > 1 %}
                <a href="{{ logPath }}?page={{ page - 1 }}{{ filterQuery }}"
                   class="admin-btn-secondary rounded-md px-3 py-1.5">
                    {{ t('admin.logs.previous') }}
                </a>
            {% endif %}

            <span class="px-2 text-slate-500">
                {{ t('admin.logs.page_of', {page: page, total: totalPages}) }}
            </span>

            {% if page < totalPages %}
                <a href="{{ logPath }}?page={{ page + 1 }}{{ filterQuery }}"
                   class="admin-btn-secondary rounded-md px-3 py-1.5">
                    {{ t('admin.logs.next') }}
                </a>
            {% endif %}
        </nav>
    {% endif %}
</div>
