<section class="space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">{{ t('tickets.title') }}</h1>
            <p class="mt-1 text-slate-500">{{ t('tickets.lead') }}</p>
        </div>
        <a href="/account/tickets/new"
           class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
            {{ t('tickets.create') }}
        </a>
    </div>

    {% if tickets is empty %}
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
            {{ t('tickets.empty') }}
        </p>
    {% else %}
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <th class="px-4 py-3 font-medium">{{ t('tickets.id') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('tickets.subject') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('tickets.status') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('tickets.updated') }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for ticket in tickets %}
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3 text-slate-400">#{{ ticket.id }}</td>
                            <td class="px-4 py-3">
                                <a href="/account/tickets/{{ ticket.id }}" class="font-medium text-indigo-600 hover:underline">
                                    {{ ticket.subject }}
                                </a>
                            </td>
                            <td class="px-4 py-3">
                                <span class="rounded-full px-2 py-0.5 text-xs font-medium
                                    {% if ticket.status == 'open' %}bg-emerald-100 text-emerald-800
                                    {% elseif ticket.status == 'answered' %}bg-sky-100 text-sky-800
                                    {% else %}bg-slate-100 text-slate-600{% endif %}">
                                    {{ t('tickets.status_' ~ ticket.status) }}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-slate-500">{{ ticket.updated_at|game_date }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 text-sm">
            {% if page > 1 %}
                <a href="/account/tickets?page={{ page - 1 }}"
                   class="rounded-lg border border-slate-300 bg-white px-3 py-1.5">{{ t('tickets.previous') }}</a>
            {% endif %}
            <span class="text-slate-500">{{ t('tickets.page_of', {page: page, total: totalPages}) }}</span>
            {% if page < totalPages %}
                <a href="/account/tickets?page={{ page + 1 }}"
                   class="rounded-lg border border-slate-300 bg-white px-3 py-1.5">{{ t('tickets.next') }}</a>
            {% endif %}
        </nav>
    {% endif %}
</section>
