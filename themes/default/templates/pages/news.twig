<section class="space-y-5">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="k-title text-2xl">{{ t('news.title') }}</h1>
            <p class="mt-1 text-sm k-muted">{{ t('news.lead') }}</p>
        </div>
        <form method="get" action="/news" class="flex gap-2">
            <input type="search" name="q" value="{{ query }}" placeholder="{{ t('news.search_placeholder') }}"
                   class="k-input text-sm">
            <button type="submit" class="k-btn">{{ t('news.search') }}</button>
        </form>
    </div>

    <div class="k-panel">
        {% if posts is empty %}
            <p class="p-8 text-center text-sm k-muted">{{ t('news.empty') }}</p>
        {% else %}
            <div class="px-4 py-1">
                {% for post in posts %}
                    <a href="/news/{{ post.id }}" class="k-news-row !no-underline hover:bg-[rgba(196,163,90,0.04)]">
                        <time class="k-news-date">{{ (post.published_at|default(post.created_at))|game_date }}</time>
                        <div>
                            <span class="k-news-title">{{ post.title }}</span>
                            <p class="mt-1 line-clamp-2 text-xs k-muted">{{ post.body|news_excerpt(160) }}</p>
                            <p class="mt-2 flex flex-wrap gap-x-3 text-[0.65rem] k-muted">
                                <span>{{ post.author_login }}</span>
                                {% if news_show_views %}
                                    <span>{{ t('news.views', {count: post.views}) }}</span>
                                {% endif %}
                            </p>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 text-sm">
            {% if page > 1 %}
                <a href="/news?page={{ page - 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}" class="k-btn k-btn-ghost">
                    {{ t('news.previous') }}
                </a>
            {% endif %}
            <span class="px-2 k-muted">{{ t('news.page_of', {page: page, total: totalPages}) }}</span>
            {% if page < totalPages %}
                <a href="/news?page={{ page + 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}" class="k-btn k-btn-ghost">
                    {{ t('news.next') }}
                </a>
            {% endif %}
        </nav>
    {% endif %}
</section>
