<div class="admin-panel overflow-hidden">
    <div class="flex flex-col gap-3 border-b border-slate-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between md:px-6">
        <p class="text-sm text-slate-500">
            {{ t('admin.guilds.count', {count: total}) }}
            {% if query %} {{ t('admin.guilds.matching', {query: query}) }}{% endif %}
        </p>

        <form method="get" action="/admin/guilds" class="flex gap-2">
            <input type="search" name="q" value="{{ query }}"
                   placeholder="{{ t('admin.guilds.search_placeholder') }}"
                   class="admin-input admin-input-compact">
            <button type="submit" class="admin-btn-secondary cursor-pointer rounded-md px-3 py-2 text-sm font-medium">
                {{ t('admin.guilds.search') }}
            </button>
        </form>
    </div>

    {% if guilds is empty %}
        <p class="px-4 py-10 text-center text-sm text-slate-500 md:px-6">
            {{ t('admin.guilds.empty') }}
        </p>
    {% else %}
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>{{ t('admin.guilds.id') }}</th>
                        <th>{{ t('admin.guilds.name') }}</th>
                        <th>{{ t('admin.guilds.master') }}</th>
                        <th>{{ t('admin.guilds.level') }}</th>
                        <th>{{ t('admin.guilds.gold') }}</th>
                        <th>{{ t('admin.guilds.ladder') }}</th>
                        <th>{{ t('admin.guilds.members') }}</th>
                        <th>{{ t('admin.guilds.record') }}</th>
                        <th>{{ t('admin.guilds.actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for guild in guilds %}
                        <tr>
                            <td class="text-slate-400">{{ guild.id }}</td>
                            <td>
                                <a href="/admin/guilds/{{ guild.id }}" class="font-medium text-indigo-600 hover:underline">
                                    {{ guild.name }}
                                </a>
                            </td>
                            <td class="text-slate-600">
                                {% if guild.master_id %}
                                    <a href="/admin/characters/{{ guild.master_id }}" class="text-indigo-600 hover:underline">
                                        {{ guild.master_name|default(guild.master_id) }}
                                    </a>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="text-slate-600">{{ guild.level }}</td>
                            <td class="text-slate-600">{{ guild.gold }}</td>
                            <td class="text-slate-600">{{ guild.ladder_point }}</td>
                            <td class="text-slate-600">{{ guild.member_count }}</td>
                            <td class="text-slate-600">{{ t('admin.guilds.record_value', {win: guild.win, draw: guild.draw, loss: guild.loss}) }}</td>
                            <td>
                                <a href="/admin/guilds/{{ guild.id }}" class="admin-link-action">
                                    {{ t('admin.guilds.view') }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 border-t border-slate-100 px-4 py-3 text-sm">
            {% if page > 1 %}
                <a href="/admin/guilds?page={{ page - 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}"
                   class="admin-btn-secondary rounded-md px-3 py-1.5">
                    {{ t('admin.guilds.previous') }}
                </a>
            {% endif %}

            <span class="px-2 text-slate-500">
                {{ t('admin.guilds.page_of', {page: page, total: totalPages}) }}
            </span>

            {% if page < totalPages %}
                <a href="/admin/guilds?page={{ page + 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}"
                   class="admin-btn-secondary rounded-md px-3 py-1.5">
                    {{ t('admin.guilds.next') }}
                </a>
            {% endif %}
        </nav>
    {% endif %}
</div>
