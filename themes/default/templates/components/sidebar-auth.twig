<div class="k-panel">
    <div class="k-panel-head">{{ t('theme.kingdoms.login_title') }}</div>
    <div class="p-3">
        {% if auth.check %}
            <p class="text-sm text-[var(--k-text)]">
                {{ t('theme.kingdoms.welcome', {login: auth.login}) }}
            </p>
            <div class="mt-3 flex flex-col gap-2">
                <a href="/account" class="k-btn w-full">{{ t('nav.account') }}</a>
                <form method="post" action="/logout">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <button type="submit" class="k-btn k-btn-ghost w-full">{{ t('nav.logout') }}</button>
                </form>
            </div>
        {% else %}
            <form method="post" action="/login" class="flex flex-col gap-2.5">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <label class="sr-only" for="k-side-user">{{ t('auth.username') }}</label>
                <input id="k-side-user" type="text" name="username" required autocomplete="username"
                       placeholder="{{ t('auth.username') }}" class="k-input w-full text-sm">
                <label class="sr-only" for="k-side-pass">{{ t('auth.password') }}</label>
                <input id="k-side-pass" type="password" name="password" required autocomplete="current-password"
                       placeholder="{{ t('auth.password') }}" class="k-input w-full text-sm">
                {% if captchaEnabled|default(false) %}
                    <label class="sr-only" for="k-side-captcha">{{ t('auth.captcha') }}</label>
                    <img src="/captcha.svg" alt="" width="160" height="48"
                         class="w-full rounded border border-[var(--k-border)]">
                    <input id="k-side-captcha" type="text" name="captcha" required autocomplete="off" maxlength="5"
                           placeholder="{{ t('auth.captcha') }}"
                           class="k-input w-full text-sm uppercase tracking-widest">
                {% endif %}
                <button type="submit" class="k-btn w-full">{{ t('auth.submit_login') }}</button>
            </form>
            <p class="mt-3 text-center text-xs k-muted">
                <a href="/register">{{ t('nav.register') }}</a>
                ·
                <a href="/forgot-password">{{ t('auth.forgot_link') }}</a>
            </p>
        {% endif %}
    </div>
</div>
