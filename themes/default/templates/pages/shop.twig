{% macro category_tree(nodes, activeCategory, expandedIds) %}
    <ul class="shop-cat-list space-y-0.5" data-shop-cat-list>
        {% for category in nodes %}
            {% set hasChildren = category.children is not empty %}
            {% set isActive = activeCategory and activeCategory.id == category.id %}
            {% set isExpanded = hasChildren and (category.id in expandedIds) %}
            <li class="shop-cat-item {% if isExpanded %}is-open{% elseif hasChildren %}is-collapsed{% endif %}"
                data-shop-cat-item
                data-id="{{ category.id }}">
                <div class="flex items-center gap-0.5 rounded-lg {% if isActive %}bg-indigo-600 text-white{% else %}text-slate-700 hover:bg-slate-100{% endif %}">
                    {% if hasChildren %}
                        <button type="button"
                                class="shop-cat-toggle flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-md {% if isActive %}text-indigo-100 hover:bg-indigo-500{% else %}text-slate-400 hover:text-slate-700{% endif %}"
                                data-shop-cat-toggle
                                aria-expanded="{{ isExpanded ? 'true' : 'false' }}"
                                aria-label="{{ t('shop.toggle_category') }}">
                            <svg class="h-3.5 w-3.5 transition-transform {% if not isExpanded %}-rotate-90{% endif %}" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                    {% else %}
                        <span class="inline-block h-8 w-8 shrink-0" aria-hidden="true"></span>
                    {% endif %}
                    <a href="/shop?category={{ category.slug|url_encode }}"
                       class="min-w-0 flex-1 truncate py-1.5 pr-2 text-sm font-medium {% if isActive %}text-white{% else %}text-inherit{% endif %}">
                        {{ category.name }}
                    </a>
                </div>
                {% if hasChildren %}
                    <div class="shop-cat-children ml-4 border-l border-slate-200 pl-1 {% if not isExpanded %}hidden{% endif %}"
                         data-shop-cat-children>
                        {{ _self.category_tree(category.children, activeCategory, expandedIds) }}
                    </div>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

<section class="space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">{{ t('shop.title') }}</h1>
            <p class="mt-1 text-slate-500">{{ t('shop.lead') }}</p>
        </div>
        {% if auth.check and cash is not null %}
            <div class="rounded-xl border border-indigo-100 bg-indigo-50 px-4 py-3 text-sm">
                <span class="text-indigo-700">{{ t('shop.your_cash') }}</span>
                <span class="ml-2 font-semibold text-indigo-900">{{ cash }}</span>
            </div>
        {% endif %}
    </div>

    {% if notFound %}
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
            {{ t('shop.category_not_found') }}
        </p>
        <p class="text-center">
            <a href="/shop" class="font-medium text-indigo-600 hover:underline">{{ t('shop.back') }}</a>
        </p>
    {% else %}
        <div class="flex flex-col gap-6 lg:flex-row lg:items-start">
            {% if categories is not empty %}
                <nav class="w-full shrink-0 rounded-xl border border-slate-200 bg-white p-3 shadow-sm lg:w-64"
                     data-shop-category-tree
                     aria-label="{{ t('shop.categories') }}">
                    <a href="/shop"
                       class="mb-1 flex items-center rounded-lg px-2 py-2 text-sm font-medium {% if not activeCategory %}bg-indigo-600 text-white{% else %}text-slate-700 hover:bg-slate-100{% endif %}">
                        <span class="inline-block w-8 shrink-0" aria-hidden="true"></span>
                        {{ t('shop.all_categories') }}
                    </a>
                    {% import _self as shop_nav %}
                    {{ shop_nav.category_tree(categories, activeCategory, expandedCategoryIds|default([])) }}
                </nav>
            {% endif %}

            <div class="min-w-0 flex-1">
                {% if products is empty %}
                    <p class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
                        {{ t('shop.empty') }}
                    </p>
                {% else %}
                    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                        {% for product in products %}
                            <article class="shop-product-card relative z-0 flex flex-col overflow-visible rounded-xl border border-slate-200 bg-white shadow-sm hover:z-20 focus-within:z-20">
                                <div class="flex items-start gap-3 overflow-visible border-b border-slate-100 p-4">
                                    {% set icon = item_icon(product.vnum) %}
                                    <div class="mt2-item-tip-host" tabindex="0">
                                        {% if icon %}
                                            <img src="{{ icon }}" alt="" class="h-12 w-12 object-contain" width="48" height="48"
                                                 style="image-rendering: pixelated">
                                        {% else %}
                                            <div class="flex h-12 w-12 items-center justify-center rounded bg-slate-100 text-xs text-slate-400">?</div>
                                        {% endif %}
                                        {% if product.tooltip is defined %}
                                            {% include 'components/item-tooltip.twig' with { tip: product.tooltip, icon_src: icon } %}
                                        {% endif %}
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <h2 class="truncate font-semibold text-slate-900">{{ product.item_name }}</h2>
                                        <p class="mt-0.5 text-xs text-slate-500">
                                            {{ product.category_name }} · x{{ product.count }}
                                        </p>
                                    </div>
                                </div>
                                <div class="flex flex-1 flex-col justify-between gap-3 p-4">
                                    <p class="text-lg font-bold text-indigo-700">
                                        {{ t('shop.price', {price: product.price}) }}
                                    </p>

                                    {% if auth.check %}
                                        <form method="post" action="/shop/buy"
                                              onsubmit="return confirm('{{ t('shop.confirm_buy', {name: product.item_name, price: product.price})|e('js') }}');">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <input type="hidden" name="product_id" value="{{ product.id }}">
                                            <input type="hidden" name="idempotency_key" value="{{ idempotencyKeys[product.id]|default('') }}">
                                            <button type="submit"
                                                    class="w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
                                                {{ t('shop.buy') }}
                                            </button>
                                        </form>
                                    {% else %}
                                        <a href="/login"
                                           class="block rounded-lg border border-slate-200 px-4 py-2 text-center text-sm font-medium text-slate-700 hover:bg-slate-50">
                                            {{ t('shop.login_to_buy') }}
                                        </a>
                                    {% endif %}
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
</section>
