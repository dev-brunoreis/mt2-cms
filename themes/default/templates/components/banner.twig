<div class="k-banner" aria-hidden="true">
    <div class="k-banner-frame">
        <picture>
            <source
                type="image/webp"
                srcset="/themes/default/banner-960.webp 960w,
                        /themes/default/banner-1440.webp 1440w,
                        /themes/default/banner-1920.webp 1920w"
                sizes="(max-width: 1180px) calc(100vw - 2rem), 1180px">
            <source
                type="image/jpeg"
                srcset="/themes/default/banner-960.jpg 960w,
                        /themes/default/banner-1440.jpg 1440w,
                        /themes/default/banner-1920.jpg 1920w"
                sizes="(max-width: 1180px) calc(100vw - 2rem), 1180px">
            <img
                class="k-banner-img"
                src="/themes/default/banner.jpg"
                width="1920"
                height="1080"
                alt=""
                decoding="async"
                fetchpriority="high">
        </picture>
    </div>
</div>
