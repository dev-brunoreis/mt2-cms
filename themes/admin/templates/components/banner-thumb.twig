{% if row.preview_url|default('') %}
    {% include 'components/image-preview-trigger.twig' with {
        src: row.full_url|default(row.preview_url),
        thumb: row.preview_url,
        alt: row.alt|default(row.title)|default(''),
        imgClass: 'h-10 w-24 rounded border border-slate-200 object-cover',
        width: 96,
        height: 40
    } %}
{% else %}
    <span class="text-slate-400">—</span>
{% endif %}
