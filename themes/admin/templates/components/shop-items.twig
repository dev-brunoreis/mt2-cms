<section class="admin-fieldset">
    <h2 class="admin-fieldset-title">{{ t('admin.shops.tab_items') }}</h2>

    <form method="post" action="/admin/game-data/shops/{{ shop.vnum }}/items" class="mb-6 flex flex-wrap gap-2">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="number" name="item_vnum" min="1" placeholder="{{ t('admin.shops.item_vnum') }}"
               class="admin-input admin-input-compact" required>
        <input type="number" name="count" min="1" value="1" placeholder="{{ t('admin.shops.item_count') }}"
               class="admin-input admin-input-compact" required>
        <button type="submit" class="admin-btn-secondary cursor-pointer rounded-md px-3 py-2 text-sm font-medium">
            {{ t('admin.shops.add_item') }}
        </button>
    </form>

    {% include 'components/grid.twig' with { grid: itemsGrid } %}
</section>
