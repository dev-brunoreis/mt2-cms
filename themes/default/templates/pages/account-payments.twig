<section class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">{{ t('account.payments_title') }}</h1>
        <p class="mt-1 text-slate-500">{{ t('account.payments_lead') }}</p>
    </div>

    {% if payments is empty %}
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
            {{ t('account.payments_empty') }}
        </p>
    {% else %}
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <th class="px-4 py-3 font-medium">{{ t('account.payments_id') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('account.payments_cash') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('account.payments_amount') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('account.payments_status') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('account.payments_credited') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('account.payments_date') }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for payment in payments %}
                        <tr class="hover:bg-slate-50 transition">
                            <td class="px-4 py-3 text-slate-400">#{{ payment.id }}</td>
                            <td class="px-4 py-3 font-medium text-slate-900">{{ payment.cash_amount }}</td>
                            <td class="px-4 py-3 text-slate-600">
                                {{ t('donate.price', {
                                    price: payment.amount_cents|money,
                                    currency: payment.currency
                                }) }}
                            </td>
                            <td class="px-4 py-3">
                                <span class="rounded-full px-2 py-0.5 text-xs font-medium
                                    {% if payment.status == 'paid' %}bg-emerald-100 text-emerald-800
                                    {% elseif payment.status == 'pending' %}bg-amber-100 text-amber-800
                                    {% else %}bg-red-100 text-red-800{% endif %}">
                                    {{ t('account.payments_status_' ~ payment.status) }}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-slate-600">
                                {% if payment.credited_at %}
                                    {{ payment.credited_at|game_date }}
                                {% else %}
                                    {{ t('account.payments_not_credited') }}
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 text-slate-600">{{ payment.created_at|game_date }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
