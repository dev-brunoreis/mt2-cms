<form id="{{ formId }}" method="post" action="/admin/settings/community" class="p-6 space-y-6">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.community.site_settings') }}
            <span class="admin-fieldset-help">{{ t('admin.community.site_settings_help') }}</span>
        </legend>

        <div class="grid gap-4 sm:grid-cols-2">
            <div class="admin-field sm:col-span-2">
                <label for="site-url">{{ t('admin.community.site_url') }}</label>
                <input id="site-url" type="url" name="site_url" value="{{ siteUrl|default('') }}" class="admin-input" placeholder="https://">
            </div>
            <div class="admin-field">
                <label for="mail-from-address">{{ t('admin.community.mail_from_address') }}</label>
                <input id="mail-from-address" type="email" name="mail_from_address"
                       value="{{ mailFromAddress|default('') }}" class="admin-input">
            </div>
            <div class="admin-field">
                <label for="mail-from-name">{{ t('admin.community.mail_from_name') }}</label>
                <input id="mail-from-name" type="text" name="mail_from_name"
                       value="{{ mailFromName|default('') }}" class="admin-input">
            </div>
            <div class="admin-field">
                <label for="online-window">{{ t('admin.community.online_window') }}</label>
                <input id="online-window" type="number" name="online_window_minutes" min="1" max="1440"
                       value="{{ onlineWindowMinutes|default(15) }}" class="admin-input">
                <span class="admin-field-help">{{ t('admin.community.online_window_help') }}</span>
            </div>
            <div class="admin-field sm:col-span-2">
                <label class="admin-toggle-row cursor-pointer">
                    <input type="checkbox" name="require_verified_email" value="1"
                           {% if requireVerifiedEmail|default(false) %}checked{% endif %}>
                    <span>
                        <span class="block text-sm font-semibold text-slate-900">{{ t('admin.community.require_verified_email') }}</span>
                        <span class="mt-1 block text-sm leading-relaxed text-slate-500">{{ t('admin.community.require_verified_email_help') }}</span>
                    </span>
                </label>
            </div>
        </div>
    </fieldset>

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.community.paypal') }}
            <span class="admin-fieldset-help">{{ t('admin.community.paypal_help') }}</span>
        </legend>

        <div class="grid gap-4 sm:grid-cols-2">
            <div class="admin-field">
                <label for="paypal-mode">{{ t('admin.community.paypal_mode') }}</label>
                <select id="paypal-mode" name="paypal_mode" class="admin-input">
                    <option value="sandbox" {% if paypalMode|default('sandbox') == 'sandbox' %}selected{% endif %}>{{ t('admin.community.paypal_sandbox') }}</option>
                    <option value="live" {% if paypalMode|default('') == 'live' %}selected{% endif %}>{{ t('admin.community.paypal_live') }}</option>
                </select>
            </div>
            <div class="admin-field">
                <label for="paypal-currency">{{ t('admin.community.paypal_currency') }}</label>
                <input id="paypal-currency" type="text" name="paypal_currency" maxlength="3"
                       value="{{ paypalCurrency|default('USD') }}" class="admin-input uppercase">
            </div>
            <div class="admin-field">
                <label for="paypal-client-id">{{ t('admin.community.paypal_client_id') }}</label>
                <input id="paypal-client-id" type="text" name="paypal_client_id" autocomplete="off"
                       value="{{ paypalClientId|default('') }}" class="admin-input">
            </div>
            <div class="admin-field">
                <label for="paypal-client-secret">{{ t('admin.community.paypal_client_secret') }}</label>
                <input id="paypal-client-secret" type="password" name="paypal_client_secret" autocomplete="new-password"
                       value="" class="admin-input">
                {% if paypalConfigured|default(false) %}
                    <span class="admin-field-help">{{ t('admin.community.paypal_secret_keep') }}</span>
                {% else %}
                    <span class="admin-field-help">{{ t('admin.community.paypal_not_configured') }}</span>
                {% endif %}
            </div>
            <div class="admin-field sm:col-span-2">
                <label for="paypal-webhook-id">{{ t('admin.community.paypal_webhook_id') }}</label>
                <input id="paypal-webhook-id" type="text" name="paypal_webhook_id" autocomplete="off"
                       value="{{ paypalWebhookId|default('') }}" class="admin-input">
                <span class="admin-field-help">{{ t('admin.community.paypal_webhook_id_help') }}</span>
            </div>
        </div>
    </fieldset>

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.community.discord') }}
            <span class="admin-fieldset-help">{{ t('admin.community.discord_help') }}</span>
        </legend>

        <div class="grid gap-4 sm:grid-cols-2">
            <div class="admin-field sm:col-span-2">
                <label for="discord-invite-url">{{ t('admin.community.discord_invite_url') }}</label>
                <input id="discord-invite-url" type="url" name="discord_invite_url"
                       value="{{ discordInviteUrl|default('') }}" class="admin-input" placeholder="https://discord.gg/">
                <span class="admin-field-help">{{ t('admin.community.discord_invite_url_help') }}</span>
            </div>
            <div class="admin-field sm:col-span-2">
                <label for="discord-webhook-url">{{ t('admin.community.discord_webhook_url') }}</label>
                <input id="discord-webhook-url" type="password" name="discord_webhook_url" autocomplete="new-password"
                       value="" class="admin-input">
                {% if discordWebhookConfigured|default(false) %}
                    <span class="admin-field-help">{{ t('admin.community.discord_webhook_keep') }}</span>
                {% else %}
                    <span class="admin-field-help">{{ t('admin.community.discord_webhook_help') }}</span>
                {% endif %}
            </div>
        </div>
    </fieldset>

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.community.channels') }}
            <span class="admin-fieldset-help">{{ t('admin.community.channels_help') }}</span>
        </legend>

        <div class="space-y-4">
            {% for channel in channels %}
                <div class="rounded-md border border-slate-200 p-4">
                    <input type="hidden" name="channel_id[]" value="{{ channel.id }}">
                    <div class="mb-3 flex justify-end">
                        <button type="submit" form="admin-channel-delete-{{ channel.id }}"
                                class="admin-link-action admin-link-danger cursor-pointer text-sm">
                            {{ t('admin.community.channel_remove') }}
                        </button>
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        <div class="admin-field">
                            <label>{{ t('admin.community.channel_name') }}</label>
                            <input type="text" name="channel_name[]" value="{{ channel.name }}" class="admin-input" maxlength="32">
                        </div>
                        <div class="admin-field">
                            <label>{{ t('admin.community.channel_label') }}</label>
                            <input type="text" name="channel_label[]" value="{{ channel.label }}" class="admin-input" maxlength="64">
                        </div>
                        <div class="admin-field">
                            <label>{{ t('admin.community.channel_host') }}</label>
                            <input type="text" name="channel_host[]" value="{{ channel.host|default('') }}" class="admin-input" maxlength="255">
                        </div>
                        <div class="admin-field">
                            <label>{{ t('admin.community.channel_port') }}</label>
                            <input type="number" name="channel_port[]" value="{{ channel.port|default('') }}" class="admin-input" min="1" max="65535">
                        </div>
                        <div class="admin-field">
                            <label>{{ t('admin.community.channel_sort') }}</label>
                            <input type="number" name="channel_sort[]" value="{{ channel.sort_order|default(0) }}" class="admin-input" min="0">
                        </div>
                        <div class="admin-field flex items-end">
                            <label class="admin-toggle-row cursor-pointer">
                                <input type="checkbox" name="channel_enabled[{{ loop.index0 }}]" value="1"
                                       {% if channel.enabled|default(false) %}checked{% endif %}>
                                <span class="text-sm font-semibold text-slate-900">{{ t('admin.community.channel_enabled') }}</span>
                            </label>
                        </div>
                    </div>
                </div>
            {% endfor %}

            <div class="rounded-md border border-dashed border-slate-300 p-4">
                <p class="mb-3 text-sm font-medium text-slate-600">{{ t('admin.community.channel_new') }}</p>
                <input type="hidden" name="channel_id[]" value="0">
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <div class="admin-field">
                        <label>{{ t('admin.community.channel_name') }}</label>
                        <input type="text" name="channel_name[]" value="" class="admin-input" maxlength="32">
                    </div>
                    <div class="admin-field">
                        <label>{{ t('admin.community.channel_label') }}</label>
                        <input type="text" name="channel_label[]" value="" class="admin-input" maxlength="64">
                    </div>
                    <div class="admin-field">
                        <label>{{ t('admin.community.channel_host') }}</label>
                        <input type="text" name="channel_host[]" value="" class="admin-input" maxlength="255">
                    </div>
                    <div class="admin-field">
                        <label>{{ t('admin.community.channel_port') }}</label>
                        <input type="number" name="channel_port[]" value="" class="admin-input" min="1" max="65535">
                    </div>
                    <div class="admin-field">
                        <label>{{ t('admin.community.channel_sort') }}</label>
                        <input type="number" name="channel_sort[]" value="0" class="admin-input" min="0">
                    </div>
                    <div class="admin-field flex items-end">
                        <label class="admin-toggle-row cursor-pointer">
                            <input type="checkbox" name="channel_enabled[{{ channels|length }}]" value="1" checked>
                            <span class="text-sm font-semibold text-slate-900">{{ t('admin.community.channel_enabled') }}</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
</form>

{% for channel in channels %}
    <form id="admin-channel-delete-{{ channel.id }}" method="post"
          action="/admin/settings/community/channels/{{ channel.id }}/delete"
          data-confirm="{{ t('admin.community.confirm_remove_channel') }}">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
    </form>
{% endfor %}
