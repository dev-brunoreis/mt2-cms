<div class="proto-field-pair sm:col-span-2">
    <div class="proto-field-pair-head">
        <span class="proto-field-pair-title">{{ row.title }}</span>
        {% if row.hint %}
            <span class="admin-field-help">{{ row.hint }}</span>
        {% endif %}
    </div>
    <div class="proto-field-pair-body">
        <div class="proto-field-pair-type">
            {% include 'components/proto-field.twig' with { field: row.type|merge({ label: row.typeLabel }) } %}
        </div>
        <span class="proto-field-pair-join" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 10h13M12.5 6.5 16.5 10l-4 3.5"/>
            </svg>
        </span>
        <div class="proto-field-pair-value">
            {% include 'components/proto-field.twig' with { field: row.value|merge({ label: row.valueLabel }) } %}
        </div>
    </div>
</div>
