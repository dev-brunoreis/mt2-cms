<form id="{{ formId }}" method="post" action="/admin/settings/themes" class="p-6">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.themes.available') }}
            <span class="admin-fieldset-help">{{ t('admin.themes.available_help') }}</span>
        </legend>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {% for themeName in diskThemes %}
                <label class="admin-theme-tile">
                    <input type="checkbox" name="themes[]" value="{{ themeName }}"
                           {% if themeName in enabledThemes %}checked{% endif %}>
                    <span class="block text-sm font-semibold text-slate-900">{{ themeName }}</span>
                    <span class="mt-0.5 block text-xs text-slate-500">{{ t('admin.themes.theme_label') }}</span>
                </label>
            {% endfor %}
        </div>
    </fieldset>

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.themes.active') }}
            <span class="admin-fieldset-help">{{ t('admin.themes.active_help') }}</span>
        </legend>

        <select id="active_theme" name="active_theme" required class="admin-select">
            {% for themeName in diskThemes %}
                <option value="{{ themeName }}" {% if activeTheme == themeName %}selected{% endif %}>{{ themeName }}</option>
            {% endfor %}
        </select>
    </fieldset>
</form>
