<div class="space-y-4">
    {% if tickStale|default(false) %}
    <div class="admin-panel rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        <p class="font-medium">{{ t('admin.economy.tick_stale') }}</p>
        <p class="mt-1">{{ t('admin.economy.tick_hint') }}</p>
        {% if lastOkAt %}
        <p class="mt-1 opacity-80">{{ t('admin.economy.last_ok', {at: lastOkAt}) }}</p>
        {% endif %}
    </div>
    {% elseif lastOkAt %}
    <p class="text-sm text-slate-500">{{ t('admin.economy.last_ok', {at: lastOkAt}) }}</p>
    {% endif %}

    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap gap-2" role="group" aria-label="{{ t('admin.economy.range_label') }}">
            {% for opt in rangeOptions %}
            <a href="/admin/game/economy?range={{ opt }}"
               class="rounded-md px-3 py-1.5 text-sm font-medium {% if range == opt %}bg-indigo-600 text-white{% else %}bg-slate-100 text-slate-700 hover:bg-slate-200{% endif %}">
                {{ t('admin.economy.range.' ~ opt) }}
            </a>
            {% endfor %}
        </div>
        <a class="text-sm font-medium text-indigo-600 hover:underline" href="{{ playersHref }}">{{ t('admin.economy.players_link') }}</a>
    </div>

    <div class="admin-panel p-4 md:p-6">
        <dl class="admin-stat-grid">
            <div class="admin-stat admin-stat-highlight">
                <dt>{{ t('admin.economy.total_yang') }}</dt>
                <dd class="break-all">{{ kpis.total_yang|number_format }}</dd>
                {% if kpis.total_yang_delta is not null %}
                <dd class="text-xs font-normal text-slate-500">{% if kpis.total_yang_delta > 0 %}+{% endif %}{{ (kpis.total_yang_delta * 100)|number_format(1) }}%</dd>
                {% endif %}
            </div>
            <div class="admin-stat">
                <dt>{{ t('admin.economy.market_volume') }}</dt>
                <dd class="break-all">{{ kpis.volume_yang|number_format }}</dd>
                {% if kpis.volume_yang_delta is not null %}
                <dd class="text-xs font-normal text-slate-500">{% if kpis.volume_yang_delta > 0 %}+{% endif %}{{ (kpis.volume_yang_delta * 100)|number_format(1) }}%</dd>
                {% endif %}
            </div>
            <div class="admin-stat">
                <dt>{{ t('admin.economy.market_trades') }}</dt>
                <dd>{{ kpis.trades|number_format }}</dd>
                {% if kpis.trades_delta is not null %}
                <dd class="text-xs font-normal text-slate-500">{% if kpis.trades_delta > 0 %}+{% endif %}{{ (kpis.trades_delta * 100)|number_format(1) }}%</dd>
                {% endif %}
            </div>
            <div class="admin-stat">
                <dt>{{ t('admin.economy.yang_net') }}</dt>
                <dd class="break-all">{{ kpis.money_net|number_format }}</dd>
                <dd class="text-xs font-normal text-slate-500">
                    +{{ kpis.money_created|number_format }} / −{{ kpis.money_destroyed|number_format }}
                </dd>
            </div>
        </dl>
        {% if yang %}
        <p class="mt-3 text-sm text-slate-500">{{ t('admin.economy.yang_help') }}</p>
        {% endif %}
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
        <div class="admin-panel p-4 md:p-6">
            <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.economy.chart_yang_supply') }}</h2>
            <p class="mt-1 text-sm text-slate-500">{{ t('admin.economy.chart_yang_supply_help', {days: chartDays}) }}</p>
            <div class="mt-3">
                {% include 'components/day-chart.twig' with {
                    labels: yangChart.labels|default([]),
                    values: yangChart.values|default([]),
                    title: t('admin.economy.chart_yang_supply'),
                    color: 'indigo',
                    begin_zero: true
                } %}
            </div>
        </div>
        <div class="admin-panel p-4 md:p-6">
            <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.economy.chart_market_volume') }}</h2>
            <p class="mt-1 text-sm text-slate-500">{{ t('admin.economy.chart_market_volume_help', {days: chartDays}) }}</p>
            <div class="mt-3">
                {% include 'components/day-chart.twig' with {
                    labels: volumeChart.labels|default([]),
                    values: volumeChart.values|default([]),
                    title: t('admin.economy.chart_market_volume'),
                    color: 'emerald',
                    begin_zero: true
                } %}
            </div>
        </div>
        <div class="admin-panel p-4 md:p-6">
            <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.economy.chart_yang_flow') }}</h2>
            <p class="mt-1 text-sm text-slate-500">{{ t('admin.economy.chart_yang_flow_help', {days: chartDays}) }}</p>
            <div class="mt-3">
                {% include 'components/day-chart.twig' with {
                    labels: netChart.labels|default([]),
                    values: netChart.values|default([]),
                    title: t('admin.economy.chart_yang_flow'),
                    color: 'amber'
                } %}
            </div>
        </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
        <div class="admin-panel p-4 md:p-6 overflow-x-auto">
            <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.economy.top_sold') }}</h2>
            {% if topSold|length == 0 %}
            <p class="mt-2 text-sm text-slate-500">{{ t('admin.economy.no_trades') }}</p>
            {% else %}
            <table class="admin-table mt-3">
                <thead>
                    <tr>
                        <th>{{ t('admin.economy.item') }}</th>
                        <th>{{ t('admin.economy.market_volume') }}</th>
                        <th>{{ t('admin.economy.trades') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in topSold %}
                    <tr>
                        <td><a class="font-medium text-indigo-600 hover:underline" href="/admin/game/economy/{{ row.vnum }}">{{ row.item_name }}</a></td>
                        <td>{{ row.volume_yang|number_format }}</td>
                        <td>{{ row.trades|number_format }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>
        <div class="admin-panel p-4 md:p-6 overflow-x-auto">
            <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.economy.top_movers') }}</h2>
            {% if movers|length == 0 %}
            <p class="mt-2 text-sm text-slate-500">{{ t('admin.economy.history_empty') }}</p>
            {% else %}
            <table class="admin-table mt-3">
                <thead>
                    <tr>
                        <th>{{ t('admin.economy.item') }}</th>
                        <th>{{ t('admin.economy.median_price') }}</th>
                        <th>{{ t('admin.economy.price_delta') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in movers %}
                    <tr>
                        <td><a class="font-medium text-indigo-600 hover:underline" href="/admin/game/economy/{{ row.vnum }}">{{ row.item_name }}</a></td>
                        <td>{{ row.median_now|number_format }}</td>
                        <td>{% if row.change_pct > 0 %}+{% endif %}{{ row.change_pct|number_format(1) }}%</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>
    </div>

    {% if alerts|default([])|length > 0 %}
    <div class="admin-panel p-4 md:p-6">
        <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.economy.alerts_title') }}</h2>
        <ul class="mt-3 space-y-2">
            {% for alert in alerts %}
            <li class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-2 last:border-0">
                <div>
                    <a class="font-medium text-indigo-600 hover:underline" href="{{ alert.href }}">{{ alert.label }}</a>
                    <span class="admin-badge admin-badge-muted">{{ t('admin.economy.alert_kind.' ~ alert.kind) }}</span>
                    <span class="text-sm text-slate-500">{{ alert.created_at }}</span>
                </div>
                <form method="post" action="/admin/game/economy/alerts/{{ alert.id }}/ack" class="inline">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="back" value="/admin/game/economy?range={{ range }}">
                    <button type="submit" class="admin-btn-secondary rounded-md px-2.5 py-1.5 text-xs font-medium">{{ t('admin.economy.ack') }}</button>
                </form>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <div class="admin-panel rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
        <p>{{ t('admin.economy.census_caveat') }}</p>
    </div>

    {% include 'components/grid.twig' with {grid: grid} %}
</div>
