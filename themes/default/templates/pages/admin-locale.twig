<section class="space-y-6">
    <div>
        <h2 class="text-2xl font-bold text-white">{{ t('admin.locale.title') }}</h2>
        <p class="mt-1 text-sm text-slate-400">{{ t('admin.locale.lead') }}</p>
    </div>

    <form method="post" action="/admin/locale" class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6">
        <input type="hidden" name="_csrf" value="{{ csrf }}">

        <label for="default_locale" class="mb-2 block text-sm font-semibold uppercase tracking-wider text-slate-400">
            {{ t('admin.locale.default') }}
        </label>
        <select id="default_locale" name="default_locale" required
                class="w-full max-w-xs rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white outline-none focus:border-blue-500">
            {% for locale in availableLocales %}
                <option value="{{ locale.code }}" {% if defaultLocale == locale.code %}selected{% endif %}>
                    {{ locale.name }}
                </option>
            {% endfor %}
        </select>

        <button type="submit"
                class="mt-6 cursor-pointer rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-500">
            {{ t('admin.save') }}
        </button>
    </form>
</section>
