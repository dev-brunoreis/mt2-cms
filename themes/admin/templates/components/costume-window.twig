{% embed 'components/game-window.twig' with {
    title: t('admin.characters.window_COSTUME'),
    modifier: 'admin-game-window-costume',
    board: board
} %}
    {% block body %}
        <div class="admin-inv-paperdoll admin-inv-paperdoll-costume"
             style="--board-w: {{ board.width }}; --board-h: {{ board.height }};">
            <div class="admin-inv-paperdoll-silhouette admin-inv-paperdoll-silhouette-costume" aria-hidden="true">
                {% include 'components/inventory-silhouette.twig' %}
            </div>
            {% for slot in board.slots %}
                <div class="admin-inv-cell admin-inv-cell-abs"
                     style="--slot-x: {{ slot.x }}; --slot-y: {{ slot.y }}; --slot-w: {{ slot.w }}; --slot-h: {{ slot.h }};"
                     title="{{ t('admin.characters.slot_' ~ slot.key) }}">
                    {% include 'components/inventory-slot.twig' with { item: slot.item } %}
                </div>
            {% endfor %}
        </div>
    {% endblock %}
{% endembed %}
