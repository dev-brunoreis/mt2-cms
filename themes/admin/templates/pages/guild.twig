{% set activeTab = activeTab|default('data') %}

{% if error %}
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        {{ error }}
    </div>
{% endif %}

<form id="admin-guild-form"
      method="post"
      action="/admin/game/guilds/{{ guild.id }}"
      class="admin-panel admin-tabs overflow-hidden"
      data-admin-tabs
      data-default-tab="data"
      data-tab-loading="{{ t('admin.tabs.loading') }}"
      data-tab-load-error="{{ t('admin.tabs.load_error') }}">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <div class="admin-tabs-nav" role="tablist" aria-label="{{ t('admin.tabs.label') }}">
        {% include 'components/tab.twig' with { id: 'data', label: t('admin.guilds.tab_data'), active: activeTab == 'data' } %}
        {% include 'components/tab.twig' with { id: 'members', label: t('admin.guilds.tab_members'), active: activeTab == 'members' } %}
        {% include 'components/tab.twig' with { id: 'comments', label: t('admin.guilds.tab_comments'), active: activeTab == 'comments' } %}
        {% include 'components/tab.twig' with { id: 'wars', label: t('admin.guilds.tab_wars'), active: activeTab == 'wars' } %}
    </div>

    {% include 'components/tab-panel.twig' with {
        id: 'data',
        visible: activeTab == 'data',
        template: 'components/guild-data.twig'
    } %}
    {% include 'components/tab-panel.twig' with {
        id: 'members',
        visible: activeTab == 'members',
        src: '/admin/game/guilds/' ~ guild.id ~ '?tab=members&partial=1',
        template: 'components/guild-members.twig'
    } %}
    {% include 'components/tab-panel.twig' with {
        id: 'comments',
        visible: activeTab == 'comments',
        src: '/admin/game/guilds/' ~ guild.id ~ '?tab=comments&partial=1',
        template: 'components/guild-comments.twig'
    } %}
    {% include 'components/tab-panel.twig' with {
        id: 'wars',
        visible: activeTab == 'wars',
        src: '/admin/game/guilds/' ~ guild.id ~ '?tab=wars&partial=1',
        template: 'components/guild-wars.twig'
    } %}
</form>

<div class="mt-4 flex justify-end">
    <form method="post" action="/admin/game/guilds/{{ guild.id }}/dissolve"
          data-confirm="{{ t('admin.guilds.confirm_dissolve') }}">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <button type="submit" class="admin-link-action admin-link-danger cursor-pointer rounded-md border border-red-200 px-4 py-2 text-sm">
            {{ t('admin.guilds.dissolve') }}
        </button>
    </form>
</div>
