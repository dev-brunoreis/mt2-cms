<section class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">{{ t('account.title') }}</h1>
        <p class="mt-1 text-slate-500">
            {{ t('account.logged_in_as') }} <span class="font-medium text-slate-800">{{ account.login|default(auth.login) }}</span>
        </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-xs uppercase tracking-wider text-slate-500">{{ t('account.status') }}</p>
            <p class="mt-1 text-lg font-semibold text-slate-900">{{ account.status|default('—') }}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-xs uppercase tracking-wider text-slate-500">{{ t('account.empire') }}</p>
            <p class="mt-1 text-lg font-semibold text-slate-900">{{ account.empire|empire_name }}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-xs uppercase tracking-wider text-slate-500">{{ t('account.created') }}</p>
            <p class="mt-1 text-lg font-semibold text-slate-900">{{ account.create_time|game_date }}</p>
        </div>
    </div>

    <div id="characters">
        <h2 class="mb-4 text-xl font-semibold text-slate-900">{{ t('account.characters') }}</h2>

        {% if players is empty %}
            <p class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">
                {{ t('account.empty') }}
            </p>
        {% else %}
            <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-slate-500">
                        <tr>
                            <th class="px-4 py-3 font-medium">{{ t('account.name') }}</th>
                            <th class="px-4 py-3 font-medium">{{ t('account.job') }}</th>
                            <th class="px-4 py-3 font-medium">{{ t('account.level') }}</th>
                            <th class="px-4 py-3 font-medium">{{ t('account.playtime') }}</th>
                            <th class="px-4 py-3 font-medium"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for player in players %}
                            <tr class="hover:bg-slate-50 transition">
                                <td class="px-4 py-3">
                                    <div class="inline-flex items-center gap-2 font-medium text-slate-900">
                                        {% include 'components/face-icon.twig' with { job: player.job } %}
                                        <span>{{ player.name }}</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-slate-600">{{ player.job|job_name(player.skill_group) }}</td>
                                <td class="px-4 py-3 text-slate-600">{{ player.level }}</td>
                                <td class="px-4 py-3 text-slate-600">{{ player.playtime|playtime }}</td>
                                <td class="px-4 py-3 text-right">
                                    <a href="/player/{{ player.name|url_encode }}"
                                       class="font-medium text-indigo-600 hover:underline">{{ t('account.view') }}</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>
