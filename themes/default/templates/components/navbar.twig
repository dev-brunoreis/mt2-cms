<header class="border-b border-slate-200 bg-white/90 shadow-sm backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
        <a href="/" class="text-lg font-semibold tracking-tight text-slate-900 hover:text-indigo-600 transition">
            {{ t('app.name') }}
        </a>

        <div class="flex flex-wrap items-center gap-4 text-sm">
            {% include 'components/locale-switcher.twig' %}
            {% if has_news %}
                <a href="/news" class="font-medium text-slate-600 hover:text-slate-900 transition">{{ t('nav.news') }}</a>
            {% endif %}
            {% if auth.check %}
                <a href="/shop" class="font-medium text-slate-600 hover:text-slate-900 transition">{{ t('nav.shop') }}</a>
            {% endif %}
            <a href="/ranking" class="font-medium text-slate-600 hover:text-slate-900 transition">{{ t('nav.ranking') }}</a>
            <a href="/status" class="font-medium text-slate-600 hover:text-slate-900 transition">{{ t('nav.status') }}</a>
            <a href="/downloads" class="font-medium text-slate-600 hover:text-slate-900 transition">{{ t('nav.downloads') }}</a>

            {% if auth.check %}
                <a href="/donate" class="font-medium text-slate-600 hover:text-slate-900 transition">{{ t('nav.donate') }}</a>
                <a href="/account" class="font-medium text-slate-600 hover:text-slate-900 transition">{{ t('nav.account') }}</a>
                <form method="post" action="/logout" class="inline">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <button type="submit" class="cursor-pointer font-medium text-slate-500 hover:text-red-600 transition">
                        {{ t('nav.logout') }}
                    </button>
                </form>
            {% else %}
                <a href="/login" class="font-medium text-slate-600 hover:text-slate-900 transition">{{ t('nav.login') }}</a>
                <a href="/register"
                   class="rounded-lg bg-indigo-600 px-3 py-1.5 font-medium text-white shadow-sm hover:bg-indigo-500 transition">
                    {{ t('nav.register') }}
                </a>
            {% endif %}
        </div>
    </nav>
</header>
