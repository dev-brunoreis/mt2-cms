{% if error %}
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        {{ error }}
    </div>
{% endif %}

<form id="admin-account-form"
      method="post"
      action="{% if isEdit %}/admin/accounts/{{ account.id }}{% else %}/admin/accounts{% endif %}"
      class="admin-panel{% if isEdit %} admin-tabs overflow-hidden{% else %} p-6{% endif %}"
      {% if isEdit %}data-admin-tabs data-default-tab="dados" data-tab-loading="{{ t('admin.tabs.loading') }}" data-tab-load-error="{{ t('admin.tabs.load_error') }}"{% endif %}>
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    {% if isEdit %}
        <div class="admin-tabs-nav" role="tablist" aria-label="{{ t('admin.tabs.label') }}">
            {% include 'components/tab.twig' with { id: 'dados', label: t('admin.accounts.tab_data'), active: activeTab|default('dados') == 'dados' } %}
            {% include 'components/tab.twig' with { id: 'activity', label: t('admin.accounts.tab_activity'), active: activeTab|default('dados') == 'activity' } %}
        </div>
    {% endif %}

    <div {% if isEdit %}id="admin-tab-panel-dados"
         class="admin-tabs-panel"
         role="tabpanel"
         data-tab-panel="dados"
         aria-labelledby="admin-tab-dados"
         {% if activeTab|default('dados') != 'dados' %}hidden{% endif %}{% endif %}>
        <fieldset class="admin-fieldset">
            <legend>
                {{ t('admin.accounts.details') }}
                <span class="admin-fieldset-help">{{ t('admin.accounts.details_help') }}</span>
            </legend>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="admin-field">
                    <label for="account-login">{{ t('admin.accounts.login') }}</label>
                    <input id="account-login" type="text" name="login" required maxlength="30"
                           value="{{ account.login|default('') }}" class="admin-input" autocomplete="off">
                </div>

                <div class="admin-field">
                    <label for="account-email">{{ t('admin.accounts.email') }}</label>
                    <input id="account-email" type="email" name="email" maxlength="64"
                           value="{{ account.email|default('') }}" class="admin-input"
                           {% if not isEdit %}required{% endif %} autocomplete="off">
                </div>

                <div class="admin-field">
                    <label for="account-password">{{ t('admin.accounts.password') }}</label>
                    <input id="account-password" type="password" name="password" maxlength="16"
                           class="admin-input" autocomplete="new-password"
                           {% if not isEdit %}required{% endif %}>
                    {% if isEdit %}
                        <span class="admin-field-help">{{ t('admin.accounts.password_keep') }}</span>
                    {% endif %}
                </div>

                <div class="admin-field">
                    <label for="account-social-id">{{ t('admin.accounts.social_id') }}</label>
                    <input id="account-social-id" type="password" name="social_id" inputmode="numeric"
                           class="admin-input" autocomplete="off"
                           {% if not isEdit %}required{% endif %}>
                    {% if isEdit %}
                        <span class="admin-field-help">{{ t('admin.accounts.social_id_keep') }}</span>
                    {% endif %}
                </div>
            </div>
        </fieldset>

        <fieldset class="admin-fieldset">
            <legend>
                {{ t('admin.accounts.state') }}
                <span class="admin-fieldset-help">{{ t('admin.accounts.state_help') }}</span>
            </legend>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="admin-field">
                    <label for="account-status">{{ t('admin.accounts.status') }}</label>
                    <select id="account-status" name="status" class="admin-select">
                        <option value="OK" {% if account.status|default('OK') == 'OK' %}selected{% endif %}>
                            {{ t('admin.accounts.status_ok') }}
                        </option>
                        <option value="BLOCK" {% if account.status|default('') == 'BLOCK' %}selected{% endif %}>
                            {{ t('admin.accounts.status_block') }}
                        </option>
                    </select>
                </div>

                <div class="admin-field">
                    <label for="account-empire">{{ t('admin.accounts.empire') }}</label>
                    <select id="account-empire" name="empire" class="admin-select">
                        <option value="0" {% if account.empire|default(0) == 0 %}selected{% endif %}>{{ t('empire.none') }}</option>
                        <option value="1" {% if account.empire|default(0) == 1 %}selected{% endif %}>{{ t('empire.1') }}</option>
                        <option value="2" {% if account.empire|default(0) == 2 %}selected{% endif %}>{{ t('empire.2') }}</option>
                        <option value="3" {% if account.empire|default(0) == 3 %}selected{% endif %}>{{ t('empire.3') }}</option>
                    </select>
                </div>

                <div class="admin-field">
                    <label for="account-cash">{{ t('admin.accounts.cash') }}</label>
                    <input id="account-cash" type="number" name="cash" min="0" step="1"
                           value="{{ account.cash|default(0) }}" class="admin-input">
                </div>

                <div class="admin-field">
                    <label for="account-mileage">{{ t('admin.accounts.mileage') }}</label>
                    <input id="account-mileage" type="number" name="mileage" min="0" step="1"
                           value="{{ account.mileage|default(0) }}" class="admin-input">
                </div>
            </div>
        </fieldset>

        {% if isEdit %}
            <div class="mt-4 px-6 pb-6">
                <a href="/admin/awards/new?login={{ account.login|url_encode }}"
                   class="admin-btn-secondary inline-flex rounded-md px-4 py-2 text-sm font-medium">
                    {{ t('admin.awards.send_item') }}
                </a>
            </div>
        {% endif %}
    </div>

    {% if isEdit %}
        {% include 'components/tab-panel.twig' with {
            id: 'activity',
            visible: activeTab|default('dados') == 'activity',
            src: '/admin/accounts/' ~ account.id ~ '?tab=activity&partial=1',
            template: 'components/account-activity.twig'
        } %}
    {% endif %}
</form>

{% if isEdit %}
    <div class="admin-panel mt-4 p-6">
        <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.accounts.danger') }}</h2>
        <p class="mt-1 text-sm text-slate-500">{{ t('admin.accounts.danger_help') }}</p>

        <div class="mt-4 flex flex-wrap gap-2">
            {% if account.status == 'BLOCK' %}
                <form method="post" action="/admin/accounts/{{ account.id }}/unblock">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <button type="submit" class="admin-btn-secondary cursor-pointer rounded-md px-4 py-2 text-sm font-medium">
                        {{ t('admin.accounts.unblock') }}
                    </button>
                </form>
            {% else %}
                <form method="post" action="/admin/accounts/{{ account.id }}/block">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <button type="submit" class="admin-btn-secondary cursor-pointer rounded-md px-4 py-2 text-sm font-medium">
                        {{ t('admin.accounts.block') }}
                    </button>
                </form>
            {% endif %}

            <form method="post" action="/admin/accounts/{{ account.id }}/delete"
                  data-confirm="{{ t('admin.accounts.confirm_delete') }}">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <button type="submit" class="admin-btn-danger cursor-pointer rounded-md px-4 py-2 text-sm font-semibold text-white">
                    {{ t('admin.accounts.delete') }}
                </button>
            </form>
        </div>
    </div>
{% endif %}
