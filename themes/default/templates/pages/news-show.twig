<section class="space-y-6">
    {% if notFound|default(false) or post is null %}
        <div class="k-panel p-10 text-center">
            <h1 class="k-title text-xl">{{ t('news.not_found') }}</h1>
            <a href="/news" class="k-btn k-btn-ghost mt-4 inline-flex">{{ t('news.back') }}</a>
        </div>
    {% else %}
        <article class="k-panel overflow-hidden">
            {% if post.cover_image %}
                <div class="aspect-[21/9] bg-[#0a0806]">
                    <img src="{{ post.cover_image }}" alt="" class="h-full w-full object-cover opacity-90">
                </div>
            {% endif %}
            <div class="p-5 sm:p-7">
                <a href="/news" class="text-xs font-medium">{{ t('news.back') }}</a>
                <h1 class="k-title mt-3 text-2xl sm:text-3xl">{{ post.title }}</h1>
                <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs k-muted">
                    <span>{{ t('news.by', {author: post.author_login}) }}</span>
                    <span>{{ (post.published_at|default(post.created_at))|game_date }}</span>
                    {% if news_show_views|default(true) %}
                        <span>{{ t('news.views', {count: post.views}) }}</span>
                    {% endif %}
                </p>
                <div class="news-body mt-6 max-w-none space-y-4 [&_li]:ml-5 [&_ol]:list-decimal [&_ul]:list-disc [&_img]:my-4 [&_img]:max-w-full">
                    {{ post.body|news_html }}
                </div>
            </div>
        </article>

        <section class="k-panel p-5 sm:p-7">
            <h2 class="k-title text-xl">{{ t('news.comments_title') }}</h2>

            {% if not commentsEnabled %}
                <p class="mt-3 text-sm k-muted">{{ t('news.comments_disabled') }}</p>
            {% else %}
                {% if comments is empty %}
                    <p class="mt-3 text-sm k-muted">{{ t('news.comments_empty') }}</p>
                {% else %}
                    <ul class="mt-5 space-y-3">
                        {% for comment in comments %}
                            <li class="border border-[var(--k-border)] bg-[#0a0806]/40 p-4">
                                <div class="flex flex-wrap items-center gap-2 text-sm">
                                    <span class="font-medium text-[var(--k-bronze)]">{{ comment.account_login }}</span>
                                    <span class="text-xs k-muted">{{ comment.created_at|game_date }}</span>
                                    {% if comment.status == 'pending' %}
                                        <span class="rounded-full bg-amber-900/40 px-2 py-0.5 text-[0.65rem] text-amber-200">
                                            {{ t('news.comment_pending_badge') }}
                                        </span>
                                    {% endif %}
                                </div>
                                <p class="mt-2 whitespace-pre-wrap text-sm text-[var(--k-text)]">{{ comment.body }}</p>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if canComment %}
                    <form method="post" action="/news/{{ post.id }}/comment" class="mt-6 space-y-3">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <label for="comment-body" class="block text-sm font-medium text-[var(--k-text)]">
                            {{ t('news.comment_label') }}
                        </label>
                        <textarea id="comment-body" name="body" rows="4" required maxlength="2000"
                                  class="k-input w-full text-sm"
                                  placeholder="{{ t('news.comment_placeholder') }}"></textarea>
                        {% if commentsRequireApproval %}
                            <p class="text-xs k-muted">{{ t('news.comment_approval_hint') }}</p>
                        {% endif %}
                        <button type="submit" class="k-btn">{{ t('news.comment_submit') }}</button>
                    </form>
                {% else %}
                    <p class="mt-4 text-sm k-muted">
                        <a href="/login">{{ t('news.login_to_comment') }}</a>
                    </p>
                {% endif %}
            {% endif %}
        </section>
    {% endif %}
</section>
