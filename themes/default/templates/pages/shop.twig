{% macro category_tree(nodes, activeCategory, expandedIds) %}
    <ul class="shop-cat-list" data-shop-cat-list>
        {% for category in nodes %}
            {% set hasChildren = category.children is not empty %}
            {% set isActive = activeCategory and activeCategory.id == category.id %}
            {% set isExpanded = hasChildren and (category.id in expandedIds) %}
            <li class="shop-cat-item {% if isExpanded %}is-open{% elseif hasChildren %}is-collapsed{% endif %}"
                data-shop-cat-item
                data-id="{{ category.id }}">
                <div class="k-shop-cat {% if isActive %}is-active{% endif %}">
                    {% if hasChildren %}
                        <button type="button"
                                class="shop-cat-toggle k-shop-cat-toggle"
                                data-shop-cat-toggle
                                aria-expanded="{{ isExpanded ? 'true' : 'false' }}"
                                aria-label="{{ t('shop.toggle_category') }}">
                            <svg class="h-3.5 w-3.5 transition-transform {% if not isExpanded %}-rotate-90{% endif %}" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                    {% else %}
                        <span class="k-shop-cat-spacer" aria-hidden="true"></span>
                    {% endif %}
                    <a href="/shop?category={{ category.slug|url_encode }}" class="k-shop-cat-link">
                        {{ category.name }}
                    </a>
                </div>
                {% if hasChildren %}
                    <div class="shop-cat-children k-shop-cat-children {% if not isExpanded %}hidden{% endif %}"
                         data-shop-cat-children>
                        {{ _self.category_tree(category.children, activeCategory, expandedIds) }}
                    </div>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

<section class="space-y-5">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="k-title text-2xl">{{ t('shop.title') }}</h1>
            <p class="mt-1 text-sm k-muted">{{ t('shop.lead') }}</p>
        </div>
        {% if auth.check and cash is not null %}
            <div class="k-shop-cash">
                <span class="k-muted">{{ t('shop.your_cash') }}</span>
                <span class="k-shop-cash-value">{{ cash }}</span>
            </div>
        {% endif %}
    </div>

    {% if notFound %}
        <div class="k-panel p-10 text-center">
            <p class="text-sm k-muted">{{ t('shop.category_not_found') }}</p>
            <a href="/shop" class="k-btn k-btn-ghost mt-4 inline-flex">{{ t('shop.back') }}</a>
        </div>
    {% else %}
        {% if categories is not empty %}
            <nav class="k-panel k-shop-cats" data-shop-category-tree aria-label="{{ t('shop.categories') }}">
                <div class="k-panel-head">{{ t('shop.categories') }}</div>
                <div class="p-2">
                    <a href="/shop" class="k-shop-cat {% if not activeCategory %}is-active{% endif %}">
                        <span class="k-shop-cat-spacer" aria-hidden="true"></span>
                        <span class="k-shop-cat-link">{{ t('shop.all_categories') }}</span>
                    </a>
                    {% import _self as shop_nav %}
                    {{ shop_nav.category_tree(categories, activeCategory, expandedCategoryIds|default([])) }}
                </div>
            </nav>
        {% endif %}

        {% if products is empty %}
            <div class="k-panel p-10 text-center">
                <p class="text-sm k-muted">{{ t('shop.empty') }}</p>
            </div>
        {% else %}
            <ul class="k-shop-list">
                {% for product in products %}
                    <li class="k-shop-product shop-product-card">
                        {% set icon = item_icon(product.vnum) %}
                        <div class="mt2-item-tip-host k-shop-icon" tabindex="0">
                            {% if icon %}
                                <img src="{{ icon }}" alt="" width="48" height="48">
                            {% else %}
                                <span class="k-shop-icon-fallback" aria-hidden="true">?</span>
                            {% endif %}
                            {% if product.tooltip is defined %}
                                {% include 'components/item-tooltip.twig' with { tip: product.tooltip, icon_src: icon } %}
                            {% endif %}
                        </div>
                        <div class="k-shop-product-body">
                            <h2 class="k-shop-product-name" title="{{ product.item_name }}">{{ product.item_name }}</h2>
                            <p class="k-shop-product-meta">
                                {{ product.category_name }}
                                <span aria-hidden="true">·</span>
                                {{ t('shop.qty', {count: product.count}) }}
                            </p>
                        </div>
                        <div class="k-shop-product-buy">
                            <p class="k-shop-price">{{ t('shop.price', {price: product.price}) }}</p>
                            {% if auth.check %}
                                <form method="post" action="/shop/buy"
                                      data-confirm="{{ t('shop.confirm_buy', {name: product.item_name, price: product.price}) }}">
                                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                                    <input type="hidden" name="product_id" value="{{ product.id }}">
                                    <input type="hidden" name="idempotency_key" value="{{ idempotencyKeys[product.id]|default('') }}">
                                    <button type="submit" class="k-btn k-btn-ember k-btn-sm">{{ t('shop.buy') }}</button>
                                </form>
                            {% else %}
                                <a href="/login" class="k-btn k-btn-ghost k-btn-sm !no-underline">{{ t('shop.login_to_buy') }}</a>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}
</section>
