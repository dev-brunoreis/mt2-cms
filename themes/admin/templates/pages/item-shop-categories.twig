{# Magento-style category tree: left tree, right edit + products #}
<div class="admin-category-workspace"
     data-category-tree
     data-move-url="{{ moveUrl }}"
     data-csrf="{{ csrf }}"
     data-move-error="{{ t('admin.item_shop.categories.move_failed') }}">
    <aside class="admin-category-tree-panel">
        <div class="admin-category-tree-toolbar">
            <p class="admin-category-tree-title">{{ t('admin.item_shop.categories.tree_title') }}</p>
            <div class="flex flex-wrap gap-2">
                <a href="/admin/item-shop/categories/new" class="admin-btn-secondary rounded-md px-2.5 py-1.5 text-xs font-medium">
                    {{ t('admin.item_shop.categories.add_root') }}
                </a>
                {% if selectedCategory %}
                    <a href="/admin/item-shop/categories/new?parent_id={{ selectedCategory.id }}"
                       class="admin-btn-secondary rounded-md px-2.5 py-1.5 text-xs font-medium">
                        {{ t('admin.item_shop.categories.add_child') }}
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="admin-category-tree-root" data-tree-root data-parent-id="">
            <div class="admin-category-tree-root-label">{{ t('admin.item_shop.categories.root') }}</div>
            <ul class="admin-category-tree-list" data-tree-list data-parent-id="">
                {% if categoryTree is empty %}
                    <li class="px-3 py-4 text-sm text-slate-500">{{ t('admin.item_shop.categories.empty') }}</li>
                {% else %}
                    {% for node in categoryTree %}
                        {% include 'components/category-tree-node.twig' with {
                            node: node,
                            selectedId: selectedCategory.id|default(0)
                        } %}
                    {% endfor %}
                {% endif %}
            </ul>
        </div>
        <p class="admin-category-tree-hint">{{ t('admin.item_shop.categories.tree_hint') }}</p>
    </aside>

    <section class="admin-category-form-panel">
        {% if error %}
            <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ error }}</div>
        {% endif %}

        {% if showForm and category %}
            {% if isEdit %}
                <div class="admin-panel admin-tabs overflow-hidden"
                     data-admin-tabs data-default-tab="{{ activeTab|default('dados') }}"
                     data-tab-loading="{{ t('admin.tabs.loading') }}"
                     data-tab-load-error="{{ t('admin.tabs.load_error') }}">
                    <div class="admin-tabs-nav" role="tablist" aria-label="{{ t('admin.tabs.label') }}">
                        {% include 'components/tab.twig' with { id: 'dados', label: t('admin.item_shop.categories.tab_settings'), active: activeTab|default('dados') == 'dados' } %}
                        {% include 'components/tab.twig' with { id: 'products', label: t('admin.item_shop.categories.tab_products'), active: activeTab|default('dados') == 'products' } %}
                    </div>

                    <div id="admin-tab-panel-dados" class="admin-tabs-panel" role="tabpanel" data-tab-panel="dados"
                         {% if activeTab|default('dados') != 'dados' %}hidden{% endif %}>
                        {% include 'components/category-settings-form.twig' %}
                    </div>

                    <div id="admin-tab-panel-products" class="admin-tabs-panel" role="tabpanel" data-tab-panel="products"
                         {% if activeTab|default('dados') != 'products' %}hidden{% endif %}>
                        {% include 'components/category-products.twig' %}
                    </div>
                </div>
            {% else %}
                {% include 'components/category-settings-form.twig' %}
            {% endif %}
        {% else %}
            <div class="admin-panel flex min-h-[16rem] items-center justify-center p-8 text-center">
                <div>
                    <p class="text-sm text-slate-500">{{ t('admin.item_shop.categories.select_hint') }}</p>
                    <a href="/admin/item-shop/categories/new"
                       class="mt-4 inline-flex admin-btn-primary rounded-md px-4 py-2 text-sm font-semibold text-white">
                        {{ t('admin.item_shop.categories.add_root') }}
                    </a>
                </div>
            </div>
        {% endif %}
    </section>
</div>
