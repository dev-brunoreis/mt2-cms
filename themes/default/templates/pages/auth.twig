<div class="mx-auto max-w-md">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <h1 class="mb-8 text-center text-3xl font-bold text-slate-900">
            {% if form == 'login' %}{{ t('auth.login_title') }}{% else %}{{ t('auth.register_title') }}{% endif %}
        </h1>

        {% if form == 'login' %}
            <form method="post" action="/login" class="flex flex-col gap-5">
                <input type="hidden" name="_csrf" value="{{ csrf }}">

                <div class="flex flex-col gap-2">
                    <label for="username" class="text-sm font-medium text-slate-700">{{ t('auth.username') }}</label>
                    <input id="username" type="text" name="username" required value="{{ username }}"
                           class="rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20">
                </div>

                <div class="flex flex-col gap-2">
                    <label for="password" class="text-sm font-medium text-slate-700">{{ t('auth.password') }}</label>
                    <input id="password" type="password" name="password" required
                           class="rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20">
                </div>

                {% if error %}
                    <p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-center text-sm text-red-700">{{ error }}</p>
                {% endif %}

                {% if captchaEnabled|default(false) %}
                    <div class="flex flex-col gap-2">
                        <label for="captcha" class="text-sm font-medium text-slate-700">{{ t('auth.captcha') }}</label>
                        <div class="flex items-center gap-3">
                            <img src="/captcha.svg" alt="" width="160" height="48" class="rounded border border-slate-200">
                            <input id="captcha" type="text" name="captcha" required autocomplete="off" maxlength="5"
                                   class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 uppercase tracking-widest text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20">
                        </div>
                    </div>
                {% endif %}

                <button type="submit"
                        class="mt-2 cursor-pointer rounded-lg bg-indigo-600 px-4 py-3 font-semibold text-white transition hover:bg-indigo-500">
                    {{ t('auth.submit_login') }}
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-slate-500">
                {{ t('auth.no_account') }}
                <a href="/register" class="font-medium text-indigo-600 hover:underline">{{ t('auth.register_link') }}</a>
            </p>
        {% elseif registrationBlocked|default(false) %}
            <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-4 text-center">
                <p class="font-medium text-amber-900">{{ t('auth.registration_disabled_title') }}</p>
                <p class="mt-2 text-sm text-amber-800/80">{{ t('auth.registration_disabled') }}</p>
            </div>

            <p class="mt-6 text-center text-sm text-slate-500">
                {{ t('auth.have_account') }}
                <a href="/login" class="font-medium text-indigo-600 hover:underline">{{ t('auth.login_link') }}</a>
            </p>
        {% else %}
            <form method="post" action="/register" class="flex flex-col gap-5">
                <input type="hidden" name="_csrf" value="{{ csrf }}">

                <div class="flex flex-col gap-2">
                    <label for="username" class="text-sm font-medium text-slate-700">{{ t('auth.username') }}</label>
                    <input id="username" type="text" name="username" required value="{{ username }}"
                           class="rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20">
                </div>

                <div class="flex flex-col gap-2">
                    <label for="email" class="text-sm font-medium text-slate-700">{{ t('auth.email') }}</label>
                    <input id="email" type="email" name="email" required value="{{ email }}"
                           class="rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20">
                </div>

                <div class="flex flex-col gap-2">
                    <label for="social_id" class="text-sm font-medium text-slate-700">{{ t('auth.social_id') }}</label>
                    <input id="social_id" type="text" name="social_id" required value="{{ socialId }}"
                           class="rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20">
                </div>

                <div class="flex flex-col gap-2">
                    <label for="password" class="text-sm font-medium text-slate-700">{{ t('auth.password') }}</label>
                    <input id="password" type="password" name="password" required
                           class="rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20">
                </div>

                {% if error %}
                    <p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-center text-sm text-red-700">{{ error }}</p>
                {% endif %}

                {% if captchaEnabled|default(false) %}
                    <div class="flex flex-col gap-2">
                        <label for="captcha" class="text-sm font-medium text-slate-700">{{ t('auth.captcha') }}</label>
                        <div class="flex items-center gap-3">
                            <img src="/captcha.svg" alt="" width="160" height="48" class="rounded border border-slate-200">
                            <input id="captcha" type="text" name="captcha" required autocomplete="off" maxlength="5"
                                   class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 uppercase tracking-widest text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20">
                        </div>
                    </div>
                {% endif %}

                <button type="submit"
                        class="mt-2 cursor-pointer rounded-lg bg-indigo-600 px-4 py-3 font-semibold text-white transition hover:bg-indigo-500">
                    {{ t('auth.submit_register') }}
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-slate-500">
                {{ t('auth.have_account') }}
                <a href="/login" class="font-medium text-indigo-600 hover:underline">{{ t('auth.login_link') }}</a>
            </p>
        {% endif %}
    </div>
</div>
