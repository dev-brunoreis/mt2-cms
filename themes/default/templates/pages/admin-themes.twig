<section class="space-y-6">
    <div>
        <h2 class="text-2xl font-bold text-white">{{ t('admin.themes.title') }}</h2>
        <p class="mt-1 text-sm text-slate-400">{{ t('admin.themes.lead') }}</p>
    </div>

    <form method="post" action="/admin/themes" class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 space-y-6">
        <input type="hidden" name="_csrf" value="{{ csrf }}">

        <div>
            <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-slate-400">{{ t('admin.themes.available') }}</h3>
            <div class="space-y-2">
                {% for themeName in diskThemes %}
                    <label class="flex items-center gap-3 rounded-lg border border-slate-800 px-3 py-2 cursor-pointer hover:bg-slate-800/50">
                        <input type="checkbox" name="themes[]" value="{{ themeName }}"
                               {% if themeName in enabledThemes %}checked{% endif %}
                               class="h-4 w-4 rounded border-slate-600 bg-slate-800 text-blue-600">
                        <span class="text-white">{{ themeName }}</span>
                    </label>
                {% endfor %}
            </div>
        </div>

        <div>
            <label for="active_theme" class="mb-2 block text-sm font-semibold uppercase tracking-wider text-slate-400">
                {{ t('admin.themes.active') }}
            </label>
            <select id="active_theme" name="active_theme" required
                    class="w-full max-w-xs rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white outline-none focus:border-blue-500">
                {% for themeName in diskThemes %}
                    <option value="{{ themeName }}" {% if activeTheme == themeName %}selected{% endif %}>{{ themeName }}</option>
                {% endfor %}
            </select>
        </div>

        <button type="submit"
                class="cursor-pointer rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-500">
            {{ t('admin.save') }}
        </button>
    </form>
</section>
