<form method="post" action="/locale" class="inline-flex items-center">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="redirect" value="{{ current_path }}">
    <label for="locale-switcher" class="sr-only">{{ t('locale.label') }}</label>
    <select id="locale-switcher" name="locale"
            class="cursor-pointer rounded-lg border border-slate-700 bg-slate-800 px-2 py-1 text-xs text-slate-200 outline-none hover:border-slate-500 focus:border-blue-500">
        {% for item in locales %}
            <option value="{{ item.code }}"{% if item.code == locale %} selected{% endif %}>{{ item.name }}</option>
        {% endfor %}
    </select>
    <noscript>
        <button type="submit" class="ml-1 rounded-lg border border-slate-700 px-2 py-1 text-xs text-slate-300">
            {{ t('locale.label') }}
        </button>
    </noscript>
</form>
