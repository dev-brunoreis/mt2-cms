{% set actionColumns = grid.columns|filter(c => c.type|default('text') == 'actions') %}
{% set hasActions = actionColumns|length > 0 %}
{% set dataColumns = grid.columns|filter(c => c.type|default('text') != 'actions') %}
{% set extraFilters = grid.extraFilters|default([]) %}
{% set hasFilters = grid.hasFilters|default(grid.filters is not empty) %}
{% set filterFormId = 'admin-grid-filter-' ~ grid.action|replace({'/': '-', '?': '-', '=': '-', '#': '-'}) %}

<div class="admin-panel admin-grid overflow-hidden" data-admin-grid>
    <form id="{{ filterFormId }}" method="get" action="{{ grid.action }}" hidden>
        {% if grid.sort != grid.defaultSort|default('') %}<input type="hidden" name="sort" value="{{ grid.sort }}">{% endif %}
        {% if grid.dir != grid.defaultDir|default('desc') %}<input type="hidden" name="dir" value="{{ grid.dir }}">{% endif %}
        {% if grid.perPage != grid.defaultPerPage|default(20) %}<input type="hidden" name="limit" value="{{ grid.perPage }}">{% endif %}
    </form>

    <div class="admin-grid-toolbar">
        <div class="admin-grid-toolbar-start">
            <p class="admin-grid-count">
                {{ t(grid.i18nPrefix ~ '.count', {count: grid.total}) }}
            </p>
            {% if extraFilters is not empty %}
                <div class="admin-grid-extra-filters">
                    {% for filter in extraFilters %}
                        <label class="admin-grid-extra-filter" for="grid-col-filter-{{ filter.key }}">
                            <span>{{ t(filter.label) }}</span>
                            {% include 'components/grid-filter-input.twig' with { column: { columnFilter: filter }, grid: grid, filterFormId: filterFormId } %}
                        </label>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="admin-grid-toolbar-end">
            <label class="admin-grid-limit">
                <span class="sr-only">{{ t('admin.grid.per_page') }}</span>
                <select class="admin-input admin-input-compact" data-grid-limit>
                    {% for option in grid.perPageOptions %}
                        <option value="{{ grid_url(grid, {limit: option, page: 1}) }}"
                                {% if grid.perPage == option %}selected{% endif %}>
                            {{ option }}
                        </option>
                    {% endfor %}
                </select>
            </label>
            {% if hasFilters %}
                
                {% if grid.filterValues is not empty %}
                    <a href="{{ grid.urls.reset }}" class="admin-link-action text-sm">{{ t('admin.grid.reset') }}</a>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {% if grid.hasMassActions and grid.rows is not empty %}
        {% set massFormId = 'admin-grid-mass-' ~ grid.i18nPrefix|replace({'.': '-'}) %}
        <form id="{{ massFormId }}" method="post" action="{{ grid.massActionPath }}" data-grid-mass-form>
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <div class="admin-grid-mass-bar">
                <select name="mass_action" class="admin-input admin-input-compact" data-grid-mass-action required>
                    <option value="">{{ t('admin.grid.mass_actions') }}</option>
                    {% for action in grid.massActions|sort_by_t %}
                        <option value="{{ action.id }}"
                                {% if action.confirm is defined %}data-confirm="{{ t(action.confirm) }}"{% endif %}>
                            {{ t(action.label) }}
                        </option>
                    {% endfor %}
                </select>
                <button type="submit" class="admin-btn-secondary cursor-pointer rounded-md px-3 py-2 text-sm font-medium"
                        data-grid-mass-submit disabled>
                    {{ t('admin.grid.mass_submit') }}
                </button>
                <span class="admin-grid-selected text-sm text-slate-500" data-grid-selected-count
                      data-template="{{ t('admin.grid.selected', {count: '__COUNT__'})|e('html_attr') }}" hidden></span>
            </div>
        </form>
    {% endif %}

    <div class="overflow-x-auto">
        <table class="admin-table admin-grid-table">
            <thead>
                <tr>
                    {% if grid.hasMassActions %}
                        <th class="admin-grid-check-col">
                            {% if grid.rows is not empty %}
                                <input type="checkbox" data-grid-select-all
                                       aria-label="{{ t('admin.grid.select_all') }}">
                            {% endif %}
                        </th>
                    {% endif %}
                    {% for column in dataColumns %}
                        <th>
                            {% if column.sort is defined and column.sort %}
                                <a href="{{ grid_sort_url(grid, column.sort) }}"
                                   class="admin-grid-sort-link {% if grid.sort == column.sort %}is-active is-{{ grid.dir }}{% endif %}">
                                    {{ t(column.label) }}
                                </a>
                            {% else %}
                                {{ t(column.label) }}
                            {% endif %}
                        </th>
                    {% endfor %}
                    {% if hasActions %}
                        <th>{{ t('admin.grid.actions') }}</th>
                    {% endif %}
                </tr>
                {% if grid.hasColumnFilters|default(false) %}
                    <tr class="admin-grid-filter-row">
                        {% if grid.hasMassActions %}
                            <th class="admin-grid-check-col"></th>
                        {% endif %}
                        {% for column in dataColumns %}
                            <th>
                                {% if column.columnFilter is defined %}
                                    {% include 'components/grid-filter-input.twig' with { column: column, grid: grid, filterFormId: filterFormId } %}
                                {% endif %}
                            </th>
                        {% endfor %}
                        {% if hasActions %}
                            <th></th>
                        {% endif %}
                    </tr>
                {% endif %}
            </thead>
            <tbody>
                {% if grid.rows is empty %}
                    <tr>
                        <td colspan="{{ dataColumns|length + (grid.hasMassActions ? 1 : 0) + (hasActions ? 1 : 0) }}">
                            <p class="admin-grid-empty">
                                {{ t(grid.i18nPrefix ~ '.empty') }}
                            </p>
                        </td>
                    </tr>
                {% else %}
                    {% for row in grid.rows %}
                        <tr{% if row._rowClass is defined %} class="{{ row._rowClass }}"{% endif %}>
                            {% if grid.hasMassActions %}
                                <td class="admin-grid-check-col">
                                    {% if row.can_mass|default(true) %}
                                        <input type="checkbox" name="ids[]" value="{{ attribute(row, grid.idField) }}"
                                               {% if grid.hasMassActions %}form="{{ massFormId }}"{% endif %}
                                               data-grid-row-check>
                                    {% endif %}
                                </td>
                            {% endif %}
                            {% for column in dataColumns %}
                                <td{% if column.class is defined %} class="{{ column.class }}"{% endif %}>
                                    {% include 'components/grid-cell.twig' with {column: column, row: row, grid: grid} %}
                                </td>
                            {% endfor %}
                            {% if hasActions %}
                                <td>
                                    {% for column in actionColumns %}
                                        {% include 'components/grid-cell.twig' with {column: column, row: row, grid: grid} %}
                                    {% endfor %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>

    {% if grid.totalPages > 1 %}
        <nav class="admin-grid-pager">
            {% if grid.page > 1 %}
                <a href="{{ grid_url(grid, {page: grid.page - 1}) }}"
                   class="admin-btn-secondary rounded-md px-3 py-1.5">
                    {{ t('admin.grid.previous') }}
                </a>
            {% endif %}
            <span class="px-2 text-slate-500">
                {{ t('admin.grid.page_of', {page: grid.page, total: grid.totalPages}) }}
            </span>
            {% if grid.page < grid.totalPages %}
                <a href="{{ grid_url(grid, {page: grid.page + 1}) }}"
                   class="admin-btn-secondary rounded-md px-3 py-1.5">
                    {{ t('admin.grid.next') }}
                </a>
            {% endif %}
        </nav>
    {% endif %}
</div>
