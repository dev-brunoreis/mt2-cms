<div class="admin-panel overflow-hidden">
    <div class="flex flex-col gap-3 border-b border-slate-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between md:px-6">
        <p class="text-sm text-slate-500">
            {{ t('admin.shops.count', {count: total}) }}
            {% if query %} {{ t('admin.shops.matching', {query: query}) }}{% endif %}
        </p>
        <form method="get" action="/admin/shops" class="flex gap-2">
            <input type="search" name="q" value="{{ query }}" placeholder="{{ t('admin.shops.search_placeholder') }}"
                   class="admin-input admin-input-compact">
            <button type="submit" class="admin-btn-secondary cursor-pointer rounded-md px-3 py-2 text-sm font-medium">
                {{ t('admin.shops.search') }}
            </button>
        </form>
    </div>

    {% if shops is empty %}
        <p class="px-4 py-10 text-center text-sm text-slate-500 md:px-6">{{ t('admin.shops.empty') }}</p>
    {% else %}
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>{{ t('admin.shops.vnum') }}</th>
                        <th>{{ t('admin.shops.name') }}</th>
                        <th>{{ t('admin.shops.npc') }}</th>
                        <th>{{ t('admin.shops.items') }}</th>
                        <th>{{ t('admin.shops.actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for shop in shops %}
                        <tr>
                            <td class="text-slate-400">{{ shop.vnum }}</td>
                            <td><a href="/admin/shops/{{ shop.vnum }}" class="font-medium text-indigo-600 hover:underline">{{ shop.name }}</a></td>
                            <td class="text-slate-600">
                                {% if shop.npc_vnum %}
                                    <a href="/admin/mobs/{{ shop.npc_vnum }}" class="text-indigo-600 hover:underline">{{ shop.npc_vnum }}</a>
                                {% else %}—{% endif %}
                            </td>
                            <td class="text-slate-600">{{ shop.item_count }}</td>
                            <td><a href="/admin/shops/{{ shop.vnum }}" class="admin-link-action">{{ t('admin.shops.edit') }}</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 border-t border-slate-100 px-4 py-3 text-sm">
            {% if page > 1 %}
                <a href="/admin/shops?page={{ page - 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}" class="admin-btn-secondary rounded-md px-3 py-1.5">{{ t('admin.shops.previous') }}</a>
            {% endif %}
            <span class="px-2 text-slate-500">{{ t('admin.shops.page_of', {page: page, total: totalPages}) }}</span>
            {% if page < totalPages %}
                <a href="/admin/shops?page={{ page + 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}" class="admin-btn-secondary rounded-md px-3 py-1.5">{{ t('admin.shops.next') }}</a>
            {% endif %}
        </nav>
    {% endif %}
</div>
