<section class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold text-white">My Account</h1>
        <p class="mt-1 text-slate-400">
            Logged in as <span class="text-slate-200 font-medium">{{ account.login|default(auth.login) }}</span>
        </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
            <p class="text-xs uppercase tracking-wider text-slate-500">Status</p>
            <p class="mt-1 text-lg font-semibold text-white">{{ account.status|default('—') }}</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
            <p class="text-xs uppercase tracking-wider text-slate-500">Empire</p>
            <p class="mt-1 text-lg font-semibold text-white">{{ account.empire|empire_name }}</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
            <p class="text-xs uppercase tracking-wider text-slate-500">Created</p>
            <p class="mt-1 text-lg font-semibold text-white">{{ account.create_time|game_date }}</p>
        </div>
    </div>

    <div id="characters">
        <h2 class="mb-4 text-xl font-semibold text-white">Characters</h2>

        {% if players is empty %}
            <p class="rounded-xl border border-dashed border-slate-700 p-8 text-center text-slate-400">
                No characters on this account yet.
            </p>
        {% else %}
            <div class="overflow-hidden rounded-xl border border-slate-800">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-900 text-slate-400">
                        <tr>
                            <th class="px-4 py-3 font-medium">Name</th>
                            <th class="px-4 py-3 font-medium">Job</th>
                            <th class="px-4 py-3 font-medium">Level</th>
                            <th class="px-4 py-3 font-medium">Playtime</th>
                            <th class="px-4 py-3 font-medium"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        {% for player in players %}
                            <tr class="bg-slate-950/40 hover:bg-slate-900/80 transition">
                                <td class="px-4 py-3 font-medium text-white">{{ player.name }}</td>
                                <td class="px-4 py-3 text-slate-300">{{ player.job|job_name }}</td>
                                <td class="px-4 py-3 text-slate-300">{{ player.level }}</td>
                                <td class="px-4 py-3 text-slate-300">{{ player.playtime|playtime }}</td>
                                <td class="px-4 py-3 text-right">
                                    <a href="/player/{{ player.name|url_encode }}"
                                       class="text-blue-400 hover:underline">View</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</section>
