{% set activeTab = activeTab|default('dados') %}
<div class="admin-panel admin-tabs overflow-hidden"
     data-admin-tabs
     data-default-tab="dados"
     data-tab-loading="{{ t('admin.tabs.loading') }}"
     data-tab-load-error="{{ t('admin.tabs.load_error') }}">
    <div class="admin-tabs-nav" role="tablist" aria-label="{{ t('admin.tabs.label') }}">
        {% include 'components/tab.twig' with { id: 'dados', label: t('admin.owned_items.tab_data'), active: activeTab == 'dados' } %}
        {% include 'components/tab.twig' with { id: 'logs', label: t('admin.owned_items.tab_logs'), active: activeTab == 'logs' } %}
    </div>

    {% include 'components/tab-panel.twig' with {
        id: 'dados',
        visible: activeTab == 'dados',
        template: 'components/owned-item-data.twig'
    } %}
    {% include 'components/tab-panel.twig' with {
        id: 'logs',
        visible: activeTab == 'logs',
        src: '/admin/owned-items/' ~ itemId ~ '?tab=logs&partial=1',
        template: 'components/owned-item-logs.twig'
    } %}
</div>
