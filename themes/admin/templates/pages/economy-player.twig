<div class="space-y-4">
    <div class="admin-panel p-4 md:p-6">
        <dl class="admin-stat-grid">
            <div class="admin-stat admin-stat-highlight">
                <dt>{{ t('admin.economy.player_yang_now') }}</dt>
                <dd>{% if gold is not null %}{{ gold|number_format }}{% else %}—{% endif %}</dd>
            </div>
            <div class="admin-stat">
                <dt>{{ t('admin.economy.player') }}</dt>
                <dd>
                    <a class="text-indigo-600 hover:underline" href="{{ characterHref }}">{{ playerName }}</a>
                    <span class="text-sm font-normal text-slate-500">#{{ pid }}</span>
                </dd>
            </div>
        </dl>
        <p class="mt-2 text-sm text-slate-500">{{ t('admin.economy.player_yang_help') }}</p>
    </div>

    {% if alerts|length > 0 %}
    <div class="admin-panel p-4 md:p-6">
        <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.economy.alerts_title') }}</h2>
        <ul class="mt-3 space-y-2">
            {% for alert in alerts %}
            <li class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-2 last:border-0">
                <div>
                    <span class="admin-badge admin-badge-muted">{{ t('admin.economy.alert_kind.' ~ alert.kind) }}</span>
                    <span class="text-sm text-slate-500">{{ alert.created_at }}</span>
                    {% if alert.acked_at %}<span class="text-sm text-slate-400">{{ t('admin.economy.acked') }}</span>{% endif %}
                </div>
                {% if not alert.acked_at %}
                <form method="post" action="/admin/game/economy/alerts/{{ alert.id }}/ack" class="inline">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="back" value="/admin/game/economy/players/{{ pid }}">
                    <button type="submit" class="admin-btn-secondary rounded-md px-2.5 py-1.5 text-xs font-medium">{{ t('admin.economy.ack') }}</button>
                </form>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <div class="admin-panel p-4 md:p-6 overflow-x-auto">
        <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.economy.player_trades') }}</h2>
        {% if trades|length == 0 %}
        <p class="mt-2 text-sm text-slate-500">{{ t('admin.economy.no_trades') }}</p>
        {% else %}
        <table class="admin-table mt-3">
            <thead>
                <tr>
                    <th>{{ t('admin.economy.sold_at') }}</th>
                    <th>{{ t('admin.economy.item') }}</th>
                    <th>{{ t('admin.economy.seller') }}</th>
                    <th>{{ t('admin.economy.buyer') }}</th>
                    <th>{{ t('admin.economy.price_yang') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for trade in trades %}
                <tr>
                    <td>{{ trade.sold_at }}</td>
                    <td><a class="text-indigo-600 hover:underline" href="/admin/game/economy/{{ trade.vnum }}">{{ trade.item_name }}</a></td>
                    <td>{% if trade.seller_pid %}{% if trade.seller_name %}{{ trade.seller_name }}{% else %}#{{ trade.seller_pid }}{% endif %}{% else %}—{% endif %}</td>
                    <td>{% if trade.buyer_pid %}{% if trade.buyer_name %}{{ trade.buyer_name }}{% else %}#{{ trade.buyer_pid }}{% endif %}{% else %}—{% endif %}</td>
                    <td>{{ trade.price_yang|number_format }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>

    <div class="admin-panel p-4 md:p-6 overflow-x-auto">
        <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.economy.player_transfers') }}</h2>
        <p class="mt-1 text-sm text-slate-500">{{ t('admin.economy.transfers_help') }}</p>
        {% if transfers|length == 0 %}
        <p class="mt-2 text-sm text-slate-500">{{ t('admin.economy.transfers_empty') }}</p>
        {% else %}
        <table class="admin-table mt-3">
            <thead>
                <tr>
                    <th>{{ t('admin.economy.sold_at') }}</th>
                    <th>{{ t('admin.economy.transfer_from') }}</th>
                    <th>{{ t('admin.economy.transfer_to') }}</th>
                    <th>{{ t('admin.economy.price_yang') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in transfers %}
                <tr>
                    <td>{{ row.transferred_at }}</td>
                    <td>{% if row.from_pid %}{% if row.from_name %}{{ row.from_name }}{% else %}#{{ row.from_pid }}{% endif %}{% else %}—{% endif %}</td>
                    <td>{% if row.to_pid %}{% if row.to_name %}{{ row.to_name }}{% else %}#{{ row.to_pid }}{% endif %}{% else %}—{% endif %}</td>
                    <td>{{ row.yang_amount|number_format }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>
</div>
