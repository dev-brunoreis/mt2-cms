<section class="space-y-5">
    <div>
        <h1 class="k-title text-2xl">{{ t('status.title') }}</h1>
        <p class="mt-1 text-sm k-muted">{{ t('status.lead', {minutes: windowMinutes}) }}</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
        <div class="k-panel p-5">
            <p class="font-[Cinzel] text-[0.65rem] uppercase tracking-[0.15em] k-muted">{{ t('status.players_online') }}</p>
            <p class="mt-2 flex items-center gap-2 text-3xl font-bold text-[var(--k-bronze)]">
                <span class="k-online-pulse" aria-hidden="true"></span>
                {{ playersOnline }}
            </p>
        </div>
        <div class="k-panel p-5">
            <p class="font-[Cinzel] text-[0.65rem] uppercase tracking-[0.15em] k-muted">{{ t('status.accounts_online') }}</p>
            <p class="mt-2 text-3xl font-bold text-[var(--k-text)]">{{ accountsOnline }}</p>
        </div>
    </div>

    <div>
        <h2 class="k-title text-lg">{{ t('status.channels_title') }}</h2>
        <p class="mt-1 text-sm k-muted">{{ t('status.channels_lead') }}</p>
    </div>

    <div class="k-panel overflow-hidden">
        {% if channels is empty %}
            <p class="p-8 text-center text-sm k-muted">{{ t('status.channels_empty') }}</p>
        {% else %}
            <table class="k-table">
                <thead>
                    <tr>
                        <th>{{ t('status.channel_name') }}</th>
                        <th>{{ t('status.channel_label') }}</th>
                        <th>{{ t('status.channel_host') }}</th>
                        <th>{{ t('status.channel_port') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for channel in channels %}
                        <tr>
                            <td class="font-medium">{{ channel.name }}</td>
                            <td class="k-muted">{{ channel.label }}</td>
                            <td class="k-muted">{{ channel.host|default('—') }}</td>
                            <td class="k-muted">{{ channel.port|default('—') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</section>
