{% set activeTab = activeTab|default('dados') %}
<div class="admin-panel admin-tabs overflow-hidden"
     data-admin-tabs
     data-default-tab="dados"
     data-tab-loading="{{ t('admin.tabs.loading') }}"
     data-tab-load-error="{{ t('admin.tabs.load_error') }}">
    <div class="admin-tabs-nav" role="tablist" aria-label="{{ t('admin.tabs.label') }}">
        {% include 'components/tab.twig' with { id: 'dados', label: t('admin.characters.tab_data'), active: activeTab == 'dados' } %}
        {% include 'components/tab.twig' with { id: 'logs', label: t('admin.characters.tab_logs'), active: activeTab == 'logs' } %}
        {% include 'components/tab.twig' with { id: 'items', label: t('admin.characters.tab_items'), active: activeTab == 'items' } %}
        {% include 'components/tab.twig' with { id: 'guild', label: t('admin.characters.tab_guild'), active: activeTab == 'guild' } %}
        {% include 'components/tab.twig' with { id: 'marriage', label: t('admin.characters.tab_marriage'), active: activeTab == 'marriage' } %}
    </div>

    {% include 'components/tab-panel.twig' with {
        id: 'dados',
        visible: activeTab == 'dados',
        template: 'components/character-data.twig'
    } %}
    {% include 'components/tab-panel.twig' with {
        id: 'logs',
        visible: activeTab == 'logs',
        src: '/admin/characters/' ~ character.id ~ '?tab=logs&partial=1',
        template: 'components/character-logs.twig'
    } %}
    {% include 'components/tab-panel.twig' with {
        id: 'items',
        visible: activeTab == 'items',
        src: '/admin/characters/' ~ character.id ~ '?tab=items&partial=1',
        template: 'components/character-items.twig'
    } %}
    {% include 'components/tab-panel.twig' with {
        id: 'guild',
        visible: activeTab == 'guild',
        src: '/admin/characters/' ~ character.id ~ '?tab=guild&partial=1',
        template: 'components/character-guild.twig'
    } %}
    {% include 'components/tab-panel.twig' with {
        id: 'marriage',
        visible: activeTab == 'marriage',
        src: '/admin/characters/' ~ character.id ~ '?tab=marriage&partial=1',
        template: 'components/character-marriage.twig'
    } %}
</div>
