DB_HOST=game
DB_PORT=3306
# Dev (compose.yml): root. Production (compose.prod.yml): use .env.prod-example instead.
DB_USER=root
# Dev fixture password (Compose MySQL). Required — no runtime default in code.
DB_PASSWORD=admin123@
THEME=default
LOCALE=en
# Optional: override game data directory (default: game/ under project root)
# GAME_DIR=game
# Set to true after completing /setup wizard
APP_INSTALLED=false
# 32-byte hex key for encrypting CMS secrets (setup or php bin/migrate.php generates this)
APP_KEY=
# Set to 1 when TLS terminates at a reverse proxy (secure session cookies)
APP_TRUST_PROXY=0
# Public site URL for email links (optional if set in admin community settings)
# APP_URL=https://cms.example.com
# SMTP (symfony/mailer) — use MAIL_DSN or individual vars
# MAIL_DSN=smtp://user:pass@smtp.example.com:587
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_SCHEME=smtp
# PayPal (sandbox or live credentials from developer.paypal.com)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# CMS database — inside Docker use service name "mysql"; from the host use 127.0.0.1:8002
CMS_DB_HOST=mysql
CMS_DB_PORT=3306
# CMS_DB_HOST=127.0.0.1
# CMS_DB_PORT=8002
CMS_DB_USER=root
CMS_DB_PASSWORD=admin123@
CMS_DB_NAME=cms

# Production stack only — see .env.prod-example (not used by compose.yml dev stack)
