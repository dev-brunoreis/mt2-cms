<section class="space-y-6">
    <div>
        <a href="/account/tickets" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">{{ t('tickets.back') }}</a>
        <h1 class="mt-2 text-2xl font-bold text-slate-900">{{ t('tickets.create') }}</h1>
        <p class="mt-1 text-slate-500">{{ t('tickets.create_lead') }}</p>
    </div>

    {% if error %}
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ error }}</div>
    {% endif %}

    <form id="ticket-compose-form" method="post" action="/account/tickets" enctype="multipart/form-data"
          class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div>
            <label for="ticket-subject" class="mb-1 block text-sm font-medium text-slate-700">{{ t('tickets.subject') }}</label>
            <input id="ticket-subject" type="text" name="subject" required maxlength="200" value="{{ subject }}"
                   class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-200">
        </div>
        <div>
            <label for="ticket-body" class="mb-1 block text-sm font-medium text-slate-700">{{ t('tickets.message') }}</label>
            <textarea id="ticket-body" name="body" rows="8" data-html-editor data-editor-height="320"
                      class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm">{{ body }}</textarea>
        </div>
        <div>
            <label for="ticket-evidence" class="mb-1 block text-sm font-medium text-slate-700">{{ t('tickets.evidence') }}</label>
            <input id="ticket-evidence" type="file" name="evidence[]" multiple
                   accept="image/jpeg,image/png,image/webp,image/gif"
                   class="block w-full text-sm text-slate-600 file:mr-3 file:cursor-pointer file:rounded-lg file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200">
            <p class="mt-1 text-xs text-slate-500">
                {{ t('tickets.evidence_help', {max: maxAttachments, mb: maxAttachmentMb}) }}
            </p>
        </div>
        <button type="submit"
                class="cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
            {{ t('tickets.submit') }}
        </button>
    </form>
</section>

<script src="/vendor/tinymce/tinymce.min.js"></script>
<script src="/js/html-editor.js" defer></script>
