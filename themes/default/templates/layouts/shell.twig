<!DOCTYPE html>
<html lang="{{ html_lang|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/item-tooltip.css">
    <link rel="stylesheet" href="/css/themes/kingdoms.css">
    <script src="/js/site/locale-switcher.js" defer></script>
    <script src="/js/site/shop-category-tree.js" defer></script>
    <title>{{ title|default(t('app.name')) }} — {{ t('app.name') }}</title>
</head>
<body class="theme-kingdoms min-h-screen antialiased flex flex-col">
    <div class="k-realm-stripe" aria-hidden="true"></div>
    {{ slots.header|raw }}
    {% include 'components/banner.twig' %}

    <div class="k-layout flex-1">
        <aside class="k-col">
            {% if slots.sidebar %}
                {{ slots.sidebar|raw }}
            {% else %}
                {% include 'components/sidebar-auth.twig' %}
            {% endif %}
            {% include 'components/widget-online.twig' %}
            {% include 'components/widget-download.twig' %}
        </aside>

        <main class="k-main-surface min-w-0">
            {% if flash %}
                <div class="{% if flash.type == 'success' %}k-flash-ok{% else %}k-flash-err{% endif %}">
                    {{ flash.message }}
                </div>
            {% endif %}

            {{ slots.main|raw }}
        </main>

        <aside class="k-col">
            {% include 'components/widget-ranking.twig' %}
            {% include 'components/widget-events.twig' %}
            {% if discord_invite_url %}
                {% include 'components/widget-discord.twig' %}
            {% endif %}
        </aside>
    </div>

    {{ slots.footer|raw }}
</body>
</html>
