<form id="admin-security-form" method="post" action="/admin/settings/security" class="admin-panel p-6">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.security.captcha_title') }}
            <span class="admin-fieldset-help">{{ t('admin.security.captcha_lead') }}</span>
        </legend>

        <label class="admin-toggle-row cursor-pointer">
            <input type="checkbox" name="captcha_public" value="1"
                   {% if captchaPublicEnabled %}checked{% endif %}>
            <span>
                <span class="block text-sm font-semibold text-slate-900">{{ t('admin.security.captcha_public') }}</span>
                <span class="mt-1 block text-sm leading-relaxed text-slate-500">{{ t('admin.security.captcha_public_help') }}</span>
            </span>
        </label>

        <label class="admin-toggle-row mt-4 cursor-pointer">
            <input type="checkbox" name="captcha_admin" value="1"
                   {% if captchaAdminEnabled %}checked{% endif %}>
            <span>
                <span class="block text-sm font-semibold text-slate-900">{{ t('admin.security.captcha_admin') }}</span>
                <span class="mt-1 block text-sm leading-relaxed text-slate-500">{{ t('admin.security.captcha_admin_help') }}</span>
            </span>
        </label>
    </fieldset>

    <fieldset class="admin-fieldset mt-6">
        <legend>
            {{ t('admin.security.2fa_title') }}
            <span class="admin-fieldset-help">{{ t('admin.security.2fa_lead') }}</span>
        </legend>

        <label class="admin-toggle-row cursor-pointer">
            <input type="checkbox" name="admin_2fa_required" value="1"
                   {% if adminTwoFactorRequired %}checked{% endif %}>
            <span>
                <span class="block text-sm font-semibold text-slate-900">{{ t('admin.security.2fa_required') }}</span>
                <span class="mt-1 block text-sm leading-relaxed text-slate-500">{{ t('admin.security.2fa_required_help') }}</span>
            </span>
        </label>
    </fieldset>
</form>
