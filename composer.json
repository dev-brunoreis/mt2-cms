{
    "name": "dev-brunoreis/mt2-cms",
    "autoload": {
        "psr-4": {
            "Mt2Cms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mt2Cms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "require": {
        "vlucas/phpdotenv": "^5.7",
        "twig/twig": "^3.28",
        "nikic/fast-route": "^1.3",
        "chillerlan/php-qrcode": "^5.0",
        "symfony/mailer": "^7.2",
        "symfony/mime": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "config": {
        "platform": {
            "php": "8.3.33"
        }
    }
}
