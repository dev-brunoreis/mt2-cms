<!DOCTYPE html>
<html lang="{{ html_lang|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/app.css">
    <title>{{ title|default(t('setup.title')) }} — {{ t('app.name') }}</title>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex flex-col">
    <main class="flex-1 w-full max-w-2xl mx-auto px-4 py-12">
        {% if flash %}
            <div class="mb-6 rounded-lg border px-4 py-3 text-sm
                {% if flash.type == 'success' %}border-emerald-700 bg-emerald-950/50 text-emerald-300
                {% else %}border-red-700 bg-red-950/50 text-red-300{% endif %}">
                {{ flash.message }}
            </div>
        {% endif %}

        {{ slots.main|raw }}
    </main>
</body>
</html>
