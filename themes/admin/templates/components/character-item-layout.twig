<div class="admin-inv-visual">
    <div class="admin-inv-stage">
        <div class="admin-inv-stage-ds">
            {% include 'components/dragonsoul-window.twig' with { layout: layout } %}
        </div>

        <div class="admin-inv-stage-mid">
            {% include 'components/costume-window.twig' with { board: layout.costume } %}

            {% if layout.extra is not empty %}
                {% embed 'components/game-window.twig' with {
                    title: t('admin.characters.slot_extra'),
                    modifier: 'admin-game-window-extra',
                    items: layout.extra
                } %}
                    {% block body %}
                        <div class="admin-inv-extra">
                            {% for item in items %}
                                <div class="admin-inv-cell"
                                     style="width: var(--inv-cell); height: calc(var(--inv-cell) * {{ item.size }});">
                                    {% include 'components/inventory-slot.twig' %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </div>

        <div class="admin-inv-stage-inv">
            {% include 'components/belt-window.twig' with { grid: layout.belt } %}
            {% include 'components/inventory-window.twig' with {
                layout: layout,
                gold: character.gold|default(0)
            } %}
        </div>
    </div>

    {% if safeboxLayout %}
        <div class="admin-inv-stage-account">
            {% include 'components/inventory-grid.twig' with {
                title: t('admin.characters.window_SAFEBOX'),
                subtitle: safebox.has_row ? t('admin.characters.safebox_gold') ~ ': ' ~ (safebox.gold|number_format(0, ',', '.')) : '',
                grid: safeboxLayout.safebox,
                prefix: 'inv-safebox',
                chrome: true
            } %}
            {% include 'components/inventory-grid.twig' with {
                title: t('admin.characters.window_MALL'),
                grid: safeboxLayout.mall,
                prefix: 'inv-mall',
                chrome: true
            } %}
        </div>
    {% endif %}
</div>
