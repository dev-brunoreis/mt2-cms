<nav class="space-y-6">
    {% for group in admin_sections %}
        {% if not group.pinned|default(false) %}
            {% set groupOpen = activeGroup is defined and activeGroup == group.id %}
            {% if group.collapsible|default(false) %}
                <details class="admin-nav-group" {% if groupOpen %}open{% endif %}>
                    <summary class="admin-nav-section mb-2 flex cursor-pointer list-none items-center justify-between px-3 text-[10px] font-bold uppercase text-slate-500">
                        <span>{{ t(group.label) }}</span>
                        <svg class="admin-nav-chevron h-3 w-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </summary>
                    <ul class="space-y-0.5">
                        {% for item in group.children %}
                            {% include 'components/nav-item.twig' with { item: item, pad: 'py-2' } %}
                        {% endfor %}
                    </ul>
                </details>
            {% else %}
                <div>
                    <p class="admin-nav-section mb-2 px-3 text-[10px] font-bold uppercase text-slate-500">
                        {{ t(group.label) }}
                    </p>

                    <ul class="space-y-0.5">
                        {% for item in group.children %}
                            {% include 'components/nav-item.twig' with { item: item, pad: 'py-2.5' } %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        {% endif %}
    {% endfor %}
</nav>
