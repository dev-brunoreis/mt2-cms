<section class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">{{ t('account.characters') }}</h1>
        <p class="mt-1 text-slate-500">{{ t('account.characters_lead') }}</p>
    </div>

    {% if players is empty %}
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">
            {{ t('account.empty') }}
        </p>
    {% else %}
        <ul class="k-char-list overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            {% for player in players %}
                {% set state = unstuckStates[player.id]|default(null) %}
                {% set skill = player.job|skill_name(player.skill_group) %}
                {% set jobLabel = player.job|job_name %}
                <li class="k-char-row">
                    <div class="k-char-identity">
                        {% include 'components/face-icon.twig' with { job: player.job } %}
                        <div class="min-w-0">
                            <p class="truncate font-medium text-slate-900">{{ player.name }}</p>
                            <p class="truncate text-sm text-slate-500" title="{{ jobLabel }}{% if skill %} · {{ skill }}{% endif %}">
                                {{ jobLabel }}{% if skill %} · {{ skill }}{% endif %}
                            </p>
                        </div>
                    </div>

                    <dl class="k-char-meta">
                        <div>
                            <dt>{{ t('account.level') }}</dt>
                            <dd>{{ player.level }}</dd>
                        </div>
                        <div>
                            <dt>{{ t('account.playtime') }}</dt>
                            <dd>{{ player.playtime|playtime }}</dd>
                        </div>
                    </dl>

                    <div class="k-char-actions">
                        {% if unstuckAvailable|default(false) %}
                            {% if state and state.offline and state.cooldown_seconds == 0 %}
                                <form method="post" action="/account/characters/unstuck">
                                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                                    <input type="hidden" name="player_id" value="{{ player.id }}">
                                    <button type="submit" class="k-btn k-btn-ghost k-btn-sm">
                                        {{ t('unstuck.button') }}
                                    </button>
                                </form>
                            {% elseif state and not state.offline %}
                                <span class="k-char-status"
                                      title="{{ t('unstuck.player_online', {minutes: onlineWindowMinutes}) }}">
                                    {{ t('unstuck.player_online_short') }}
                                </span>
                            {% elseif state and state.cooldown_seconds > 0 %}
                                <span class="k-char-status k-muted" title="{{ t('unstuck.cooldown') }}">
                                    {{ t('unstuck.cooldown_active') }}
                                </span>
                            {% endif %}
                        {% endif %}
                        <a href="/player/{{ player.name|url_encode }}"
                           class="k-btn k-btn-ghost k-btn-sm !no-underline">{{ t('account.view') }}</a>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
