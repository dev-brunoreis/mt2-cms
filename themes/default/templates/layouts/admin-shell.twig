<!DOCTYPE html>
<html lang="{{ html_lang|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>{{ title|default(t('admin.title')) }} — {{ t('app.name') }}</title>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex flex-col">
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
            <div>
                <p class="text-xs uppercase tracking-widest text-slate-500">{{ t('admin.badge') }}</p>
                <h1 class="text-lg font-bold text-white">{{ t('admin.title') }}</h1>
            </div>
            {% if adminUser %}
                <div class="flex items-center gap-4 text-sm">
                    <span class="text-slate-400">{{ adminUser.login }}</span>
                    <form method="post" action="/admin/logout" class="inline">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <button type="submit" class="cursor-pointer text-slate-400 hover:text-red-400 transition">
                            {{ t('admin.logout') }}
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
    </header>

    <div class="flex-1 w-full max-w-6xl mx-auto px-4 py-8 flex gap-8">
        <aside class="w-56 shrink-0">
            {{ slots.sidebar|raw }}
        </aside>

        <main class="flex-1 min-w-0">
            {% if flash %}
                <div class="mb-6 rounded-lg border px-4 py-3 text-sm
                    {% if flash.type == 'success' %}border-emerald-700 bg-emerald-950/50 text-emerald-300
                    {% else %}border-red-700 bg-red-950/50 text-red-300{% endif %}">
                    {{ flash.message }}
                </div>
            {% endif %}

            {% if contentTemplate is defined %}
                {% include contentTemplate %}
            {% else %}
                {{ slots.main|raw }}
            {% endif %}
        </main>
    </div>
</body>
</html>
