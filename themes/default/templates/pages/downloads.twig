<section class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">{{ t('downloads.title') }}</h1>
        <p class="mt-1 text-slate-500">{{ t('downloads.lead') }}</p>
    </div>

    {% if downloads is empty %}
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
            {{ t('downloads.empty') }}
        </p>
    {% else %}
        <div class="space-y-4">
            {% for download in downloads %}
                <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-medium uppercase tracking-wider text-slate-400">{{ t('downloads.category_' ~ download.category) }}</p>
                            <h2 class="mt-1 text-lg font-semibold text-slate-900">{{ download.title }}</h2>
                            {% if download.description %}
                                <p class="mt-2 text-sm text-slate-600">{{ download.description }}</p>
                            {% endif %}
                        </div>
                        <div class="shrink-0">
                            {% if download.external_url %}
                                <a href="{{ download.external_url }}" target="_blank" rel="noopener noreferrer"
                                   class="inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 transition">
                                    {{ t('downloads.download') }}
                                </a>
                            {% elseif download.stored_name %}
                                <a href="/downloads/{{ download.id }}/file"
                                   class="inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 transition">
                                    {{ t('downloads.download') }}
                                    {% if download.original_name %}
                                        <span class="ml-1 font-normal opacity-90">({{ download.original_name }})</span>
                                    {% endif %}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>
