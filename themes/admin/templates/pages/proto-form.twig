{% if error %}
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        {{ error }}
    </div>
{% endif %}

<form id="admin-proto-form"
      method="post"
      action="{% if isEdit %}{{ protoBase }}/{{ record.vnum }}{% else %}{{ protoBase }}{% endif %}"
      class="admin-panel admin-tabs overflow-hidden"
      data-admin-tabs
      data-default-tab="{{ tabs[0].id }}"
      data-tab-loading="{{ t('admin.tabs.loading') }}"
      data-tab-load-error="{{ t('admin.tabs.load_error') }}"
      {% if protoKind == 'item' %}
          data-proto-form="item"
          data-subtypes-by-type="{{ subtypesByType|json_encode|e('html_attr') }}"
          data-value-labels-by-type="{{ valueLabelsByType|json_encode|e('html_attr') }}"
      {% endif %}>
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <div class="admin-tabs-nav" role="tablist" aria-label="{{ t('admin.tabs.label') }}">
        {% for tab in tabs %}
            {% include 'components/tab.twig' with { id: tab.id, label: tab.label, active: tab.active } %}
        {% endfor %}
    </div>

    {% for tab in tabs %}
        <div id="admin-tab-panel-{{ tab.id }}"
             class="admin-tabs-panel"
             role="tabpanel"
             data-tab-panel="{{ tab.id }}"
             aria-labelledby="admin-tab-{{ tab.id }}"
             {% if tab.kind|default('') in ['drops', 'shops'] and not tab.active %}
                 data-tab-src="{{ protoBase }}/{{ record.vnum }}?tab={{ tab.id }}&partial=1"
             {% endif %}
             {% if not tab.active %}hidden{% endif %}>
            {% if tab.kind|default('') == 'drops' %}
                {% if tab.active %}
                    {% include 'components/mob-drops.twig' %}
                {% endif %}
            {% elseif tab.kind|default('') == 'shops' %}
                {% if tab.active %}
                    {% include 'components/item-shops.twig' %}
                {% endif %}
            {% else %}
                <fieldset class="admin-fieldset">
                    <legend>{{ tab.label }}</legend>

                    {% if tab.help is defined and tab.help %}
                        <p class="admin-field-help mb-4">{{ tab.help }}</p>
                    {% endif %}

                    {% if tab.id == 'identity' and protoKind == 'item' and isEdit %}
                        <div class="mb-4">
                            {% include 'components/item-icon.twig' with { vnum: record.vnum, size: 'lg', placeholder: true } %}
                        </div>
                    {% endif %}

                    <div class="grid gap-4 sm:grid-cols-2">
                        {% for field in tab.fields %}
                            {% if field.key == 'vnum' %}
                                <div class="admin-field">
                                    <label for="proto-vnum">{{ field.label }}</label>
                                    {% if field.hint is defined and field.hint %}
                                        <span class="admin-field-help">{{ field.hint }}</span>
                                    {% endif %}
                                    <input id="proto-vnum" type="number" name="vnum" min="1" step="1" required
                                           value="{{ field.value }}"
                                           class="admin-input"
                                           {% if isEdit %}readonly{% endif %}>
                                </div>
                            {% elseif field.key == 'locale_name' %}
                                <div class="admin-field">
                                    <label for="proto-locale_name">{{ field.label }}</label>
                                    {% if field.hint is defined and field.hint %}
                                        <span class="admin-field-help">{{ field.hint }}</span>
                                    {% endif %}
                                    <input id="proto-locale_name" type="text" name="locale_name" required maxlength="64"
                                           value="{{ field.value }}"
                                           class="admin-input" autocomplete="off">
                                </div>
                            {% else %}
                                {% include 'components/proto-field.twig' with { field: field } %}
                            {% endif %}
                        {% endfor %}
                    </div>
                </fieldset>
            {% endif %}
        </div>
    {% endfor %}
</form>

{% if isEdit %}
    <div class="admin-panel mt-4 p-6">
        {% if protoKind == 'item' and record.refine|default(0) > 0 %}
            <p class="mb-4 text-sm text-slate-600">
                <a href="/admin/game-data/refine/{{ record.refine }}" class="text-indigo-600 hover:underline">
                    {{ t('admin.refine.view_recipe', {id: record.refine}) }}
                </a>
            </p>
        {% endif %}

        <h2 class="text-sm font-semibold text-slate-900">{{ t(i18nPrefix ~ '.danger') }}</h2>
        <p class="mt-1 text-sm text-slate-500">{{ t(i18nPrefix ~ '.danger_help') }}</p>

        <div class="mt-4 flex flex-wrap gap-2">
            <form method="post" action="{{ protoBase }}/{{ record.vnum }}/delete"
                  data-confirm="{{ t(i18nPrefix ~ '.confirm_delete') }}">
                <input type="hidden" name="_csrf" value="{{ csrf }}">
                <button type="submit" class="admin-btn-danger cursor-pointer rounded-md px-4 py-2 text-sm font-semibold text-white">
                    {{ t(i18nPrefix ~ '.delete') }}
                </button>
            </form>
        </div>
    </div>
{% endif %}
