<section class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">{{ t('account.orders_title') }}</h1>
        <p class="mt-1 text-slate-500">{{ t('account.orders_lead') }}</p>
    </div>

    {% if orders is empty %}
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
            {{ t('account.orders_empty') }}
        </p>
    {% else %}
        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <th class="px-4 py-3 font-medium">{{ t('account.orders_id') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('account.orders_vnum') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('account.orders_count') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('account.orders_price') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('account.orders_status') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('account.orders_date') }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for order in orders %}
                        <tr class="hover:bg-slate-50 transition">
                            <td class="px-4 py-3 text-slate-400">#{{ order.id }}</td>
                            <td class="px-4 py-3 text-slate-600">{{ order.vnum }}</td>
                            <td class="px-4 py-3 text-slate-600">x{{ order.count }}</td>
                            <td class="px-4 py-3 text-slate-600">{{ order.price }}</td>
                            <td class="px-4 py-3">
                                <span class="rounded-full px-2 py-0.5 text-xs font-medium
                                    {% if order.status == 'completed' %}bg-emerald-100 text-emerald-800
                                    {% elseif order.status == 'pending' %}bg-amber-100 text-amber-800
                                    {% else %}bg-red-100 text-red-800{% endif %}">
                                    {{ t('account.orders_status_' ~ order.status) }}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-slate-600">{{ order.created_at|game_date }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
