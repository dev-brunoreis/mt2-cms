<section class="space-y-8">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">{{ t('account.title') }}</h1>
        <p class="mt-1 text-slate-500">
            {{ t('account.logged_in_as') }} <span class="font-medium text-slate-800">{{ account.login|default(auth.login) }}</span>
        </p>
    </div>

    {% if account.email_verified is defined and not account.email_verified %}
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
            <p class="font-medium text-amber-900">{{ t('account.email_unverified_title') }}</p>
            <p class="mt-1 text-sm text-amber-800/80">{{ t('account.email_unverified_lead') }}</p>
            {% if mailConfigured %}
                <form method="post" action="/account/verify-email/resend" class="mt-4">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <button type="submit"
                            class="cursor-pointer rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-500 transition">
                        {{ t('account.email_resend') }}
                    </button>
                </form>
            {% else %}
                <p class="mt-3 text-sm text-amber-800/80">{{ t('auth.mail_not_configured') }}</p>
            {% endif %}
        </div>
    {% endif %}

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-xs uppercase tracking-wider text-slate-500">{{ t('account.status') }}</p>
            <p class="mt-1 text-lg font-semibold text-slate-900">{{ account.status|default('—') }}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-xs uppercase tracking-wider text-slate-500">{{ t('account.empire') }}</p>
            <p class="mt-1 text-lg font-semibold text-slate-900">{{ account.empire|empire_name }}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-xs uppercase tracking-wider text-slate-500">{{ t('account.cash') }}</p>
            <p class="mt-1 text-lg font-semibold text-slate-900">{{ account.cash|default(0) }}</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
            <p class="text-xs uppercase tracking-wider text-slate-500">{{ t('account.created') }}</p>
            <p class="mt-1 text-lg font-semibold text-slate-900">{{ account.create_time|game_date }}</p>
        </div>
    </div>
</section>
