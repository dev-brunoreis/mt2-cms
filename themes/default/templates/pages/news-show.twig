<section class="space-y-8">
    {% if notFound|default(false) or post is null %}
        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
            <h1 class="text-xl font-semibold text-slate-900">{{ t('news.not_found') }}</h1>
            <a href="/news" class="mt-4 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500">
                {{ t('news.back') }}
            </a>
        </div>
    {% else %}
        <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            {% if post.cover_image %}
                <div class="aspect-[21/9] bg-slate-100">
                    <img src="{{ post.cover_image }}" alt="" class="h-full w-full object-cover">
                </div>
            {% endif %}
            <div class="p-6 md:p-8">
                <a href="/news" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">{{ t('news.back') }}</a>
                <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">{{ post.title }}</h1>
                <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm text-slate-500">
                    <span>{{ t('news.by', {author: post.author_login}) }}</span>
                    <span>{{ (post.published_at|default(post.created_at))|game_date }}</span>
                    <span>{{ t('news.views', {count: post.views}) }}</span>
                </p>
                <div class="news-body mt-8 max-w-none space-y-4 text-slate-700 [&_a]:text-indigo-600 [&_a]:underline [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-slate-900 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-slate-900 [&_h4]:text-lg [&_h4]:font-semibold [&_img]:my-4 [&_img]:max-w-full [&_img]:rounded-lg [&_li]:ml-5 [&_ol]:list-decimal [&_ul]:list-disc">
                    {{ post.body|news_html }}
                </div>
            </div>
        </article>

        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-8">
            <h2 class="text-xl font-semibold text-slate-900">{{ t('news.comments_title') }}</h2>

            {% if not commentsEnabled %}
                <p class="mt-3 text-sm text-slate-500">{{ t('news.comments_disabled') }}</p>
            {% else %}
                {% if comments is empty %}
                    <p class="mt-3 text-sm text-slate-500">{{ t('news.comments_empty') }}</p>
                {% else %}
                    <ul class="mt-6 space-y-4">
                        {% for comment in comments %}
                            <li class="rounded-xl border border-slate-100 bg-slate-50 p-4">
                                <div class="flex flex-wrap items-center gap-2 text-sm">
                                    <span class="font-medium text-slate-800">{{ comment.account_login }}</span>
                                    <span class="text-slate-400">{{ comment.created_at|game_date }}</span>
                                    {% if comment.status == 'pending' %}
                                        <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">
                                            {{ t('news.comment_pending_badge') }}
                                        </span>
                                    {% endif %}
                                </div>
                                <p class="mt-2 whitespace-pre-wrap text-sm text-slate-700">{{ comment.body }}</p>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if canComment %}
                    <form method="post" action="/news/{{ post.id }}/comment" class="mt-6 space-y-3">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                        <label for="comment-body" class="block text-sm font-medium text-slate-700">
                            {{ t('news.comment_label') }}
                        </label>
                        <textarea id="comment-body" name="body" rows="4" required maxlength="2000"
                                  class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-200"
                                  placeholder="{{ t('news.comment_placeholder') }}"></textarea>
                        {% if commentsRequireApproval %}
                            <p class="text-xs text-slate-500">{{ t('news.comment_approval_hint') }}</p>
                        {% endif %}
                        <button type="submit"
                                class="cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
                            {{ t('news.comment_submit') }}
                        </button>
                    </form>
                {% else %}
                    <p class="mt-4 text-sm text-slate-500">
                        <a href="/login" class="font-medium text-indigo-600 hover:text-indigo-500">{{ t('news.login_to_comment') }}</a>
                    </p>
                {% endif %}
            {% endif %}
        </section>
    {% endif %}
</section>
