<section class="space-y-6">
    {% if notFound|default(false) or event is null %}
        <div class="k-panel p-10 text-center">
            <h1 class="k-title text-xl">{{ t('events.not_found') }}</h1>
            <a href="/events" class="k-btn k-btn-ghost mt-4 inline-flex">{{ t('events.back') }}</a>
        </div>
    {% else %}
        {% set startTs = event.starts_at|date('U') %}
        {% set endTs = event.ends_at ? event.ends_at|date('U') : null %}
        {% set nowTs = 'now'|date('U') %}
        {% if startTs > nowTs %}
            {% set status = 'upcoming' %}
        {% elseif endTs is null or endTs >= nowTs %}
            {% set status = 'ongoing' %}
        {% else %}
            {% set status = 'ended' %}
        {% endif %}
        <article class="k-panel overflow-hidden">
            <div class="p-5 sm:p-7">
                <a href="/events" class="text-xs font-medium">{{ t('events.back') }}</a>
                <h1 class="k-title mt-3 text-2xl sm:text-3xl">{{ event.title }}</h1>
                <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs k-muted">
                    <span class="k-event-status k-event-status-{{ status }}">{{ t('events.status_' ~ status) }}</span>
                    <span>{{ t('events.starts', {date: event.starts_at|game_date}) }}</span>
                    {% if event.ends_at %}
                        <span>{{ t('events.ends', {date: event.ends_at|game_date}) }}</span>
                    {% endif %}
                </p>
                <div class="news-body mt-6 max-w-none space-y-4 [&_li]:ml-5 [&_ol]:list-decimal [&_ul]:list-disc [&_img]:my-4 [&_img]:max-w-full">
                    {{ event.body|news_html }}
                </div>
            </div>
        </article>
    {% endif %}
</section>
