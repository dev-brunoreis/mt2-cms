; Example PHP-FPM pool for Mt2 CMS on FreeBSD.
; Copy into /usr/local/etc/php-fpm.d/mt2-cms.conf (or merge with www.conf).
; Match fastcgi_pass in deploy/freebsd/nginx.conf.snippet.

[mt2-cms]
user = www
group = www
listen = /var/run/php-fpm.sock
listen.owner = www
listen.group = www
listen.mode = 0660

pm = dynamic
pm.max_children = 20
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 5

; App needs write access to var/ and public/uploads/ under the tree
; chown -R www:www /usr/local/www/mt2-cms/var /usr/local/www/mt2-cms/public/uploads

clear_env = no
security.limit_extensions = .php

php_admin_value[error_log] = /var/log/php-fpm-mt2-cms.log
php_admin_flag[log_errors] = on
