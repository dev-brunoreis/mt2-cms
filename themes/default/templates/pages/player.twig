<section class="space-y-6">
    {% if notFound or player is null %}
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center shadow-sm">
            <h1 class="mb-2 text-2xl font-bold text-slate-900">{{ t('player.not_found_title') }}</h1>
            <p class="mb-6 text-slate-500">{{ t('player.not_found_body') }}</p>
            <a href="/ranking" class="font-medium text-indigo-600 hover:underline">{{ t('player.back_to_ranking') }}</a>
        </div>
    {% else %}
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <p class="mb-1 text-sm text-slate-500">
                <a href="/ranking" class="hover:text-slate-700 transition">{{ t('nav.ranking') }}</a>
                <span class="mx-2">/</span>
                {{ player.name }}
            </p>
            <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <h1 class="flex items-center gap-3 text-3xl font-bold text-slate-900">
                    {% include 'components/face-icon.twig' with { job: player.job } %}
                    <span>{{ player.name }}</span>
                </h1>
                {% if unstuckAvailable|default(false) %}
                    {% set state = unstuckState|default(null) %}
                    {% if state and state.offline and state.cooldown_seconds == 0 %}
                        <form method="post" action="/account/characters/unstuck">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <input type="hidden" name="player_id" value="{{ player.id }}">
                            <input type="hidden" name="return_to" value="player">
                            <button type="submit" class="k-btn">{{ t('unstuck.button') }}</button>
                        </form>
                    {% elseif state and not state.offline %}
                        <p class="text-sm text-amber-700">{{ t('unstuck.player_online', {minutes: onlineWindowMinutes}) }}</p>
                    {% elseif state and state.cooldown_seconds > 0 %}
                        <p class="text-sm text-slate-500">{{ t('unstuck.cooldown_active') }}</p>
                    {% endif %}
                {% endif %}
            </div>

            <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">{{ t('player.job') }}</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-900">{{ player.job|job_name }}</dd>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">{{ t('player.skill') }}</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-900">{{ player.job|skill_name(player.skill_group)|default('—') }}</dd>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">{{ t('player.level') }}</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-900">{{ player.level }}</dd>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">{{ t('player.experience') }}</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-900">{{ player.exp }}</dd>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">{{ t('player.playtime') }}</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-900">{{ player.playtime|playtime }}</dd>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">{{ t('player.last_play') }}</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-900">{{ player.last_play|game_date }}</dd>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">{{ t('player.map') }}</dt>
                    <dd class="mt-1 text-lg font-semibold text-slate-900">{{ player.map_index }}</dd>
                </div>
            </dl>
        </div>
    {% endif %}
</section>
