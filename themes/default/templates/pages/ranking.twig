<section class="space-y-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="k-title text-2xl">{{ t('ranking.title') }}</h1>
            <p class="mt-1 text-sm k-muted">
                {{ t('ranking.player_count', {count: total}) }}
                {% if query %} {{ t('ranking.matching', {query: query}) }}{% endif %}
            </p>
        </div>

        {% if tab != 'guilds' %}
            <form method="get" action="/ranking" class="flex gap-2">
                <input type="hidden" name="tab" value="{{ tab }}">
                <input type="search" name="q" value="{{ query }}" placeholder="{{ t('ranking.search_placeholder') }}"
                       class="k-input text-sm">
                <button type="submit" class="k-btn">{{ t('ranking.search') }}</button>
            </form>
        {% endif %}
    </div>

    <nav class="k-tabs flex flex-wrap gap-1 border-b border-[var(--k-border)] pb-3">
        <a href="/ranking?tab=level{% if query %}&q={{ query|url_encode }}{% endif %}"
           class="{% if tab == 'level' %}k-tab-active{% endif %}">{{ t('ranking.tab_level') }}</a>
        <a href="/ranking?tab=playtime{% if query %}&q={{ query|url_encode }}{% endif %}"
           class="{% if tab == 'playtime' %}k-tab-active{% endif %}">{{ t('ranking.tab_playtime') }}</a>
        <a href="/ranking?tab=guilds"
           class="{% if tab == 'guilds' %}k-tab-active{% endif %}">{{ t('ranking.tab_guilds') }}</a>
    </nav>

    <div class="k-panel overflow-hidden">
        {% if ranking is empty %}
            <p class="p-8 text-center text-sm k-muted">{{ t('ranking.empty') }}</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="k-table">
                    <thead>
                        <tr>
                            <th>{{ t('ranking.rank') }}</th>
                            {% if tab == 'guilds' %}
                                <th>{{ t('ranking.guild_name') }}</th>
                                <th>{{ t('ranking.level') }}</th>
                                <th>{{ t('ranking.ladder_point') }}</th>
                                <th>{{ t('ranking.win') }}</th>
                                <th>{{ t('ranking.draw') }}</th>
                                <th>{{ t('ranking.loss') }}</th>
                                <th>{{ t('ranking.members') }}</th>
                                <th>{{ t('ranking.master') }}</th>
                            {% else %}
                                <th>{{ t('ranking.name') }}</th>
                                <th>{{ t('ranking.job') }}</th>
                                <th>{{ t('ranking.level') }}</th>
                                {% if tab == 'playtime' %}
                                    <th>{{ t('ranking.playtime') }}</th>
                                {% else %}
                                    <th>{{ t('ranking.exp') }}</th>
                                    <th>{{ t('ranking.playtime') }}</th>
                                {% endif %}
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in ranking %}
                            <tr>
                                <td class="k-rank-num {% if (offset + loop.index) <= 3 %}k-top{% endif %}">{{ offset + loop.index }}</td>
                                {% if tab == 'guilds' %}
                                    <td class="font-medium">{{ row.name }}</td>
                                    <td>{{ row.level }}</td>
                                    <td>{{ row.ladder_point }}</td>
                                    <td>{{ row.win }}</td>
                                    <td>{{ row.draw }}</td>
                                    <td>{{ row.loss }}</td>
                                    <td>{{ row.member_count }}</td>
                                    <td>{{ row.master_name|default('—') }}</td>
                                {% else %}
                                    <td>
                                        <a href="/player/{{ row.name|url_encode }}"
                                           class="inline-flex items-center gap-2 font-medium !no-underline text-[var(--k-text)] hover:!text-[var(--k-bronze)]">
                                            <span class="k-face-sm">{% include 'components/face-icon.twig' with { job: row.job } %}</span>
                                            <span>{{ row.name }}</span>
                                        </a>
                                    </td>
                                    <td class="k-muted">{{ row.job|job_name(row.skill_group) }}</td>
                                    <td>{{ row.level }}</td>
                                    {% if tab == 'playtime' %}
                                        <td>{{ row.playtime|playtime }}</td>
                                    {% else %}
                                        <td>{{ row.exp }}</td>
                                        <td>{{ row.playtime|playtime }}</td>
                                    {% endif %}
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 text-sm">
            {% if page > 1 %}
                <a href="/ranking?tab={{ tab|url_encode }}&page={{ page - 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}"
                   class="k-btn k-btn-ghost">{{ t('ranking.previous') }}</a>
            {% endif %}
            <span class="px-3 k-muted">{{ t('ranking.page_of', {page: page, total: totalPages}) }}</span>
            {% if page < totalPages %}
                <a href="/ranking?tab={{ tab|url_encode }}&page={{ page + 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}"
                   class="k-btn k-btn-ghost">{{ t('ranking.next') }}</a>
            {% endif %}
        </nav>
    {% endif %}
</section>
