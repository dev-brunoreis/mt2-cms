<div class="admin-panel overflow-hidden">
    <div class="border-b border-slate-100 px-4 py-4 md:px-6">
        <p class="text-sm text-slate-500">{{ t('admin.news.comments_count', {count: total}) }}</p>
    </div>

    {% if comments is empty %}
        <p class="px-4 py-10 text-center text-sm text-slate-500 md:px-6">{{ t('admin.news.comments_empty') }}</p>
    {% else %}
        <div class="overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>{{ t('admin.news.comments_post') }}</th>
                        <th>{{ t('admin.news.comments_author') }}</th>
                        <th>{{ t('admin.news.comments_body') }}</th>
                        <th>{{ t('admin.news.comments_when') }}</th>
                        <th>{{ t('admin.news.actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for comment in comments %}
                        <tr>
                            <td>
                                <a href="/admin/news/{{ comment.news_id }}" class="text-indigo-600 hover:underline">
                                    {{ comment.news_title }}
                                </a>
                            </td>
                            <td class="text-slate-600">{{ comment.account_login }}</td>
                            <td class="max-w-md whitespace-pre-wrap text-slate-700">{{ comment.body }}</td>
                            <td class="text-slate-500">{{ comment.created_at|game_date }}</td>
                            <td>
                                <div class="flex flex-wrap gap-2">
                                    <form method="post" action="/admin/news/comments/{{ comment.id }}/approve">
                                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                                        <button type="submit" class="admin-link-action cursor-pointer">
                                            {{ t('admin.news.approve') }}
                                        </button>
                                    </form>
                                    <form method="post" action="/admin/news/comments/{{ comment.id }}/reject">
                                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                                        <button type="submit" class="admin-link-action cursor-pointer">
                                            {{ t('admin.news.reject') }}
                                        </button>
                                    </form>
                                    <form method="post" action="/admin/news/comments/{{ comment.id }}/delete"
                                          data-confirm="{{ t('admin.news.confirm_comment_delete') }}">
                                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                                        <button type="submit" class="admin-link-action admin-link-danger cursor-pointer">
                                            {{ t('admin.news.delete') }}
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 border-t border-slate-100 px-4 py-3 text-sm">
            {% if page > 1 %}
                <a href="/admin/news/comments?page={{ page - 1 }}"
                   class="admin-btn-secondary rounded-md px-3 py-1.5">{{ t('admin.news.previous') }}</a>
            {% endif %}
            <span class="px-2 text-slate-500">{{ t('admin.news.page_of', {page: page, total: totalPages}) }}</span>
            {% if page < totalPages %}
                <a href="/admin/news/comments?page={{ page + 1 }}"
                   class="admin-btn-secondary rounded-md px-3 py-1.5">{{ t('admin.news.next') }}</a>
            {% endif %}
        </nav>
    {% endif %}
</div>
