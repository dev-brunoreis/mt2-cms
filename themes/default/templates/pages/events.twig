<section class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">{{ t('events.title') }}</h1>
        <p class="mt-1 text-slate-500">{{ t('events.lead') }}</p>
    </div>

    {% if events is empty %}
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
            {{ t('events.empty') }}
        </p>
    {% else %}
        <div class="space-y-4">
            {% for event in events %}
                <a href="/events/{{ event.id }}"
                   class="block rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-indigo-200 hover:shadow-md">
                    <h2 class="text-lg font-semibold text-slate-900">{{ event.title }}</h2>
                    <p class="mt-2 text-sm text-slate-600">{{ event.body|news_excerpt(180) }}</p>
                    <p class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500">
                        <span>{{ t('events.starts', {date: event.starts_at|game_date}) }}</span>
                        {% if event.ends_at %}
                            <span>{{ t('events.ends', {date: event.ends_at|game_date}) }}</span>
                        {% endif %}
                    </p>
                </a>
            {% endfor %}
        </div>
    {% endif %}

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 text-sm">
            {% if page > 1 %}
                <a href="/events?page={{ page - 1 }}"
                   class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-slate-700 hover:bg-slate-50">
                    {{ t('events.previous') }}
                </a>
            {% endif %}
            <span class="px-2 text-slate-500">{{ t('events.page_of', {page: page, total: totalPages}) }}</span>
            {% if page < totalPages %}
                <a href="/events?page={{ page + 1 }}"
                   class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-slate-700 hover:bg-slate-50">
                    {{ t('events.next') }}
                </a>
            {% endif %}
        </nav>
    {% endif %}
</section>
