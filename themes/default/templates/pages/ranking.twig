<section class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">{{ t('ranking.title') }}</h1>
            <p class="mt-1 text-sm text-slate-500">
                {{ t('ranking.player_count', {count: total}) }}
                {% if query %} {{ t('ranking.matching', {query: query}) }}{% endif %}
            </p>
        </div>

        <form method="get" action="/ranking" class="flex gap-2">
            <input type="search" name="q" value="{{ query }}" placeholder="{{ t('ranking.search_placeholder') }}"
                   class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20">
            <button type="submit"
                    class="cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 transition">
                {{ t('ranking.search') }}
            </button>
        </form>
    </div>

    {% if ranking is empty %}
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">
            {{ t('ranking.empty') }}
        </p>
    {% else %}
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <th class="px-4 py-3 font-medium">{{ t('ranking.rank') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('ranking.name') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('ranking.job') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('ranking.level') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('ranking.exp') }}</th>
                        <th class="px-4 py-3 font-medium">{{ t('ranking.playtime') }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for player in ranking %}
                        <tr class="hover:bg-slate-50 transition">
                            <td class="px-4 py-3 text-slate-400">{{ offset + loop.index }}</td>
                            <td class="px-4 py-3">
                                <a href="/player/{{ player.name|url_encode }}"
                                   class="font-medium text-indigo-600 hover:underline">
                                    {{ player.name }}
                                </a>
                            </td>
                            <td class="px-4 py-3 text-slate-600">{{ player.job|job_name }}</td>
                            <td class="px-4 py-3 text-slate-600">{{ player.level }}</td>
                            <td class="px-4 py-3 text-slate-600">{{ player.exp }}</td>
                            <td class="px-4 py-3 text-slate-600">{{ player.playtime|playtime }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if totalPages > 1 %}
            <nav class="flex items-center justify-center gap-2 text-sm">
                {% if page > 1 %}
                    <a href="/ranking?page={{ page - 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}"
                       class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-slate-600 hover:border-slate-400 transition">
                        {{ t('ranking.previous') }}
                    </a>
                {% endif %}

                <span class="px-3 py-1.5 text-slate-500">
                    {{ t('ranking.page_of', {page: page, total: totalPages}) }}
                </span>

                {% if page < totalPages %}
                    <a href="/ranking?page={{ page + 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}"
                       class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-slate-600 hover:border-slate-400 transition">
                        {{ t('ranking.next') }}
                    </a>
                {% endif %}
            </nav>
        {% endif %}
    {% endif %}
</section>
