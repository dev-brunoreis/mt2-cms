{% if error %}
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ error }}</div>
{% endif %}

{% set isEdit = banner.id is defined and banner.id %}
<form id="admin-banner-form" method="post" enctype="multipart/form-data"
      action="{% if isEdit %}/admin/content/banners/{{ banner.id }}{% else %}/admin/content/banners{% endif %}"
      class="admin-panel p-6">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.banners.details') }}
            <span class="admin-fieldset-help">{{ t('admin.banners.details_help') }}</span>
        </legend>

        <div class="grid gap-4 sm:grid-cols-2">
            <div class="admin-field sm:col-span-2">
                <label class="admin-toggle-row cursor-pointer">
                    <input type="checkbox" name="enabled" value="1"
                           {% if banner.enabled|default(true) %}checked{% endif %}>
                    <span>
                        <span class="block text-sm font-semibold text-slate-900">{{ t('admin.banners.enabled') }}</span>
                        <span class="mt-1 block text-sm leading-relaxed text-slate-500">{{ t('admin.banners.enabled_help') }}</span>
                    </span>
                </label>
            </div>
            <div class="admin-field sm:col-span-2">
                <label for="banner-title">{{ t('admin.banners.title_field') }}</label>
                <input id="banner-title" type="text" name="title" required maxlength="120"
                       value="{{ banner.title|default('') }}" class="admin-input">
            </div>
            <div class="admin-field sm:col-span-2">
                <label for="banner-alt">{{ t('admin.banners.alt') }}</label>
                <input id="banner-alt" type="text" name="alt" maxlength="180"
                       value="{{ banner.alt|default('') }}" class="admin-input">
                <span class="admin-field-help">{{ t('admin.banners.alt_help') }}</span>
            </div>
            <div class="admin-field sm:col-span-2">
                <label for="banner-link">{{ t('admin.banners.link_url') }}</label>
                <input id="banner-link" type="text" name="link_url" maxlength="500"
                       value="{{ banner.link_url|default('') }}" class="admin-input" placeholder="https:// or /path">
                <span class="admin-field-help">{{ t('admin.banners.link_url_help') }}</span>
            </div>
            <div class="admin-field">
                <label for="banner-sort">{{ t('admin.banners.sort') }}</label>
                <input id="banner-sort" type="number" name="sort_order" min="0"
                       value="{{ banner.sort_order|default(0) }}" class="admin-input">
            </div>
            <div class="admin-field sm:col-span-2">
                <label for="banner-image">{{ t('admin.banners.image') }}</label>
                <input id="banner-image" type="file" name="image" accept="image/jpeg,image/png,image/webp"
                       class="admin-input"{% if not isEdit %} required{% endif %}>
                {% if banner.preview_url|default('') %}
                    <div class="mt-3">
                        {% include 'components/image-preview-trigger.twig' with {
                            src: banner.full_url|default(banner.preview_url),
                            thumb: banner.preview_url,
                            alt: banner.alt|default(banner.title)|default(''),
                            imgClass: 'h-20 w-auto rounded border border-slate-200 object-cover'
                        } %}
                        <span class="admin-field-help">{{ t('admin.banners.current_image') }}</span>
                    </div>
                {% else %}
                    <span class="admin-field-help">{{ t('admin.banners.image_help') }}</span>
                {% endif %}
            </div>
        </div>
    </fieldset>
</form>
