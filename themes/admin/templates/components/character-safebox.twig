<section class="admin-fieldset">
    <h2 class="admin-fieldset-title">
        {{ t('admin.characters.tab_safebox') }}
        <span class="admin-fieldset-help">{{ t('admin.characters.safebox_help') }}</span>
    </h2>

    {% if safebox is empty %}
        <p class="text-sm text-slate-500">{{ t('admin.characters.safebox_empty') }}</p>
    {% else %}
        {% if safebox.has_row %}
            <dl class="admin-stat-grid">
                <div class="admin-stat">
                    <dt>{{ t('admin.characters.safebox_gold') }}</dt>
                    <dd>{{ safebox.gold }}</dd>
                </div>
                <div class="admin-stat">
                    <dt>{{ t('admin.characters.safebox_size') }}</dt>
                    <dd>{{ safebox.size }}</dd>
                </div>
            </dl>
        {% endif %}

        {% if safebox.items is empty %}
            <p class="mt-4 text-sm text-slate-500">{{ t('admin.characters.safebox_items_empty') }}</p>
        {% else %}
            {% for window, rows in safebox.items %}
                {% include 'components/character-item-table.twig' with { window: window, rows: rows } %}
            {% endfor %}
        {% endif %}
    {% endif %}
</section>
