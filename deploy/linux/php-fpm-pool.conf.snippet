; Example PHP-FPM pool for Mt2 CMS on Linux.
; Copy into /etc/php/8.3/fpm/pool.d/mt2-cms.conf (or merge with www.conf).
; Match fastcgi_pass in deploy/linux/nginx.conf.snippet.

[mt2-cms]
user = www-data
group = www-data
listen = /run/php/php8.3-fpm.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = dynamic
pm.max_children = 20
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 5

; App needs write access to var/ and public/uploads/ under the tree
; chown -R www-data:www-data /var/www/mt2-cms/var /var/www/mt2-cms/public/uploads

clear_env = no
security.limit_extensions = .php

php_admin_value[error_log] = /var/log/php8.3-fpm-mt2-cms.log
php_admin_flag[log_errors] = on
