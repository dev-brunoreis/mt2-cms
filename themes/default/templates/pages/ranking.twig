<section class="space-y-5">
    <div class="flex flex-col gap-4">
        <div>
            <h1 class="k-title text-2xl">{{ t('ranking.title') }}</h1>
            <p class="mt-1 text-sm k-muted">
                {% if tab == 'guilds' %}
                    {{ t('ranking.guild_count', {count: total}) }}
                {% else %}
                    {{ t('ranking.player_count', {count: total}) }}
                {% endif %}
                {% if query %} {{ t('ranking.matching', {query: query}) }}{% endif %}
            </p>
        </div>
        <form method="get" action="/ranking" class="k-search-form">
            <input type="hidden" name="tab" value="{{ tab }}">
            <input type="search" name="q" value="{{ query }}"
                   placeholder="{{ tab == 'guilds' ? t('ranking.search_guilds_placeholder') : t('ranking.search_placeholder') }}"
                   class="k-input text-sm" autocomplete="off">
            <button type="submit" class="k-btn shrink-0">{{ t('ranking.search') }}</button>
        </form>
    </div>

    <nav class="k-tabs flex flex-wrap gap-1 border-b border-[var(--k-border)] pb-3">
        <a href="/ranking?tab=level{% if query %}&q={{ query|url_encode }}{% endif %}"
           class="{% if tab == 'level' %}k-tab-active{% endif %}">{{ t('ranking.tab_level') }}</a>
        <a href="/ranking?tab=playtime{% if query %}&q={{ query|url_encode }}{% endif %}"
           class="{% if tab == 'playtime' %}k-tab-active{% endif %}">{{ t('ranking.tab_playtime') }}</a>
        <a href="/ranking?tab=guilds{% if query %}&q={{ query|url_encode }}{% endif %}"
           class="{% if tab == 'guilds' %}k-tab-active{% endif %}">{{ t('ranking.tab_guilds') }}</a>
    </nav>

    <div class="k-panel{% if tab == 'guilds' %} overflow-x-auto{% else %} overflow-hidden{% endif %}">
        {% if ranking is empty %}
            <p class="p-8 text-center text-sm k-muted">{{ tab == 'guilds' ? t('ranking.empty_guilds') : t('ranking.empty') }}</p>
        {% elseif tab == 'guilds' %}
            <table class="k-table">
                <thead>
                    <tr>
                        <th>{{ t('ranking.rank') }}</th>
                        <th>{{ t('ranking.guild_name') }}</th>
                        <th>{{ t('ranking.level') }}</th>
                        <th>{{ t('ranking.ladder_point') }}</th>
                        <th>{{ t('ranking.win') }}</th>
                        <th>{{ t('ranking.draw') }}</th>
                        <th>{{ t('ranking.loss') }}</th>
                        <th>{{ t('ranking.members') }}</th>
                        <th>{{ t('ranking.master') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in ranking %}
                        <tr>
                            <td class="k-rank-num k-num {% if (offset + loop.index) <= 3 %}k-top{% endif %}">{{ offset + loop.index }}</td>
                            <td class="font-medium">{{ row.name }}</td>
                            <td class="k-num">{{ row.level }}</td>
                            <td class="k-num">{{ row.ladder_point }}</td>
                            <td class="k-num">{{ row.win }}</td>
                            <td class="k-num">{{ row.draw }}</td>
                            <td class="k-num">{{ row.loss }}</td>
                            <td class="k-num">{{ row.member_count }}</td>
                            <td>
                                {% if row.master_name %}
                                    <a href="/player/{{ row.master_name|url_encode }}">{{ row.master_name }}</a>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <ol class="k-char-list">
                {% for row in ranking %}
                    {% set skill = row.job|skill_name(row.skill_group) %}
                    {% set jobLabel = row.job|job_name %}
                    <li class="k-char-row">
                        <span class="k-rank-num shrink-0 {% if (offset + loop.index) <= 3 %}k-top{% endif %}">{{ offset + loop.index }}</span>
                        <div class="k-char-identity">
                            <span class="k-face-sm shrink-0">{% include 'components/face-icon.twig' with { job: row.job } %}</span>
                            <div class="min-w-0">
                                <a href="/player/{{ row.name|url_encode }}"
                                   class="block truncate font-medium !no-underline text-[var(--k-text)] hover:!text-[var(--k-bronze)]">
                                    {{ row.name }}
                                </a>
                                <p class="truncate text-xs k-muted" title="{{ jobLabel }}{% if skill %} · {{ skill }}{% endif %}">
                                    {{ jobLabel }}{% if skill %} · {{ skill }}{% endif %}
                                </p>
                            </div>
                        </div>
                        <dl class="k-char-meta">
                            <div>
                                <dt>{{ t('ranking.level') }}</dt>
                                <dd>{{ row.level }}</dd>
                            </div>
                            {% if tab != 'playtime' %}
                                <div>
                                    <dt>{{ t('ranking.exp') }}</dt>
                                    <dd>{{ row.exp }}</dd>
                                </div>
                            {% endif %}
                            <div>
                                <dt>{{ t('ranking.playtime') }}</dt>
                                <dd>{{ row.playtime|playtime }}</dd>
                            </div>
                        </dl>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    </div>

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 text-sm">
            {% if page > 1 %}
                <a href="/ranking?tab={{ tab|url_encode }}&page={{ page - 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}"
                   class="k-btn k-btn-ghost">{{ t('ranking.previous') }}</a>
            {% endif %}
            <span class="px-3 k-muted">{{ t('ranking.page_of', {page: page, total: totalPages}) }}</span>
            {% if page < totalPages %}
                <a href="/ranking?tab={{ tab|url_encode }}&page={{ page + 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}"
                   class="k-btn k-btn-ghost">{{ t('ranking.next') }}</a>
            {% endif %}
        </nav>
    {% endif %}
</section>
