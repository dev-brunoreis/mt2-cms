{% if error %}
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ error }}</div>
{% endif %}

<form id="admin-item-shop-category-form" method="post"
      action="{% if isEdit %}/admin/item-shop/categories/{{ category.id }}{% else %}/admin/item-shop/categories{% endif %}"
      class="admin-panel p-6">
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    <fieldset class="admin-fieldset">
        <legend>
            {{ t('admin.item_shop.categories.details') }}
            <span class="admin-fieldset-help">{{ t('admin.item_shop.categories.details_help') }}</span>
        </legend>

        <div class="grid gap-4 sm:grid-cols-2">
            <div class="admin-field">
                <label for="category-name">{{ t('admin.item_shop.categories.name') }}</label>
                <input id="category-name" type="text" name="name" required maxlength="120"
                       value="{{ category.name|default('') }}" class="admin-input" autocomplete="off">
            </div>
            <div class="admin-field">
                <label for="category-slug">{{ t('admin.item_shop.categories.slug') }}</label>
                <input id="category-slug" type="text" name="slug" maxlength="140"
                       value="{{ category.slug|default('') }}" class="admin-input" autocomplete="off">
                <span class="admin-field-help">{{ t('admin.item_shop.categories.slug_help') }}</span>
            </div>
            <div class="admin-field">
                <label for="category-sort">{{ t('admin.item_shop.categories.sort_order') }}</label>
                <input id="category-sort" type="number" name="sort_order"
                       value="{{ category.sort_order|default(0) }}" class="admin-input">
            </div>
            <div class="admin-field sm:col-span-2">
                <label class="inline-flex items-center gap-2">
                    <input type="checkbox" name="enabled" value="1"
                           {% if category.enabled is not defined or category.enabled %}checked{% endif %}>
                    <span>{{ t('admin.item_shop.categories.enabled') }}</span>
                </label>
            </div>
        </div>
    </fieldset>
</form>

{% if isEdit %}
    <div class="mt-4 flex justify-end">
        <form method="post" action="/admin/item-shop/categories/{{ category.id }}/delete"
              data-confirm="{{ t('admin.item_shop.categories.confirm_delete') }}">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <button type="submit" class="admin-link-action admin-link-danger cursor-pointer rounded-md border border-red-200 px-4 py-2 text-sm">
                {{ t('admin.item_shop.categories.delete') }}
            </button>
        </form>
    </div>
{% endif %}
