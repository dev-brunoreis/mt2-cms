<section class="space-y-6">
    {% if notFound or player is null %}
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-12 text-center">
            <h1 class="text-2xl font-bold text-white mb-2">Player not found</h1>
            <p class="text-slate-400 mb-6">This character does not exist.</p>
            <a href="/ranking" class="text-blue-400 hover:underline">Back to ranking</a>
        </div>
    {% else %}
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-8">
            <p class="text-sm text-slate-500 mb-1">
                <a href="/ranking" class="hover:text-slate-300 transition">Ranking</a>
                <span class="mx-2">/</span>
                {{ player.name }}
            </p>
            <h1 class="text-3xl font-bold text-white mb-6">{{ player.name }}</h1>

            <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">Job</dt>
                    <dd class="mt-1 text-lg font-semibold text-white">{{ player.job|job_name }}</dd>
                </div>
                <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">Level</dt>
                    <dd class="mt-1 text-lg font-semibold text-white">{{ player.level }}</dd>
                </div>
                <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">Experience</dt>
                    <dd class="mt-1 text-lg font-semibold text-white">{{ player.exp }}</dd>
                </div>
                <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">Playtime</dt>
                    <dd class="mt-1 text-lg font-semibold text-white">{{ player.playtime|playtime }}</dd>
                </div>
                <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">Last play</dt>
                    <dd class="mt-1 text-lg font-semibold text-white">{{ player.last_play|game_date }}</dd>
                </div>
                <div class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
                    <dt class="text-xs uppercase tracking-wider text-slate-500">Map</dt>
                    <dd class="mt-1 text-lg font-semibold text-white">{{ player.map_index }}</dd>
                </div>
            </dl>
        </div>
    {% endif %}
</section>
