<section class="space-y-5">
    <div>
        <h1 class="k-title text-2xl">{{ t('events.title') }}</h1>
        <p class="mt-1 text-sm k-muted">{{ t('events.lead') }}</p>
    </div>

    <div class="k-panel">
        {% if events is empty %}
            <p class="p-8 text-center text-sm k-muted">{{ t('events.empty') }}</p>
        {% else %}
            <div class="px-4 py-1">
                {% for event in events %}
                    {% set startTs = event.starts_at|date('U') %}
                    {% set endTs = event.ends_at ? event.ends_at|date('U') : null %}
                    {% set nowTs = 'now'|date('U') %}
                    {% if startTs > nowTs %}
                        {% set status = 'upcoming' %}
                    {% elseif endTs is null or endTs >= nowTs %}
                        {% set status = 'ongoing' %}
                    {% else %}
                        {% set status = 'ended' %}
                    {% endif %}
                    <a href="/events/{{ event.id }}" class="k-news-row !no-underline hover:bg-[rgba(196,163,90,0.04)]">
                        <time class="k-news-date">{{ event.starts_at|game_date }}</time>
                        <div class="min-w-0">
                            <span class="k-news-title">{{ event.title }}</span>
                            <p class="mt-1 line-clamp-2 text-xs k-muted">{{ event.body|news_excerpt(160) }}</p>
                            <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.65rem] k-muted">
                                <span class="k-event-status k-event-status-{{ status }}">{{ t('events.status_' ~ status) }}</span>
                                <span>{{ t('events.starts', {date: event.starts_at|game_date}) }}</span>
                                {% if event.ends_at %}
                                    <span>{{ t('events.ends', {date: event.ends_at|game_date}) }}</span>
                                {% endif %}
                            </p>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {% if totalPages > 1 %}
        <nav class="flex items-center justify-center gap-2 text-sm">
            {% if page > 1 %}
                <a href="/events?page={{ page - 1 }}" class="k-btn k-btn-ghost">{{ t('events.previous') }}</a>
            {% endif %}
            <span class="px-2 k-muted">{{ t('events.page_of', {page: page, total: totalPages}) }}</span>
            {% if page < totalPages %}
                <a href="/events?page={{ page + 1 }}" class="k-btn k-btn-ghost">{{ t('events.next') }}</a>
            {% endif %}
        </nav>
    {% endif %}
</section>
