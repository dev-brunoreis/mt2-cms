<div class="space-y-4">
    {% if canStats|default(false) %}
    <div class="admin-panel p-4 md:p-6">
        {% if populationHref is defined %}
        <div class="mb-3 flex justify-end">
            <a class="text-sm font-medium text-indigo-600 hover:underline" href="{{ populationHref }}">{{ t('admin.dashboard.population_link') }}</a>
        </div>
        {% endif %}
        <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="admin-stat admin-stat-highlight">
                <dt>{{ t('admin.dashboard.players') }}</dt>
                <dd>{{ playerCount|number_format }}</dd>
            </div>
            <div class="admin-stat admin-stat-highlight">
                <dt>{{ t('admin.dashboard.accounts') }}</dt>
                <dd>{{ accountCount|number_format }}</dd>
            </div>
            <div class="admin-stat">
                <dt>{{ t('admin.dashboard.total_characters') }}</dt>
                <dd>{{ totalCharacters|default(0)|number_format }}</dd>
            </div>
            <div class="admin-stat">
                <dt>{{ t('admin.dashboard.total_accounts') }}</dt>
                <dd>{{ totalAccounts|default(0)|number_format }}</dd>
            </div>
        </dl>
    </div>
    {% endif %}

    {% if canPayments|default(false) and finance is defined %}
    {% set playerRange = grid.filterValues.range|default('5m') %}
    <div class="admin-panel p-4 md:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.dashboard.finance_title') }}</h2>
                <p class="mt-1 text-sm text-slate-500">{{ t('admin.dashboard.finance_lead') }}</p>
            </div>
            <a class="text-sm font-medium text-indigo-600 hover:underline" href="{{ paymentsHref }}">{{ t('admin.dashboard.finance_link') }}</a>
        </div>
        <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="{{ t('admin.dashboard.finance_range_label') }}">
            {% for opt in financeRangeOptions %}
            <a href="/admin?range={{ playerRange }}&amp;finance={{ opt }}"
               class="rounded-md px-3 py-1.5 text-sm font-medium {% if financeRange == opt %}bg-indigo-600 text-white{% else %}bg-slate-100 text-slate-700 hover:bg-slate-200{% endif %}">
                {{ t('admin.payments.range.' ~ opt) }}
            </a>
            {% endfor %}
        </div>
        <dl class="admin-stat-grid mt-4">
            <div class="admin-stat admin-stat-highlight">
                <dt>{{ t('admin.dashboard.finance_paid') }}</dt>
                <dd class="break-all">{{ finance.paid_cents|money }}{% if finance.currency %} {{ finance.currency }}{% endif %}</dd>
                <dd class="text-xs font-normal text-slate-500">{{ t('admin.dashboard.finance_paid_hint', {count: finance.paid_count|default(0)}) }}</dd>
            </div>
            <div class="admin-stat">
                <dt>{{ t('admin.dashboard.finance_cash') }}</dt>
                <dd>{{ finance.cash_amount|number_format }}</dd>
            </div>
            <div class="admin-stat">
                <dt>{{ t('admin.dashboard.finance_pending') }}</dt>
                <dd>{{ finance.open_pending|number_format }}</dd>
            </div>
        </dl>
        {% if finance.other_currencies|default([])|length > 0 %}
        <p class="mt-3 text-xs text-slate-500">
            {% for extra in finance.other_currencies %}
                {{ t('admin.dashboard.finance_other_currency', {currency: extra.currency, amount: extra.amount_cents|money}) }}{% if not loop.last %} · {% endif %}
            {% endfor %}
        </p>
        {% endif %}
        <div class="mt-4">
            <h3 class="text-xs font-medium text-slate-500">{{ t('admin.dashboard.finance_chart') }}</h3>
            {% include 'components/day-chart.twig' with {
                labels: finance.spark.labels|default([]),
                values: finance.spark.values|default([]),
                title: t('admin.dashboard.finance_chart'),
                format: 'money',
                currency: finance.currency|default(''),
                color: 'indigo',
                begin_zero: true,
                compact: true
            } %}
        </div>
    </div>
    {% endif %}

    {% if canPlayers|default(false) %}
    <div class="admin-panel overflow-hidden">
        {% include 'components/grid.twig' with {grid: grid} %}
    </div>
    {% endif %}
</div>
