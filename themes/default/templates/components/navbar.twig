{% set brand = site_title is defined and site_title != '' ? site_title : t('app.name') %}
<header class="k-nav" data-k-nav>
    <nav class="k-nav-bar">
        <button type="button"
                class="k-nav-toggle"
                data-k-nav-toggle
                aria-controls="k-nav-menu"
                aria-expanded="false"
                aria-label="{{ t('nav.open_menu') }}"
                data-label-open="{{ t('nav.open_menu') }}"
                data-label-close="{{ t('nav.close_menu') }}">
            <svg class="k-nav-icon-open h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg class="k-nav-icon-close h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>

        <a href="/" class="k-brand">
            {% if site_logo|default('') %}
                <img src="{{ site_logo }}" alt="{{ brand }}" class="k-brand-logo">
            {% else %}
                {{ brand }}
            {% endif %}
        </a>

        <div class="k-nav-toolbar">
            {% include 'components/locale-switcher.twig' %}
        </div>

        <div id="k-nav-menu" class="k-nav-links" data-k-nav-menu>
            <a href="/" class="{% if current_path == '/' %}k-nav-active{% endif %}">{{ t('nav.home') }}</a>
            {% if has_news %}
                <a href="/news" class="{% if current_path starts with '/news' %}k-nav-active{% endif %}">{{ t('nav.news') }}</a>
            {% endif %}
            {% if auth.check %}
                <a href="/shop" class="{% if current_path starts with '/shop' %}k-nav-active{% endif %}">{{ t('nav.shop') }}</a>
            {% endif %}
            <a href="/ranking" class="{% if current_path starts with '/ranking' %}k-nav-active{% endif %}">{{ t('nav.ranking') }}</a>
            <a href="/status" class="{% if current_path starts with '/status' %}k-nav-active{% endif %}">{{ t('nav.status') }}</a>
            <a href="/downloads" class="{% if current_path starts with '/downloads' %}k-nav-active{% endif %}">{{ t('nav.downloads') }}</a>
            <a href="/donate" class="{% if current_path starts with '/donate' %}k-nav-active{% endif %}">{{ t('nav.donate') }}</a>
            {% if discord_invite_url %}
                <a href="{{ discord_invite_url }}" target="_blank" rel="noopener noreferrer">{{ t('nav.discord') }}</a>
            {% endif %}
            {% if auth.check %}
                <a href="/account" class="{% if current_path starts with '/account' %}k-nav-active{% endif %}">
                    {{ t('nav.account') }}
                    {% if notification_unread|default(0) > 0 %}
                        <span class="ml-1 inline-flex min-w-[1.1rem] items-center justify-center rounded-full bg-[var(--k-ember-hot)] px-1 text-[0.6rem] font-semibold text-white">
                            {{ notification_unread }}
                        </span>
                    {% endif %}
                </a>
            {% else %}
                <a href="/register" class="k-btn k-btn-ember k-nav-register">{{ t('nav.register') }}</a>
            {% endif %}
        </div>
    </nav>
</header>
