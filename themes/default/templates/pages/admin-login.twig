<div class="mx-auto max-w-md">
    <div class="rounded-2xl border border-slate-700 bg-slate-900/60 p-8 shadow-2xl">
        <div class="mb-8 text-center">
            <p class="text-sm uppercase tracking-widest text-blue-400">{{ t('admin.badge') }}</p>
            <h1 class="mt-2 text-3xl font-bold text-white">{{ t('admin.login_title') }}</h1>
        </div>

        <form method="post" action="/admin/login" class="flex flex-col gap-5">
            <input type="hidden" name="_csrf" value="{{ csrf }}">

            <div class="flex flex-col gap-2">
                <label for="username" class="text-sm font-medium text-slate-300">{{ t('admin.username') }}</label>
                <input id="username" type="text" name="username" required value="{{ username|default('') }}"
                       class="rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white outline-none focus:border-blue-500">
            </div>

            <div class="flex flex-col gap-2">
                <label for="password" class="text-sm font-medium text-slate-300">{{ t('admin.password') }}</label>
                <input id="password" type="password" name="password" required
                       class="rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white outline-none focus:border-blue-500">
            </div>

            {% if error %}
                <p class="text-center text-red-400">{{ error }}</p>
            {% endif %}

            <button type="submit"
                    class="mt-2 cursor-pointer rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white transition hover:bg-blue-500">
                {{ t('admin.submit_login') }}
            </button>
        </form>
    </div>
</div>
