<div class="admin-panel p-6 space-y-6">
    <dl class="grid gap-4 sm:grid-cols-2">
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ t('admin.payments.id') }}</dt>
            <dd class="mt-1 text-sm text-slate-900">#{{ payment.id }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ t('admin.payments.account') }}</dt>
            <dd class="mt-1 text-sm text-slate-900">{{ payment.account_login }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ t('admin.payments.provider') }}</dt>
            <dd class="mt-1 text-sm text-slate-900">{{ payment.provider }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ t('admin.payments.status') }}</dt>
            <dd class="mt-1 text-sm text-slate-900">{{ t('admin.payments.status_' ~ payment.status) }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ t('admin.payments.amount') }}</dt>
            <dd class="mt-1 text-sm text-slate-900">{{ payment.amount_cents|money }} {{ payment.currency }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ t('admin.payments.cash') }}</dt>
            <dd class="mt-1 text-sm text-slate-900">{{ payment.cash_amount }}</dd>
        </div>
        <div class="sm:col-span-2">
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ t('admin.payments.provider_ref') }}</dt>
            <dd class="mt-1 break-all font-mono text-sm text-slate-900">{{ payment.provider_ref }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ t('admin.payments.created') }}</dt>
            <dd class="mt-1 text-sm text-slate-900">{{ payment.created_at|game_date }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ t('admin.payments.credited_at') }}</dt>
            <dd class="mt-1 text-sm text-slate-900">
                {% if payment.credited_at %}
                    {{ payment.credited_at|game_date }}
                {% else %}
                    {{ t('admin.payments.not_credited') }}
                {% endif %}
            </dd>
        </div>
    </dl>

    {% if canRecredit %}
        <form method="post" action="/admin/store/payments/{{ payment.id }}/recredit" class="border-t border-slate-200 pt-6">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <button type="submit" class="admin-btn-primary cursor-pointer rounded-md px-4 py-2 text-sm font-semibold">
                {{ t('admin.payments.recredit_action') }}
            </button>
            <p class="mt-2 text-sm text-slate-500">{{ t('admin.payments.recredit_help') }}</p>
        </form>
    {% endif %}
</div>

<div class="admin-panel mt-6 p-6 space-y-4">
    <h2 class="text-sm font-semibold text-slate-900">{{ t('admin.payments.webhook_events') }}</h2>
    <p class="text-sm text-slate-500">{{ t('admin.payments.webhook_events_help') }}</p>

    {% if webhookEvents is empty %}
        <p class="text-sm text-slate-500">{{ t('admin.payments.webhook_empty') }}</p>
    {% else %}
        <ul class="space-y-4">
            {% for event in webhookEvents %}
                <li class="rounded-md border border-slate-200 p-4 space-y-3">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="admin-badge
                            {% if event.status == 'processed' %}admin-badge-ok
                            {% elseif event.status == 'failed' %}admin-badge-danger
                            {% elseif event.status == 'rejected' %}admin-badge-muted
                            {% else %}admin-badge-warn{% endif %}">
                            {{ t('admin.payments.webhook_status_' ~ event.status) }}
                        </span>
                        <span class="font-mono text-sm text-slate-900">{{ event.event_type }}</span>
                        <span class="text-xs text-slate-500">{{ event.created_at|game_date }}</span>
                        <span class="text-xs text-slate-500">{{ t('admin.payments.webhook_attempts', {count: event.attempts}) }}</span>
                    </div>
                    {% if event.last_error %}
                        <p class="text-sm text-rose-700">{{ event.last_error }}</p>
                    {% endif %}
                    {% if canRetryWebhook and event.status == 'failed' %}
                        <form method="post" action="/admin/store/payments/{{ payment.id }}/events/{{ event.id }}/retry">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <button type="submit" class="admin-btn-secondary cursor-pointer rounded-md px-3 py-1.5 text-sm font-semibold">
                                {{ t('admin.payments.webhook_retry') }}
                            </button>
                        </form>
                    {% endif %}
                    <details class="rounded-md border border-slate-100 bg-slate-50 p-3">
                        <summary class="cursor-pointer text-sm font-semibold text-slate-700">{{ t('admin.payments.webhook_raw') }}</summary>
                        {% if event.headers is not empty %}
                            <dl class="mt-3 grid gap-1 text-xs">
                                {% for name, value in event.headers %}
                                    <div>
                                        <dt class="font-semibold text-slate-500">{{ name }}</dt>
                                        <dd class="break-all font-mono text-slate-800">{{ value }}</dd>
                                    </div>
                                {% endfor %}
                            </dl>
                        {% endif %}
                        <pre class="mt-3 overflow-x-auto whitespace-pre-wrap break-all font-mono text-xs text-slate-800">{{ event.raw_pretty }}</pre>
                    </details>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
