<section class="space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-slate-900">{{ t('donate.title') }}</h1>
        <p class="mt-1 text-slate-500">{{ t('donate.lead') }}</p>
    </div>

    {% if packages is empty %}
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
            {{ t('donate.empty') }}
        </p>
    {% else %}
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {% for package in packages %}
                <article class="flex flex-col rounded-xl border border-slate-200 bg-white shadow-sm">
                    <div class="flex-1 p-5">
                        <h2 class="text-lg font-semibold text-slate-900">{{ package.title }}</h2>
                        <p class="mt-2 text-2xl font-bold text-indigo-700">
                            {{ t('donate.cash_amount', {amount: package.cash_amount}) }}
                        </p>
                        <p class="mt-1 text-sm text-slate-500">
                            {{ t('donate.price', {
                                price: (package.price_cents / 100)|number_format(2, '.', ','),
                                currency: package.currency|default(currency)
                            }) }}
                        </p>
                    </div>
                    <div class="border-t border-slate-100 p-5">
                        <form method="post" action="/donate/buy">
                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                            <input type="hidden" name="package_id" value="{{ package.id }}">
                            <button type="submit"
                                    class="w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
                                {{ t('donate.buy') }}
                            </button>
                        </form>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>
