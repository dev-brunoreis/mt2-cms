<nav class="space-y-6">
    {% for group in admin_sections %}
        {% set groupOpen = activeGroup is defined and activeGroup == group.id %}
        {% if group.collapsible|default(false) %}
            <details class="admin-nav-group" {% if groupOpen %}open{% endif %}>
                <summary class="admin-nav-section mb-2 flex cursor-pointer list-none items-center justify-between px-3 text-[10px] font-bold uppercase text-slate-500">
                    <span>{{ t(group.label) }}</span>
                    <svg class="admin-nav-chevron h-3 w-3 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </summary>
                <ul class="space-y-0.5">
                    {% for item in group.children %}
                        {% set isActive = activeSection is defined and activeSection == item.id %}
                        <li>
                            <a href="{{ item.path }}"
                               class="admin-nav-link flex items-center gap-3 rounded-md px-3 py-2 text-[13px] font-medium
                               {% if isActive %}
                                   is-active text-white
                               {% else %}
                                   text-slate-300
                               {% endif %}">
                                {% include 'components/nav-icon.twig' with { sectionId: item.id } only %}
                                <span>{{ t(item.label) }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </details>
        {% else %}
            <div>
                <p class="admin-nav-section mb-2 px-3 text-[10px] font-bold uppercase text-slate-500">
                    {{ t(group.label) }}
                </p>

                <ul class="space-y-0.5">
                    {% for item in group.children %}
                        {% set isActive = activeSection is defined and activeSection == item.id %}
                        <li>
                            <a href="{{ item.path }}"
                               class="admin-nav-link flex items-center gap-3 rounded-md px-3 py-2.5 text-[13px] font-medium
                               {% if isActive %}
                                   is-active text-white
                               {% else %}
                                   text-slate-300
                               {% endif %}">
                                {% include 'components/nav-icon.twig' with { sectionId: item.id } only %}
                                <span>{{ t(item.label) }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    {% endfor %}
</nav>
