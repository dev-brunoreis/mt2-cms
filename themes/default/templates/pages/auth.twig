<div class="mx-auto max-w-md">
    <div class="rounded-2xl border border-slate-700 bg-slate-900/60 p-8 shadow-2xl">
        <h1 class="mb-8 text-center text-3xl font-bold text-white">
            {% if form == 'login' %}{{ t('auth.login_title') }}{% else %}{{ t('auth.register_title') }}{% endif %}
        </h1>

        {% if form == 'login' %}
            <form method="post" action="/login" class="flex flex-col gap-5">
                <input type="hidden" name="_csrf" value="{{ csrf }}">

                <div class="flex flex-col gap-2">
                    <label for="username" class="text-sm font-medium text-slate-300">{{ t('auth.username') }}</label>
                    <input id="username" type="text" name="username" required
                           value="{{ username }}"
                           class="rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white outline-none transition placeholder:text-slate-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                </div>

                <div class="flex flex-col gap-2">
                    <label for="password" class="text-sm font-medium text-slate-300">{{ t('auth.password') }}</label>
                    <input id="password" type="password" name="password" required
                           class="rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white outline-none transition placeholder:text-slate-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                </div>

                {% if error %}
                    <p class="text-center text-red-400">{{ error }}</p>
                {% endif %}

                <button type="submit"
                        class="mt-2 cursor-pointer rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white transition hover:bg-blue-500 active:scale-[0.98]">
                    {{ t('auth.submit_login') }}
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-slate-400">
                {{ t('auth.no_account') }}
                <a href="/register" class="text-blue-400 hover:underline">{{ t('auth.register_link') }}</a>
            </p>
        {% elseif registrationBlocked|default(false) %}
            <div class="rounded-lg border border-amber-700/60 bg-amber-950/40 px-4 py-4 text-center">
                <p class="font-medium text-amber-200">{{ t('auth.registration_disabled_title') }}</p>
                <p class="mt-2 text-sm text-amber-200/80">{{ t('auth.registration_disabled') }}</p>
            </div>

            <p class="mt-6 text-center text-sm text-slate-400">
                {{ t('auth.have_account') }}
                <a href="/login" class="text-blue-400 hover:underline">{{ t('auth.login_link') }}</a>
            </p>
        {% else %}
            <form method="post" action="/register" class="flex flex-col gap-5">
                <input type="hidden" name="_csrf" value="{{ csrf }}">

                <div class="flex flex-col gap-2">
                    <label for="username" class="text-sm font-medium text-slate-300">{{ t('auth.username') }}</label>
                    <input id="username" type="text" name="username" required
                           value="{{ username }}"
                           class="rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white outline-none transition placeholder:text-slate-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                </div>

                <div class="flex flex-col gap-2">
                    <label for="email" class="text-sm font-medium text-slate-300">{{ t('auth.email') }}</label>
                    <input id="email" type="email" name="email" required
                           value="{{ email }}"
                           class="rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white outline-none transition placeholder:text-slate-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                </div>

                <div class="flex flex-col gap-2">
                    <label for="social_id" class="text-sm font-medium text-slate-300">{{ t('auth.social_id') }}</label>
                    <input id="social_id" type="text" name="social_id" required
                           value="{{ socialId }}"
                           class="rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white outline-none transition placeholder:text-slate-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                </div>

                <div class="flex flex-col gap-2">
                    <label for="password" class="text-sm font-medium text-slate-300">{{ t('auth.password') }}</label>
                    <input id="password" type="password" name="password" required
                           class="rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white outline-none transition placeholder:text-slate-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                </div>

                {% if error %}
                    <p class="text-center text-red-400">{{ error }}</p>
                {% endif %}

                <button type="submit"
                        class="mt-2 cursor-pointer rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white transition hover:bg-blue-500 active:scale-[0.98]">
                    {{ t('auth.submit_register') }}
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-slate-400">
                {{ t('auth.have_account') }}
                <a href="/login" class="text-blue-400 hover:underline">{{ t('auth.login_link') }}</a>
            </p>
        {% endif %}
    </div>
</div>
